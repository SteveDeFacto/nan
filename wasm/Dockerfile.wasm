# enclave-wasm-manager: runs tenant Wasm apps via `wasmtime serve`.
# No privileged mode, no nested runtime, no namespace/mount/exec ops. The whole
# reason this backend exists: it runs unprivileged inside Tinfoil's confinement.
# Image integrity is covered by Tinfoil attestation (the built image is measured),
# so every input is pinned: the wasmtime toolchain image by digest, the CUDA
# base by tag+digest at measurement time.
#
# WHY the CUDA base: tenant deployments that buy a GPU share get wasi-nn
# (`-S nn`), and the wasmtime process itself then holds a CUDA context through
# ONNX Runtime's CUDA execution provider — so the runtime libs (cudart, cublas,
# cuDNN) must exist HERE, in the container the tenants' processes run in. The
# CPU flavor ships the same image (the libs idle without a GPU; ExecutionTarget
# ::Cpu uses the CPU provider) — one image, one measurement, both flavors.
#
# The wasmtime binary comes from the enclave-wasmtime toolchain image (built from
# source with wasi-nn + onnx-cuda; see Dockerfile.wasmtime). Bump = rebuild that
# image via the "Wasmtime Toolchain" workflow, then repin WASMTIME_IMAGE here.
ARG WASMTIME_IMAGE=ghcr.io/enclavehost/enclave-wasmtime:ac0772970b9ad2cd53866d95db69e26311fe3b75@sha256:d53061cfffb0dedbbfeebfe0f8455227d80616e6cf440886d0c514184c6140aa
FROM ${WASMTIME_IMAGE} AS wasmtime

# CPU-only engine changes do not require rebuilding wasmtime or CUDA. Rebuild
# this dlopened module from the SAME llama revision and ABI flags as the pinned
# toolchain; all other engine libraries still come from that toolchain image.
FROM rust:1.97-bookworm@sha256:14bc9c5966e7b3a385794b3d5389a8765668342025fbcc7b2e3d2866ac4bd8c3 AS ggml-cpu-build
ARG GGML_CPU_COMMIT=ddd4ec1428a6201e18975ea52b07c71e0f9aef26
RUN apt-get update && apt-get install -y --no-install-recommends cmake \
    && rm -rf /var/lib/apt/lists/*
RUN git init -q /src/llama && cd /src/llama \
    && git remote add origin https://github.com/ggml-org/llama.cpp \
    && git fetch -q --depth 1 origin "${GGML_CPU_COMMIT}" && git checkout -q FETCH_HEAD
COPY llamacpp-parallel-copy.patch /tmp/parallel-copy.patch
RUN cd /src/llama && git apply /tmp/parallel-copy.patch \
    && cmake -S . -B build -DCMAKE_BUILD_TYPE=Release \
       -DBUILD_SHARED_LIBS=ON -DGGML_BACKEND_DL=ON -DGGML_CUDA=OFF -DGGML_NATIVE=OFF \
       -DCMAKE_C_FLAGS=-DGGML_MAX_NAME=128 -DCMAKE_CXX_FLAGS=-DGGML_MAX_NAME=128 \
       -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_EXAMPLES=OFF -DLLAMA_BUILD_SERVER=OFF \
       -DLLAMA_BUILD_TOOLS=OFF -DLLAMA_BUILD_COMMON=OFF -DLLAMA_BUILD_APP=OFF \
    && cmake --build build --target ggml-cpu -j4
# Resolve the module against the actual base library shipped by wasmtime,
# not the copy CMake just built. Fail the image if the ABI does not link.
COPY --from=wasmtime /lib/libggml-base.so.0.18.0 /tmp/toolchain-base/libggml-base.so.0
RUN LD_LIBRARY_PATH=/tmp/toolchain-base ldd -r /src/llama/build/bin/libggml-cpu.so > /tmp/cpu-deps \
    && ! grep -E 'not found|undefined symbol' /tmp/cpu-deps

# Base pinned by DIGEST, not just the mutable tag: this image is part of the
# MEASURED enclave TCB, and its sidecar digest is what enclaves/*/tinfoil-config.yml
# commits to. An upstream repush of the same tag silently changes the measurement,
# which is exactly what the reproducibility claim behind METAL_ALLOWED_MEASUREMENTS
# cannot survive (see the root Dockerfile, which has always pinned). This digest is
# what the tag resolved to when it was pinned, so pinning changed nothing about what
# gets built - it only stopped it drifting. Re-pin deliberately on a base bump.
FROM nvidia/cuda:12.6.2-cudnn-runtime-ubuntu24.04@sha256:39b73679081ed376dbc0a6aa1a63e553b3895a1454999dfafdd1ce796b131cb8

# gdb: the nn readiness probe captures symbol-level stacks of a hung GPU
# init (spawns the e2e wasmtime UNDER gdb, interrupts, thread apply all bt)
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 ca-certificates curl gdb libgomp1 libgoogle-perftools4 \
    && rm -rf /var/lib/apt/lists/*

# rclone: the encrypted-volumes engine (crypt over S3, driven by the manager's
# /encvol unlock/sync/lock plane). Official static build, pinned by sha256 like
# every other input; extracted with python3's zipfile so no unzip rides along.
ARG RCLONE_VERSION=v1.67.0
ARG RCLONE_SHA256=07c23d21a94d70113d949253478e13261c54d14d72023bb14d96a8da5f3e7722
RUN curl -fsSL -o /tmp/rclone.zip \
      "https://downloads.rclone.org/${RCLONE_VERSION}/rclone-${RCLONE_VERSION}-linux-amd64.zip" \
    && echo "${RCLONE_SHA256}  /tmp/rclone.zip" | sha256sum -c - \
    && python3 -c "import zipfile; zipfile.ZipFile('/tmp/rclone.zip').extract('rclone-${RCLONE_VERSION}-linux-amd64/rclone', '/tmp')" \
    && install -m 0755 "/tmp/rclone-${RCLONE_VERSION}-linux-amd64/rclone" /usr/local/bin/rclone \
    && rm -rf /tmp/rclone.zip "/tmp/rclone-${RCLONE_VERSION}-linux-amd64" \
    && env -u RCLONE_VERSION rclone version   # ARG leaks into RUN env; rclone reads RCLONE_* as flags (RCLONE_VERSION -> --version bool), so clear it just for this check

# wasmtime CLI with wasi-nn (ONNX Runtime backend, CUDA EP) + the ORT dylibs it
# links. ldconfig registers /usr/local/lib so the dynamic linker finds them; the
# CUDA provider .so is dlopened by libonnxruntime from the same directory.
COPY --from=wasmtime /bin/wasmtime /usr/local/bin/wasmtime
# mm33: the static ffmpeg/ffprobe the ggml backend's "video" verb spawns
# (libmtmd's video helper). They ship in the artifact image's /bin beside
# wasmtime; the engine finds them through ENCLAVE_GGML_FFMPEG_DIR, which the
# metal guest sets to /usr/local/bin (hosted-fleet configs likewise).
COPY --from=wasmtime /bin/ffmpeg /bin/ffprobe /usr/local/bin/
COPY --from=wasmtime /lib/ /usr/local/lib/
COPY --from=ggml-cpu-build /src/llama/build/bin/libggml-cpu.so /usr/local/lib/libggml-cpu.so
# ggml (llama.cpp) compute backends are dlopened MODULES (GGML_BACKEND_DL) -
# libggml-cpu/-cuda in /usr/local/lib are found via this env, not ldconfig.
# Keeps libcuda.so.1 out of the wasmtime binary's DT_NEEDED: the driver lib
# only exists where the nvidia runtime injects it (never on CPU flavors).
ENV ENCLAVE_GGML_BACKEND_DIR=/usr/local/lib
RUN ldconfig && /usr/local/bin/wasmtime --version && /usr/local/bin/ffprobe -version | head -1

WORKDIR /opt/enclave

# NO deployable apps ship in the image: every app deploys from the on-chain
# catalog by ipfs://<cid> (fetched + hash-verified in-enclave, cached under
# /opt/enclave/apps). The ONE .wasm here is the boot probe's fixture: the CUDA
# readiness probe serves nn-demo through the real wasmtime + ORT stack to
# prove GPU inference end-to-end before any tenant deploy is allowed - without
# it the probe would have to skip its most load-bearing stage (the one that
# caught the sm_90 PTX-JIT hang). It is launched only by the manager itself;
# the supervisor's approval gate refuses non-CID references, so it is not
# deployable through the API.
#
# It lives in /opt/enclave/fixtures, NOT /opt/enclave/apps: the flavors mount
# the persistent wasm-cache volume over /opt/enclave/apps, and on 2026-08-23
# (v0.5.486) the initially empty mount shadowed the fixture baked there — the
# arbiter capability probe read the missing file as "toolchain unproven" and
# hard-capped every GPU tenant to its share-sized SM slice (eyesoff 70->45
# tok/s). A capability gate must never depend on a path a mount can shadow.
COPY apps/nn-demo.wasm /opt/enclave/fixtures/nn-demo.wasm
COPY wasm_manager.py /opt/enclave/wasm_manager.py
COPY ipfs_fetch.py /opt/enclave/ipfs_fetch.py

ENV WASM_MANAGER_PORT=8091 \
    WASM_APPS_DIR=/opt/enclave/apps \
    WASM_FIXTURES_DIR=/opt/enclave/fixtures \
    WASMTIME_BIN=/usr/local/bin/wasmtime

EXPOSE 8091
# the nvidia/cuda base ships a banner-printing entrypoint; drop it so CMD execs
ENTRYPOINT []
CMD ["/usr/bin/python3", "/opt/enclave/wasm_manager.py"]
