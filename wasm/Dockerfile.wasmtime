# enclave-wasmtime: wasmtime CLI built from source with wasi-nn enabled — the
# GPU interface for tenant apps. The stock release binaries do not compile in
# wasi-nn, so this toolchain image exists to produce a `wasmtime` that does:
#
#   - `wasi-nn`                        host API ( -S nn on serve/run )
#   - `wasmtime-wasi-nn/onnx`          ONNX Runtime backend (via the `ort` crate)
#   - `wasmtime-wasi-nn/onnx-cuda`     CUDA execution provider: a guest `load()`
#                                      with ExecutionTarget::Gpu runs on the card;
#                                      ::Cpu stays on the CPU EP, so ONE binary
#                                      serves both enclave flavors.
#   - `wasmtime-wasi-nn/ggml`          llama.cpp backend: GGUF models preloaded
#                                      host-side (-S nn-graph=ggml::<dir>) and
#                                      load_by_name()'d by guests - the BIG-model
#                                      path (weights never enter guest memory).
#   - `wasmtime-wasi-nn/nvenc`         NVENC backend: hardware VIDEO ENCODE
#                                      (-S nn-graph=nvenc::<dir>), one execution
#                                      context per encoder session. Lets an app
#                                      stream its screen without the pixels
#                                      leaving the enclave. Needs the `video`
#                                      driver capability on the node - see
#                                      nvenc-shim/README.md.
#   - ONNX Runtime itself is the OFFICIAL Microsoft GPU build (system-linked
#     via ORT_LIB_LOCATION, pinned by version + sha256). NOT pyke's prebuilt
#     (ort's download-binaries): that one ships SASS only up to sm_89 plus
#     compute_80 PTX, so on an H200 (sm_90) the entire 194MB provider library
#     JIT-compiles at load - the infinite-looking hang chased across
#     v0.5.13-0.5.22. The MS build carries native sm_90 SASS.
#
# This image is NOT rebuilt by CI on every wasm/** change — Dockerfile.wasm
# COPYs the binary out of it by digest, so wasm-manager rebuilds stay fast
# (deploy.yml's detect step explicitly ignores this file for the same reason).
# Rebuild + repush only when bumping WASMTIME_VERSION, via the manual
# "Wasmtime Toolchain" workflow (.github/workflows/toolchain.yml), then update
# the WASMTIME_IMAGE digest in Dockerfile.wasm — THAT commit triggers the
# ordinary wasm-manager rebuild.
#
# Keep WASMTIME_VERSION in lockstep with the P3/socket flags wasm_manager.py
# was verified against (currently the wasmtime 49 dev commit below — the first
# engine that parses cooperative-threading guests; see docs/wasip3-threads.md).
# WASMTIME_VERSION accepts a tag OR a full commit sha: cooperative threading
# shipped between releases, so the pin is the exact dev commit the local
# thread-suite verification ran against. Move it to the v49.0.0 release tag
# when that exists, re-verifying the same suite.
# Base pinned by DIGEST, not just the mutable tag: this image is part of the
# MEASURED enclave TCB, and its sidecar digest is what enclaves/*/tinfoil-config.yml
# commits to. An upstream repush of the same tag silently changes the measurement,
# which is exactly what the reproducibility claim behind METAL_ALLOWED_MEASUREMENTS
# cannot survive (see the root Dockerfile, which has always pinned). This digest is
# what the tag resolved to when it was pinned, so pinning changed nothing about what
# gets built - it only stopped it drifting. Re-pin deliberately on a base bump.
# rust 1.97: wasmtime 49's MSRV is 1.95 (workspace rust-version), which the
# previous 1.93 base predates.
FROM rust:1.97-bookworm@sha256:14bc9c5966e7b3a385794b3d5389a8765668342025fbcc7b2e3d2866ac4bd8c3 AS build

ARG WASMTIME_VERSION=ac0772970b9ad2cd53866d95db69e26311fe3b75
# init+fetch instead of clone --branch: works for tags AND commit shas (same
# pattern as the wasi-libc block in Dockerfile.wasip3-build).
RUN git init -q /src/wasmtime && cd /src/wasmtime \
 && git remote add origin https://github.com/bytecodealliance/wasmtime \
 && git fetch -q --depth 1 origin "${WASMTIME_VERSION}" \
 && git checkout -q FETCH_HEAD
WORKDIR /src/wasmtime

# ONNX Runtime GPU: Enclave's own PATCHED build (nan-onnxruntime), NOT Microsoft's
# prebuilt. Version still 1.22.0 (must match ort-sys 2.0.0-rc.10). The patch
# (wasm/onnxruntime-sm90-mps.patch) guards the sm_90-under-MPS division sites in
# flash/lean attention and adds ORT_DISABLE_MATMUL4BITS_KERNEL - so the fused
# attention kernels are safe to re-enable on the H200. Built by ort-toolchain.yml
# with native sm_86+sm_90 SASS (verified: 8 sm_90 cubins, so no PTX-JIT hang
# under TDX - the original 2026-07-05 root cause). Same tarball layout as MS's,
# so ORT_LIB_LOCATION is unchanged. Rebuild flow: run ort-toolchain.yml -> paste
# ORT_URL/ORT_SHA256 here -> this commit triggers the enclave-wasmtime rebuild.
ARG ORT_VERSION=1.22.0
ARG ORT_URL=https://github.com/EnclaveHost/enclave/releases/download/nan-onnxruntime-v1.22.0-nan1/nan-onnxruntime-linux-x64-gpu-1.22.0.tgz
ARG ORT_SHA256=3972e1591d6587c76ec54446b07e3af03ea4ffd5fbccb8f1414c0e252d87846b
RUN curl -fsSL -o /tmp/ort.tgz "${ORT_URL}" \
 && echo "${ORT_SHA256}  /tmp/ort.tgz" | sha256sum -c - \
 && tar -xzf /tmp/ort.tgz -C /opt && rm /tmp/ort.tgz
ENV ORT_LIB_LOCATION=/opt/onnxruntime-linux-x64-gpu-${ORT_VERSION}

# enclave-llamacpp: the ggml-stack tarball - llama.cpp CUDA libs
# (sm_86+sm_90, GGML_MAX_NAME=128) + stable-diffusion.cpp built against the
# SAME ggml (one ggml per process; see llamacpp-toolchain.yml's header for
# why both constraints are ABI) + the enclave_llama and enclave_sd shims -
# prebuilt by llamacpp-toolchain.yml. The ggml and sdcpp wasi-nn backends
# link against these (system-link pattern, like ORT above); the shims pin
# the FFI boundaries to pointers/scalars so engine bumps can't silently
# break the Rust side. Rebuild flow: run llamacpp-toolchain.yml -> paste
# ELL_URL/ELL_SHA256 here -> this commit triggers the enclave-wasmtime rebuild.
ARG ELL_URL=https://github.com/EnclaveHost/enclave/releases/download/enclave-llamacpp-ddd4ec14-mtp-sequences-20260906/enclave-llamacpp-ddd4ec14-mtp-sequences-20260906.tgz
ARG ELL_SHA256=94f869de0a11725cc739c90f0187729b0e1d0dfd61274517579508401ba8814e
RUN curl -fsSL -o /tmp/ell.tgz "${ELL_URL}" \
 && echo "${ELL_SHA256}  /tmp/ell.tgz" | sha256sum -c - \
 && tar -xzf /tmp/ell.tgz -C /opt && rm /tmp/ell.tgz
ENV ELL_LIB_LOCATION=/opt/enclave-llamacpp-linux-x64-gpu/lib
# sd.cpp + its shim live in the same tarball/dir (one ggml - see above)
ENV ESD_LIB_LOCATION=/opt/enclave-llamacpp-linux-x64-gpu/lib

# mm33 VIDEO: libmtmd's video helper does not decode video itself - it spawns
# ffmpeg/ffprobe and reads frames off a pipe - so the artifact image ships the
# two binaries, STATIC (this is a FROM scratch image: no libc, no shared libs).
# Pinned by sha256 like every other input; the ggml backend looks for them in
# ENCLAVE_GGML_FFMPEG_DIR (default /bin, where they land below). Without them
# the "video" verb refuses with [video_undecodable]; images are unaffected.
# VENDORED on our own releases (like ORT and ELL): upstream johnvansickle.com
# publishes only a floating "release" pointer, which served different bytes to
# a CI runner within hours of the pin (2026-09-01). The asset is the 7.0.2
# static amd64 build, GPLv3, verified against upstream's md5 at vendoring.
ARG FFMPEG_STATIC_URL=https://github.com/EnclaveHost/enclave/releases/download/ffmpeg-static-7.0.2/ffmpeg-release-amd64-static.tar.xz
ARG FFMPEG_STATIC_SHA256=abda8d77ce8309141f83ab8edf0596834087c52467f6badf376a6a2a4c87cf67
RUN curl -fsSL -o /tmp/ffmpeg.tar.xz "${FFMPEG_STATIC_URL}" \
 && echo "${FFMPEG_STATIC_SHA256}  /tmp/ffmpeg.tar.xz" | sha256sum -c - \
 && mkdir -p /opt/ffmpeg && tar -xJf /tmp/ffmpeg.tar.xz -C /opt/ffmpeg --strip-components=1 \
 && rm -f /tmp/ffmpeg.tar.xz \
 && /opt/ffmpeg/ffmpeg -version | head -1 && /opt/ffmpeg/ffprobe -version | head -1 \
 && { ldd /opt/ffmpeg/ffmpeg 2>&1 | grep -qiE "not a dynamic executable|statically linked" || { echo "ffmpeg is not static"; exit 1; }; }

# enclave_nvenc: the video-encode shim (wasm/nvenc-shim), built HERE rather than
# shipped in a tarball like the ggml stack. It can be, because it has no engine
# behind it: libcuda and libnvidia-encode are dlopened at runtime and the CUDA
# driver entry points are declared rather than included, so this compiles with
# nothing but libc and needs no CUDA toolkit, no driver, and no GPU on the build
# host. One cc invocation is cheaper and more auditable than a release artifact.
# The three sources by name, not the directory: this image is MEASURED, and a
# COPY of the whole dir would bake whatever a developer happens to have built
# there (libenclave_nvenc.so, the selftest binary) into a layer, so the same
# commit would not produce the same image from a working tree as from CI.
COPY nvenc-shim/enclave_nvenc.c nvenc-shim/enclave_nvenc.h nvenc-shim/nvEncodeAPI.h /tmp/nvenc-shim/
RUN mkdir -p /opt/enclave-nvenc/lib \
 && cc -shared -fPIC -O2 -Wall -Wextra -Wl,-soname,libenclave_nvenc.so \
      -I/tmp/nvenc-shim /tmp/nvenc-shim/enclave_nvenc.c -ldl -lpthread \
      -o /opt/enclave-nvenc/lib/libenclave_nvenc.so \
 && rm -rf /tmp/nvenc-shim
ENV ENV_LIB_LOCATION=/opt/enclave-nvenc/lib

# Enclave patches (see the .patch header): 1) strict ExecutionTarget::Gpu - the
# CUDA provider initializes or load() fails, never ORT's silent CPU fallback
# (tenants BUY the share); 2) small, non-spinning ORT thread pool - fair on a
# multi-tenant node, and ORT's default per-core spinners livelock CUDA init
# on fully-committed TDX guests.
COPY wasmtime-onnx-gpu-strict.patch /tmp/
RUN git apply --check /tmp/wasmtime-onnx-gpu-strict.patch \
 && git apply /tmp/wasmtime-onnx-gpu-strict.patch

# enclave-vault WASI-fs shim: `-S vault=<guest>::<skeleton>::<cipherdir>` mounts a
# NANVOL2 block-encrypted volume as a normal read-only guest directory - the
# wasmtime HOST decrypts 4MiB blocks on demand (XChaCha20-Poly1305 + HKDF, VEK
# via $ENCLAVE_VAULT_KEY_<i>, host process env only). Pure userspace: no FUSE, no
# device-mapper, nothing privileged. Metadata is served by a sparse skeleton
# tree the wasm-manager materializes at unlock; only content reads route
# through decryption. This is how tenants read LARGE confidential volumes
# transparently at /enc/<name> (the manager probes for the flag and falls back
# to its loopback HTTP data plane on toolchains without it). Adds pinned
# pure-Rust crypto deps (chacha20poly1305, hkdf) to the wasmtime-wasi crate;
# the Cargo.lock delta is part of the patch.
#
# DEAD SURFACE — RECOMMEND REMOVING THIS PATCH. The NANVOL2 design it implements
# was hard-cut on 2026-07-07 and superseded by encrypted volumes over rclone
# crypt + S3 (see wasm_manager.py's "Encrypted volumes" block). Verified: nothing
# in the tree passes `-S vault=` — not the manager, not any script, workflow or
# config — so these 985 lines of XChaCha20-Poly1305/HKDF plus a `read_at`
# interception hook are compiled into the TENANT SANDBOX runtime for a flag that
# is never set. It is inert rather than misbehaving (every hook is gated behind
# `Option<VaultDirCtx>`, so the unused cost is a None branch, and the manager's
# comment about "probing for the flag" describes a fallback nothing reaches), but
# dead code inside a sandbox is surface with no test exercising it and two crypto
# dependencies carried in the measured TCB for nothing.
#
# Not removed here on purpose: dropping it changes the wasmtime binary, hence the
# wasm-manager sidecar digest, hence the enclave measurement — which invalidates
# every published Metal measurement and forces a fleet rebuild. That is an
# operational event to schedule, not a 4am edit. When it goes: delete the patch
# file, this block, and re-cut the toolchain image.
COPY wasmtime-vault-fs.patch /tmp/
RUN git apply --check /tmp/wasmtime-vault-fs.patch \
 && git apply /tmp/wasmtime-vault-fs.patch

# UPSTREAM BUG FIX — wasip2 outbound HTTP goes out with NO Host header.
# Wasmtime 45 synthesized `host` from the request authority inside
# `p2::default_send_request_handler`. 49 unified the p2/p3 send paths into
# `default_send_request`, which rewrites the URI to origin-form and synthesizes
# nothing — and only the p3 path was taught to add `host` (p3/request.rs, gated
# on the `set_host_header` hook). hyper's http1 client conn does not add one
# either. So from the 49-dev repin (e98d3299, 2026-08-07) every wasip2 guest's
# outbound request left the enclave headerless and any RFC 9112 compliant server
# answered 400: web search, fetch_url, vision delegation, image generation and
# the in-app attestation relay all failed fleet-wide while inference (wasi:nn,
# not wasi:http) kept working, which is what made it look like an app bug.
# Guests cannot compensate — `host` is in DEFAULT_FORBIDDEN_HEADERS, so deriving
# it from the authority is by contract the host's job. This restores the 45
# behaviour at the p2 request-construction site, honouring the same hook p3 uses.
# Still present on upstream main (3ebfbe5) — carry until upstream takes it.
COPY wasmtime-p2-host-header.patch /tmp/
RUN git apply --check /tmp/wasmtime-p2-host-header.patch \
 && git apply /tmp/wasmtime-p2-host-header.patch

# enclave transparent egress (phase 2 of dedicated-IP egress): `-S egress=<host>:<port>`
# routes ALL guest outbound — wasi:sockets TCP connect AND the wasi:http outgoing
# handler — through the enclave's loopback SOCKS5 front (egress.js), so an
# UNMODIFIED app leaves from the deployment's dedicated IPv6 with no way to reach
# the raw network. The per-deployment SOCKS credential rides $ENCLAVE_EGRESS_CRED
# (host process env only, guest-invisible — same delivery as the vault VEKs); the
# wasm-manager also drops -Sinherit-network in run mode when egress is on. Pure
# userspace: no new crates (std + the tokio already in wasmtime-wasi), so no
# Cargo.lock delta. See wasm/wasmtime-egress.patch and the enclave-side egress.js.
COPY wasmtime-egress.patch /tmp/
RUN git apply --check /tmp/wasmtime-egress.patch \
 && git apply /tmp/wasmtime-egress.patch

# THE CROSS-TENANT WALL: `-S loopback-allow=<ports>` (wasm/wasmtime-loopback.patch,
# whose header carries the full reasoning). The egress carve-out above dials a
# literal loopback IP DIRECT — which is what keeps /encvol and the front
# reachable, and also let a guest dial a SIBLING TENANT's port, landing inside
# its app around the supervisor's /x/:id (private-deployment auth, the
# deployer's WAF). Tenants share one network namespace, so nothing at the
# services could close that. Must apply AFTER the egress patch: it modifies the
# file that one creates. Pure std/tokio, no Cargo.lock delta.
COPY wasmtime-loopback.patch /tmp/
RUN git apply --check /tmp/wasmtime-loopback.patch \
 && git apply /tmp/wasmtime-loopback.patch

# enclave ggml wasi-nn backend: GGUF models (llama.cpp) behind wasi:nn -
# `-S nn-graph=ggml::<dir>` preloads a model under the dir basename, guests
# load_by_name() it, and the weights never enter guest linear memory (model
# size is bounded by the tenant's share, not wasm32's 4 GiB). Pure std+FFI
# against the enclave_llama shim above - no Cargo.lock delta. MUST apply
# after the other patches (diffed against the patched tree - onnx-gpu-strict
# touches the same files).
# mm30 COHORT BATCHING (2026-08-20): a decode leader holds the batch a few ms
# for the other sequences that are stepping, and decodes them in seq_id order.
# Merging whatever happened to be queued made the participating-sequence set
# oscillate ({0,1}, {0}, {1}, ...) and llama will not reuse a graph whose
# sequence set changed - so every CONCURRENT decode ran un-captured, ~50-90 ms
# against ~16 ms for a replayed one. ENCLAVE_GGML_COHORT_MS=0 is the rollback.
COPY wasmtime-nn-ggml.patch /tmp/
RUN git apply --check /tmp/wasmtime-nn-ggml.patch \
 && git apply /tmp/wasmtime-nn-ggml.patch

# enclave sdcpp wasi-nn backend: image checkpoints (stable-diffusion.cpp)
# behind wasi:nn - `-S nn-graph=sd::<dir>` preloads, guests load_by_name()
# and one compute() runs the whole txt2img pipeline. Weights never enter
# guest memory - the big-model image path (SD-Turbo full checkpoints, SDXL,
# FLUX gguf quants). Links libenclave_sd + libstable-diffusion from the
# ggml-stack tarball above (ESD_LIB_LOCATION).
COPY wasmtime-nn-sdcpp.patch /tmp/
RUN git apply --check /tmp/wasmtime-nn-sdcpp.patch \
 && git apply /tmp/wasmtime-nn-sdcpp.patch

# enclave nvenc wasi-nn backend: hardware VIDEO ENCODE behind wasi:nn -
# `-S nn-graph=nvenc::<dir>` preloads (no model; the graph IS the encoder),
# guests load_by_name("nvenc") and one compute() encodes one frame into one
# access unit. This is what lets an app stream its own screen without the
# pixels leaving the enclave - the alternative is a native sidecar beside the
# CVM holding plaintext framebuffers, outside the attestation. Encode is
# STATEFUL (frame N references N-1), so one execution context is one encoder
# session. Links libenclave_nvenc (ENV_LIB_LOCATION above) and nothing else -
# the driver is dlopened, so this backend is safe to compile into every build
# and reports "no hardware video encoder" on a node without one. MUST apply
# after sdcpp: it reuses the preload_kind lookup that patch adds.
COPY wasmtime-nn-nvenc.patch /tmp/
RUN git apply --check /tmp/wasmtime-nn-nvenc.patch \
 && git apply /tmp/wasmtime-nn-nvenc.patch

# enclave onnx named-graph preload: `-S nn-graph=onnx::<volume dir>`
# registers EVERY *.onnx in the volume as "<volume>/<component>" at server
# startup (diffusers layouts carry several models per volume); guests
# load_by_name() them and model bytes stop transiting guest memory and
# hostcall fuel entirely - the structural big-model path for ONNX, engine
# (ORT) already host-side. Rides the existing onnx feature; sessions build
# through the same content-hash cache the guest load() path uses, so old
# apps converge on the same sessions unchanged.
COPY wasmtime-nn-onnx-preload.patch /tmp/
RUN git apply --check /tmp/wasmtime-nn-onnx-preload.patch \
 && git apply /tmp/wasmtime-nn-onnx-preload.patch

# enclave GPU request-level arbiter client (work-conserving fair share): one
# `arbiter::turn()` per GPU compute quantum against the wasm-manager's
# arbiter socket, plus the eager connect its capability probe observes.
# INERT until the manager arms ENCLAVE_NN_ARBITER (WASM_NN_ARBITER=1 + probe),
# so this patch landing before or after a manager release is safe either way.
# Must apply LAST: it is diffed against the fully-patched tree (it touches
# the files the nn patches create/rewrite).
COPY wasmtime-nn-arbiter.patch /tmp/
RUN git apply --check /tmp/wasmtime-nn-arbiter.patch \
 && git apply /tmp/wasmtime-nn-arbiter.patch

# enclave SHARED-EVERYTHING THREADS (SET): real OS threads for wasip2 guests,
# via the component model's `thread.spawn-indirect` builtin. Guest side is
# `enclave-wasipsetc-build` (clang -pthread + wasm/wasi-libc-set-threads.patch);
# this is the engine half. Twenty-one adversarial review rounds are recorded in
# git history under "SET round N"; the last five found nothing in the code.
#
# INERT WITHOUT A GUEST THAT ASKS FOR IT. `_set_flags()` in wasm_manager arms
# `-W shared-everything-threads` only for components carrying
# `[set-spawn-indirect]`, and no catalog app does today. Every non-SET tenant
# takes byte-identical paths -- full `tests/all` is 1305/0 on this tree.
#
# Two things about the wasmparser fork, both load-bearing:
#  * the SET patch's Cargo.toml adds `[patch.crates-io] wasmparser = { path =
#    "vendor/wasmparser" }`, so the vendored copy MUST exist before it applies
#    or cargo fails at resolve time (not build time -- the error is confusing);
#  * `wasmparser-set-relax.patch` is a PLAIN unified diff against the CRATE
#    ROOT, not a git-format diff against the wasmtime tree, so it takes
#    `patch -p1 -d vendor/wasmparser` and canNOT be added to the
#    `git apply` loop in wasmtime-patch-check.yml. That workflow checks it
#    separately; see its header.
#
# The relaxation itself: upstream validation requires the spawn function's
# sharedness to match the spec shape. This engine gives every worker its own
# execution view, so unshared state is per-thread and a toolchain-shaped guest
# (plain start type) is as sound as a spec-shaped one. The fork makes the
# synthesized import follow the declared spawn type so both link.
ARG WASMPARSER_VERSION=0.254.0
ARG WASMPARSER_SHA256=d5769a29f799fbab136aaf65b4fe5384cd7d93fe6fc9ba0dcb6c8382a1f16e27
COPY wasmparser-set-relax.patch /tmp/
RUN curl -sSLf -o /tmp/wasmparser.crate \
      "https://static.crates.io/crates/wasmparser/wasmparser-${WASMPARSER_VERSION}.crate" \
 && echo "${WASMPARSER_SHA256}  /tmp/wasmparser.crate" | sha256sum -c - \
 && mkdir -p vendor/wasmparser \
 && tar -xzf /tmp/wasmparser.crate -C vendor/wasmparser --strip-components=1 \
 && patch -p1 -d vendor/wasmparser --dry-run < /tmp/wasmparser-set-relax.patch \
 && patch -p1 -d vendor/wasmparser < /tmp/wasmparser-set-relax.patch \
 && rm -f /tmp/wasmparser.crate

# Must apply AFTER nn-arbiter: the SET patch is diffed against the fully-patched
# tree (all nine enclave patches applied), which is also why regenerating it
# needs a reconstructed 9-patch baseline and `git diff HEAD`, not `git diff`.
COPY wasmtime-set-threads.patch /tmp/
RUN git apply --check /tmp/wasmtime-set-threads.patch \
 && git apply /tmp/wasmtime-set-threads.patch

# enclave socket level-check: kernel truth beats a stale readiness cache — THE
# tunnel-stall fix (risc-box, 2026-08-20; full evidence in the .patch header).
# tokio's edge-cached readiness can lose an edge and then say "not ready"
# indefinitely about a socket the kernel would serve — a socket that STAYS
# writable generates no new edges, so nothing self-heals — freezing a sync
# guest's whole socket set 0.5-14s while its event loop stays healthy. On the
# paths a sync guest spins on (tcp send/recv and their readiness polls), when
# the cache says "not ready", ask the kernel directly (nonblocking send/recv,
# zero-timeout poll(2)) before believing it; the cache stays the fast path and
# the extra syscall happens only where the old code stalled. Measured locally:
# SET-guest probe stalls went 59/10min (worst 1.2s) -> 0 (worst 14ms), with
# 2,098 write + 64 read cache-vs-kernel divergences absorbed in 5 minutes.
# Also ships the ENCLAVE_SOCKDBG=1 gauges (host env, off by default): the
# divergence counters, empty-read streaks with a FIONREAD verdict, and a 10ms
# runtime heartbeat that logs scheduling gaps — fleet diagnosis without ss or
# strace inside a CVM. No new deps (rustix event/net were already enabled).
# Order-independent of the SET patch (verified applying both ways); kept last
# so its diff context matches the fully-patched tree it was measured on.
COPY wasmtime-socket-level-check.patch /tmp/
RUN git apply --check /tmp/wasmtime-socket-level-check.patch \
 && git apply /tmp/wasmtime-socket-level-check.patch

# enclave SET epochs opt-out: `-W set-epochs=n` removes the epoch-interruption
# codegen (a check per function entry + loop back-edge) that SET otherwise
# forces on — the LAST engine-side cost of declaring shared-everything-threads
# (~10% guest MIPS on risc-box; bounds checks on shared memories were already
# elided upstream). Promptness trade, not soundness: parked workers still stop
# via the parking spot, host-blocked workers via future drop, and spinning
# workers hit the bounded join + reaper detach; `--wasm timeout` re-arms the
# full epoch machinery. Armed per-tenant by wasm_manager._set_flags (probed).
# Evidence + probes in the .patch header. Applies LAST: diffed against the
# fully-patched tree.
COPY wasmtime-set-epochs.patch /tmp/
RUN git apply --check /tmp/wasmtime-set-epochs.patch \
 && git apply /tmp/wasmtime-set-epochs.patch

# enclave shared-base mirror: defined SHARED memories get their base pointer
# mirrored into a per-memory vmctx slot at instantiation (a shared base can
# never move), and codegen reads THAT — one load to the heap base, the same
# shape owned memories get, instead of two dependent loads through the
# out-of-line VMMemoryDefinition rederived after every call. Measured +6.4%
# on a call-per-iteration guest loop, and most of risc-box's residual SET
# gap. The SET worker re-point updates the mirror too — a stale mirror there
# would run the worker on the wrong memory. Evidence in the .patch header.
# Applies LAST: diffed against the fully-patched tree.
COPY wasmtime-shared-base-mirror.patch /tmp/
RUN git apply --check /tmp/wasmtime-shared-base-mirror.patch \
 && git apply /tmp/wasmtime-shared-base-mirror.patch

# Allow the shared wasm64 app to compose with its wasm32 WASI adapter.
# UTF-8 transfers use owned snapshots and atomic guest-byte access; shared
# adapters with other string encodings remain rejected before code generation.
COPY wasmtime-shared-utf8-adapters.patch /tmp/
RUN git apply --check /tmp/wasmtime-shared-utf8-adapters.patch \
 && git apply /tmp/wasmtime-shared-utf8-adapters.patch

# System-linked ORT: the binary NEEDS libonnxruntime.so.1 at runtime; ship it
# plus the two provider dylibs the CUDA EP dlopens (providers_shared is the
# dispatcher). providers_tensorrt is deliberately not shipped (never
# requested; would need TensorRT libs). ldconfig in the consuming image
# creates the soname link from the versioned file.
RUN cargo build --release \
      --features "wasi-nn,wasmtime-wasi-nn/onnx-cuda,wasmtime-wasi-nn/ggml,wasmtime-wasi-nn/sdcpp,wasmtime-wasi-nn/nvenc" \
 && mkdir -p /out/bin /out/lib \
 && cp -a target/release/wasmtime /out/bin/ \
 && cp -L "${ORT_LIB_LOCATION}/lib/libonnxruntime.so.${ORT_VERSION}" /out/lib/ \
 && cp -L "${ORT_LIB_LOCATION}/lib/libonnxruntime_providers_shared.so" /out/lib/ \
 && cp -L "${ORT_LIB_LOCATION}/lib/libonnxruntime_providers_cuda.so" /out/lib/ \
 && cp -a "${ELL_LIB_LOCATION}"/lib*.so* /out/lib/ \
 && cp -a "${ENV_LIB_LOCATION}"/libenclave_nvenc.so /out/lib/ \
 && cp -a /opt/ffmpeg/ffmpeg /opt/ffmpeg/ffprobe /out/bin/ \
 && ls -laR /out/

# artifact-only image: /bin/wasmtime + /bin/ffmpeg + /bin/ffprobe (static) + /lib/<dylibs>, nothing else
FROM scratch
COPY --from=build /out/ /
