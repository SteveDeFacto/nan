+    ) -> *mut c_void;
+    fn ell_mtp_free(m: *mut c_void);
+    fn ell_mtp_harvest(m: *mut c_void, target_ctx: *mut c_void, seq: i32, n_rows: i32);
+    fn ell_mtp_observe(m: *mut c_void, seq: i32, pos0: i32, tokens: *const i32, n: i32) -> i32;
+    fn ell_mtp_draft(
+        m: *mut c_void,
