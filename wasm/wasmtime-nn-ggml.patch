index 0000000..fdde186
--- /dev/null
+++ b/crates/wasi-nn/src/backend/ggml.rs
@@ -0,0 +1,3738 @@
+//! A ggml/llama.cpp backend for wasi-nn — GGUF language models behind the
+//! standard `wasi:nn` interface.
+//!
+//! The heavy lifting happens in the system-linked `enclave_llama` shim (a
+//! flat pointer/scalar C ABI over llama.cpp, shipped next to libllama in the
+//! enclave-llamacpp toolchain artifact — see wasm/llama-shim in the platform
+//! repo). This file binds the shim functions and adapts them to the
+//! wasi-nn backend traits. No new crates: std + FFI only, so the toolchain
+//! patch carries no Cargo.lock delta.
+//!
+//! The llama.cpp libs are built GGML_BACKEND_DL: the compute backends (cpu,
+//! cuda) are dlopened modules, loaded by `ell_init()` from
+//! ENCLAVE_GGML_BACKEND_DIR — the wasmtime binary carries no DT_NEEDED on
+//! libcuda.so.1, so it starts on driverless (CPU-flavor) nodes. The flip
+//! side is that a broken CUDA module load degrades SILENTLY to CPU, so
+//! `load_path` enforces: GPU offload requested but no ggml GPU device
+//! loaded = loud failure, never a silent CPU fallback (tenants BUY the
+//! share — same discipline as the strict-GPU ONNX patch).
+//!
+//! Model delivery is `load_by_name()` via the CLI preload registry
+//! (`-S nn-graph=ggml::<dir>`): the HOST opens the GGUF straight off the
+//! (read-only, attested) model volume, so weights never transit the guest's
+//! 32-bit linear memory — the whole point for large models. `load()` from
+//! guest bytes also works for small models: the bytes are staged to a temp
+//! file because llama.cpp wants a path.
+//!
+//! Inference contract (WIT named tensors):
+//!   input  "tokens"  I32  dims [1, n] (n <= n_batch)   token ids
+//!   output "logits"  Fp32 dims [1, n_vocab]            last-token logits
+//! mm34 prefix cache: "prompt" I32 [1, N] beside a prompt's FIRST "tokens"
+//!   chunk declares the whole prompt, and the engine branches off the longest
+//!   parked prefix right there; every later chunk feeds only what lies past
+//!   the park (see PromptPlan). "more" I32 [1] = 1 on a non-final chunk is
+//!   accepted and ignored since mm34 (mm32/mm33 held such chunks back and
+//!   replayed them in one call on divergence). mm35: "marks" I32 [k] beside
+//!   "prompt" names positions where a shared prefix ends (system text, tool
+//!   block); the state there is parked as prefill crosses it, on its own
+//!   slot budget, so every prompt that starts the same way branches off it.
+//! mm36 shared warming: {"prefix_wait": I32 [1] = 1} beside that first chunk
+//!   opts the caller into WAITING when another context is already preparing
+//!   the exact prefix of one of its marks: the chunk is refused with the
+//!   "[prefix_warming] ... (N of M tokens)" marker and nothing changes; the
+//!   guest retries the same chunk shortly and branches off the park the
+//!   moment it stands (see prefix_claims.rs). Without the opt-in, callers
+//!   warm concurrently as before. "caps" indices 14..16 = [protocol (1),
+//!   live claims, standing parks].
+//! Speculative-decoding verbs (see each handler in `compute`):
+//!   "tokens"+"all"=1 -> "logits" [n, n_vocab] (per-position verify rows);
+//!   "caps" -> [seq_id, recurrent, mtp, vision, n_batch, host_tok,
+//!   rewind_depth]; "copy_from" [src_seq, src_n_past] branches this
+//!   sequence off another (recurrent state copy-on-write — the zero-memory
+//!   alternative to "rewind", which recurrent/hybrid models refuse unless
+//!   caps' rewind_depth > 0: then the context snapshots that many trailing
+//!   tokens per decode and "rewind" within the depth succeeds anywhere).
+//! MTP self-drafting (models whose GGUF carries a trained next-token head):
+//!   "tokens"+"mtp"=1 -> MTP-aware feed (head observes every position, last
+//!   logits row returned); "tokens"+"all"=1+"mtp_for"=[seq] -> verify pass
+//!   harvesting head rows for the real sequence; "mtp_draft"
+//!   [id_last, k, p_min_milli] -> "draft" [n] proposals; "mtp_accept"
+//!   [pos0, tokens...] mirrors accepted tokens into the head. No separate
+//!   draft model, no second weights allocation — the head context costs one
+//!   attention layer's KV.
+//! VISION (a volume that pairs its model with an *mmproj*.gguf projector):
+//!   "image" U8 [n] = one image FILE's bytes (png/jpeg/webp/gif/bmp) ->
+//!   "image_pos" I32 [1], the positions it consumed. Guests interleave it
+//!   with "tokens" to place a picture inside a rendered prompt: text before,
+//!   image, text after. libmtmd owns everything model-specific (the marker
+//!   tokens around an image, non-causal image masks, M-RoPE's 2-D image
+//!   positions), so no vision knowledge lives here or in the guest. The shim
+//!   entry points behind it are resolved by DLSYM, so a node whose toolchain
+//!   predates them still builds, still serves text, and reports vision=0.
+//!
+//! SERVING MODEL (continuous batching): an execution context is a SEQUENCE
+//! HANDLE into its graph's shared server context. llama.cpp serves up to
+//! ENCLAVE_GGML_MAX_SESSIONS concurrent sequences out of ONE unified KV pool
+//! of n_ctx tokens TOTAL — a slot costs no pre-allocated VRAM of its own,
+//! each chat consumes only the pool space its actual tokens need. Concurrent
+//! requests' decode steps MERGE into single batched llama_decode calls (the
+//! leader protocol in GgmlServer::submit): decode is memory-bandwidth-bound,
+//! one pass over the weights serves every active chat, so aggregate
+//! throughput scales with concurrency instead of dividing by it. A fresh
+//! wasi-nn execution context = a fresh sequence; dropping it frees its
+//! tokens back to the pool. NOTE: batched and serial decodes may differ in
+//! floating-point reduction order — greedy token streams are deterministic
+//! only for a fixed batch composition (compare like with like).
+//!
+//! Isolation: one server per GRAPH per tenant PROCESS. Cross-app isolation
+//! is the process boundary (each tenant is its own `wasmtime serve` with its
+//! own MPS partition) — batching only ever merges requests of the same
+//! deployment, and sequences are kept apart by llama.cpp's seq_id-keyed KV
+//! masking (the llama-server production mechanism).
+//!
+//! Tuning env (host process only, set per tenant by the wasm-manager):
+//!   ENCLAVE_GGML_N_CTX          KV pool size in TOKENS, shared by all of a
+//!                               graph's concurrent sequences (default 8192;
+//!                               0 = model max)
+//!   ENCLAVE_GGML_N_BATCH        max tokens per llama_decode (default 512)
+//!   ENCLAVE_GGML_N_GPU_LAYERS   -1 = offload all (default when built with
+//!                               CUDA-enabled libllama), 0 = pure CPU
+//!   ENCLAVE_GGML_KV_CACHE_TYPE  KV-cache element type: f16 (default) | q8_0 |
+//!                               q4_0 | f32. q8_0 ~halves / q4_0 ~quarters the
+//!                               VRAM the pool costs up front.
+//!                               ..._K / ..._V override one side only.
+//!   ENCLAVE_GGML_FLASH_ATTN     auto (default) | on | off. A quantized V cache
+//!                               requires Flash Attention, so a q8_0/q4_0 V is
+//!                               auto-promoted to on unless explicitly off.
+//!   ENCLAVE_GGML_MAX_SESSIONS   concurrent sequences per graph (default 1).
+//!                               Slots into the SHARED pool — raising it costs
+//!                               no extra pre-allocated VRAM (the pool is
+//!                               sized once by N_CTX). No free slot = fail
+//!                               fast with [sessions_busy] for guests to
+//!                               wait-and-retry on; pool pressure at decode
+//!                               time surfaces as [kv_pool_full] (retryable —
+//!                               llama restores state on that failure).
+//!   ENCLAVE_GGML_BACKEND_DIR    dir holding the dlopened libggml-* backend
+//!                               modules (unset = exe dir + cwd)
+//!   ENCLAVE_GGML_N_UBATCH       physical batch size (read by the SHIM, not
+//!                               here). Only vision models that decode images
+//!                               non-causally need it above llama's default:
+//!                               such an image must fit ONE ubatch or the
+//!                               "image" verb refuses with [image_too_wide].
+//!   ENCLAVE_GGML_MMPROJ_FILE    projector file name inside the volume, when
+//!                               it is not the conventional *mmproj*.gguf
+//!   ENCLAVE_GGML_IMAGE_MAX_TOKENS  cap the tokens ONE image may expand to on
+//!                               dynamic-resolution vision models (0 = the
+//!                               mmproj's own metadata). The lever that stops
+//!                               a large photo from eating the KV pool.
+//!   ENCLAVE_GGML_MTMD_THREADS   CPU threads for image preprocessing
+//!                               (default 4; the encode follows the model
+//!                               onto the GPU)
+//!   ENCLAVE_GGML_COMPUTE_WATCHDOG_S  engine-watchdog ceiling for one verb /
+//!                               context init / session teardown (default
+//!                               600; 0 disables). See the watchdog section
+//!                               below for why exceeding it ABORTS.
+//!   ENCLAVE_GGML_LOAD_WATCHDOG_S  engine-watchdog ceiling for one model
+//!                               load (default 3600; 0 disables) — sized
+//!                               for a cold 100+ GB volume read.
+
+use super::{
+    BackendError, BackendExecutionContext, BackendFromDir, BackendGraph, BackendInner, Id,
+    NamedTensor,
+};
+use crate::wit::types::{ExecutionTarget, GraphEncoding, Tensor, TensorType};
+use crate::{ExecutionContext, Graph};
+use std::collections::{HashMap, VecDeque};
+use std::ffi::{c_char, c_void, CString};
+use std::path::{Path, PathBuf};
+use super::prefix_claims::{ClaimVerdict, PrefixClaims, DEFAULT_STALE_SECS, PREFIX_WARMING_ERR};
+use std::sync::atomic::{AtomicU64, AtomicUsize, Ordering};
+use std::sync::{Arc, Condvar, Mutex, Once, OnceLock};
+use std::time::{Duration, Instant};
+
+unsafe extern "C" {
+    fn ell_init();
+    fn ell_gpu_devices() -> i32;
+    fn ell_load_model(path: *const c_char, n_gpu_layers: i32) -> *mut c_void;
+    fn ell_free_model(model: *mut c_void);
+    fn ell_n_vocab(model: *mut c_void) -> i32;
+    fn ell_tokenize(model: *mut c_void, text: *const i8, text_len: i32,
+                    out_ids: *mut i32, out_cap: i32) -> i32;
+    fn ell_token_piece(model: *mut c_void, id: i32, buf: *mut i8, cap: i32) -> i32;
+    fn ell_d2h_probe(size_mb: i32, out: *mut i64) -> i32;
+    fn ell_graph_perf(ctx: *mut c_void, out: *mut i64) -> i32;
+    fn ell_graph_perf2(ctx: *mut c_void, out: *mut i64) -> i32;
+    fn ell_free_context(ctx: *mut c_void);
+    fn ell_reset(ctx: *mut c_void);
+    fn ell_new_server(
+        model: *mut c_void,
+        n_ctx: u32,
+        n_batch: u32,
+        n_seq_max: u32,
+        type_k: i32,
+        type_v: i32,
+        flash_attn: i32,
+    ) -> *mut c_void;
+    fn ell_decode_batch(
+        ctx: *mut c_void,
+        model: *mut c_void,
+        n_items: i32,
+        seq_ids: *const i32,
+        counts: *const i32,
+        positions: *const i32,
+        tokens_flat: *const i32,
+        logits_flat: *mut f32,
+    ) -> i32;
+    fn ell_seq_remove(ctx: *mut c_void, seq_id: i32);
+    fn ell_decode_seq_full(
+        ctx: *mut c_void,
+        model: *mut c_void,
+        seq_id: i32,
+        pos0: i32,
+        tokens: *const i32,
