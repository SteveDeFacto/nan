+struct MtmdHandle(*mut c_void);
+unsafe impl Send for MtmdHandle {}
+impl Drop for MtmdHandle {
+    fn drop(&mut self) {
+        // resolved when the handle was created, so it exists here
+        if let Some(syms) = mtmd_syms() {
+            unsafe { (syms.free)(self.0) };
+        }
+    }
+}
+unsafe impl Send for GgmlServer {}
+unsafe impl Sync for GgmlServer {}
+impl Drop for GgmlServer {
+    fn drop(&mut self) {
+        unsafe { ell_free_context(self.raw) };
+    }
+}
+
+/// llama_decode rc -> caller-facing message. rc 1 = the pool momentarily
+/// cannot hold the step; llama RESTORES state on it, so it is retryable.
+/// Host-side top-k reduction of a logits row block: the guest sampler only
+/// ever looks at a bounded candidate set (top_k <= 256 in practice), so
+/// shipping the full vocab row (~1MB at 248320 floats) across the wasi-nn
+/// boundary per position - and scanning it in wasm - is pure per-token tax.
+/// An {"topk": K} input beside "tokens" replaces the "logits" output with
+/// "topk_ids" I32 [n,K] + "topk_logits" Fp32 [n,K], each row sorted by
+/// logit descending. Selection runs on the host CPU; K clamps to 16..=1024.
+fn topk_rows(flat: &[f32], rows: usize, vocab: usize, k: usize) -> (Tensor, Tensor) {
+    let k = k.min(vocab);
+    let mut ids_data = Vec::with_capacity(rows * k * 4);
+    let mut val_data = Vec::with_capacity(rows * k * 4);
+    // total-order key: monotone f32 -> u32 bit trick (negatives flipped,
+    // positives offset), so the heap never touches partial_cmp. Selection
+    // runs INSIDE the exclusive decode turn - it must stay O(n log k) with
+    // a one-branch-per-element scan, not an O(n*k) rescan-the-min loop
+    // (the first cut of this function cost MTP rounds ~30ms each).
+    fn fkey(v: f32) -> u32 {
+        let b = v.to_bits();
+        if b & 0x8000_0000 != 0 { !b } else { b | 0x8000_0000 }
+    }
+    for r in 0..rows {
+        let row = &flat[r * vocab..(r + 1) * vocab];
+        let mut heap: std::collections::BinaryHeap<std::cmp::Reverse<(u32, u32)>> =
+            std::collections::BinaryHeap::with_capacity(k + 1);
+        for (i, &v) in row.iter().enumerate() {
+            let kk = fkey(v);
+            if heap.len() < k {
+                heap.push(std::cmp::Reverse((kk, i as u32)));
+            } else if kk > heap.peek().unwrap().0 .0 {
+                *heap.peek_mut().unwrap() = std::cmp::Reverse((kk, i as u32));
+            }
+        }
+        let mut cand: Vec<(u32, u32)> = heap.into_iter().map(|std::cmp::Reverse(p)| p).collect();
+        cand.sort_unstable_by(|a, b| b.0.cmp(&a.0));
+        for (kk, i) in cand {
+            let _ = kk;
+            ids_data.extend_from_slice(&(i as i32).to_le_bytes());
+            val_data.extend_from_slice(&row[i as usize].to_le_bytes());
+        }
+    }
+    (
+        Tensor { dimensions: vec![rows as u32, k as u32], ty: TensorType::I32, data: ids_data },
+        Tensor { dimensions: vec![rows as u32, k as u32], ty: TensorType::Fp32, data: val_data },
+    )
+}
+
+/// A refusal the speculative guest is expected to HANDLE, not report: drop
+/// to plain decode for the rest of the request, and its steps then merge with
+/// the other chat's instead of alternating against them. Tagged so it can
+/// never be mistaken for a real failure.
+const SHARED_ERR: &str =
+    "[mtp_shared] another chat is generating on this model - a speculative round takes the decode \
+     turn alone, so while shared it is slower than the merged batch; decode plain and the streams \
+     merge into one pass";
+
+/// mm31 opt-in: does this caller understand [mtp_shared]? A guest that sends
+/// `{"shared_ok": 1}` beside a speculative verb is telling the host it will
+/// finish the turn on plain decode if the round is refused. Everything else -
+/// every app built before mm31 - is served exactly as it always was, because
+/// refusing a guest that treats the error as fatal would trade a slow answer
+/// for a failed one.
+fn shared_ok(inputs: &[NamedTensor]) -> bool {
+    inputs
+        .iter()
+        .find(|nt| nt.name == "shared_ok")
+        .and_then(|nt| nt.tensor.data.get(0..4))
+        .map(|b| i32::from_le_bytes([b[0], b[1], b[2], b[3]]) != 0)
+        .unwrap_or(false)
+}
+
+fn decode_err(rc: i32) -> String {
+    if rc == 1 {
+        "[kv_pool_full] the shared KV pool cannot hold this step right now — too many (or too \
+         long) concurrent chats; retry shortly, or redeploy with a larger share"
+            .to_string()
+    } else {
+        format!("llama_decode failed (rc {rc}; context window exhausted?)")
+    }
+}
+
+impl GgmlServer {
+    /// mm31: is some OTHER sequence generating right now?
+    ///
+    /// Speculation is a SINGLE-STREAM optimisation on this engine. A round
+    /// takes the decode turn exclusively (the verify is one sequence's
+    /// all-positions pass), so two speculating chats both serialise AND lose
+    /// llama's graph reuse to the alternating sequence id - measured on a 27b
+    /// hybrid, a round costs 26 ms alone and 99 ms with two chats, of which
+    /// 45 ms is waiting out the other one's turn and most of the rest is the
+    /// rebuilt graph. Merged plain decode has the opposite shape: a
+    /// two-sequence step costs what a one-sequence step costs, because the
+    /// weights are read once for both. So the moment a second chat arrives
+    /// speculation is the wrong trade, and the MTP verbs refuse with
+    /// SHARED_ERR so the guest drops onto the batched path instead.
+    fn shared_with(&self, seq_id: i32) -> bool {
+        let mut q = self.q.lock().unwrap();
+        let now = Instant::now();
+        let ttl = cohort_ttl();
+        q.stepping.retain(|_, t| now.duration_since(*t) < ttl);
+        q.stepping.keys().any(|s| *s != seq_id)
+    }
+
+    /// Record that `seq_id` is generating - a speculative round counts, the
+    /// same as a plain step - and answer whether anyone else is too.
+    fn mark_and_share(&self, seq_id: i32) -> bool {
+        let mut q = self.q.lock().unwrap();
+        let now = Instant::now();
+        let ttl = cohort_ttl();
+        q.stepping.retain(|_, t| now.duration_since(*t) < ttl);
+        q.stepping.insert(seq_id, now);
+        q.stepping.keys().any(|s| *s != seq_id)
+    }
+
+    fn new(model: &Arc<GgmlModel>) -> Result<Arc<GgmlServer>, BackendError> {
+        let n_ctx = env_u32("ENCLAVE_GGML_N_CTX", 8192);
+        let n_batch = env_u32("ENCLAVE_GGML_N_BATCH", 512);
+        let n_seq_max = env_u32("ENCLAVE_GGML_MAX_SESSIONS", 1).max(1);
+        // KV-cache quantization: ENCLAVE_GGML_KV_CACHE_TYPE sets both sides
+        // (f16|q8_0|q4_0|f32); ..._K / ..._V override per side. A quantized KV
+        // cache roughly halves (q8_0) or quarters (q4_0) the up-front VRAM the
+        // pool costs. Default f16 = unchanged behavior.
+        let kv_both = std::env::var("ENCLAVE_GGML_KV_CACHE_TYPE").unwrap_or_default();
+        let type_k = kv_type_code(
+            &std::env::var("ENCLAVE_GGML_KV_CACHE_TYPE_K").unwrap_or_else(|_| kv_both.clone()),
+        );
+        let type_v = kv_type_code(
+            &std::env::var("ENCLAVE_GGML_KV_CACHE_TYPE_V").unwrap_or_else(|_| kv_both.clone()),
+        );
+        // A quantized V cache is only valid with Flash Attention; if one was
+        // asked for but FA left on auto, force it on so llama.cpp doesn't abort
+        // context creation. Explicit ENCLAVE_GGML_FLASH_ATTN=off is honored
+        // (and will then fail loudly, which is the intended signal).
+        let mut flash_attn =
+            flash_attn_code(&std::env::var("ENCLAVE_GGML_FLASH_ATTN").unwrap_or_default());
+        if matches!(type_v, 1 | 2) && flash_attn == 0 {
+            flash_attn = 2;
+        }
+        // mm32: park slots ride ON TOP of the session cap — the context gets
+        // the extra sequences (a recurrent model allocates their state cells
+        // up front; that is the documented cost of arming the knob), while
+        // tenant-visible session capacity stays exactly ENCLAVE_GGML_MAX_SESSIONS.
+        let total_seqs = n_seq_max + park_slots() as u32 + prefix_slots() as u32;
+        let raw = unsafe {
+            ell_new_server(model.raw, n_ctx, n_batch, total_seqs, type_k, type_v, flash_attn)
+        };
+        if raw.is_null() {
+            return Err(err(
+                "llama.cpp context allocation failed — the n_ctx KV pool does not fit the \
+                 share's free VRAM (lower ENCLAVE_GGML_N_CTX or buy a larger share)",
+            ));
+        }
+        // what depth the context actually got (llama zeroes the request on
+        // archs that cannot roll back recurrent state, so this is the truth
+        // the guest must hear, not the env)
+        let rewind_depth = unsafe { ell_rewind_depth(raw) };
+        // mm26: the K the shim actually armed (0 = ENCLAVE_GGML_DEV_TOPK
+        // unset, or the sampler graph was refused and the shim fell back)
+        let dev_topk = unsafe { ell_server_topk_k(raw) };
+        Ok(Arc::new(GgmlServer {
+            raw,
+            model: model.clone(),
+            n_batch,
+            n_seq_max,
+            total_seqs,
+            parked: Mutex::new(Vec::new()),
+            alias: Mutex::new(HashMap::new()),
+            claims: Mutex::new(PrefixClaims::new(prefix_claim_stale())),
+            n_vocab: model.n_vocab as usize,
+            dev_topk,
+            slots: Mutex::new((0..total_seqs as i32).collect()),
+            q: Mutex::new(DecodeQueue {
+                next_ticket: 0,
+                pending: VecDeque::new(),
+                results: HashMap::new(),
+                decoding: false,
+                stepping: HashMap::new(),
+            }),
+            cv: Condvar::new(),
+            n_ctx,
+            type_k,
+            type_v,
+            flash_attn,
+            rewind_depth,
+            mtp: Mutex::new(None),
+            last_phases: Mutex::new([0; 9]),
+            gperf_total: Mutex::new([0; 8]),
+            mtmd: Mutex::new(None),
+        }))
+    }
+
+    /// Decode `tokens` as the next step of `seq_id` (whose first new token
+    /// sits at position `pos0`) and return the last token's logits row.
+    /// Concurrent callers MERGE: whoever finds the queue idle becomes the
+    /// leader, drains everything that fits one llama batch, runs the single
+    /// FFI decode, posts every item's result, and wakes the rest.
+    ///
+    /// mm30: the leader first holds the batch a few ms for the OTHER
+    /// sequences that are stepping (cohort_wait) and decodes them in seq_id
+    /// order. Before mm30 it merged whatever happened to be queued, so the
+    /// participating set oscillated ({0,1}, {0}, {1}, …) — llama will not
+    /// reuse a graph whose sequence set changed, and ggml-cuda only replays
+    /// a captured CUDA graph while llama keeps reusing one, so EVERY
+    /// concurrent decode fell back to thousands of individual kernel
+    /// launches. Measured on the fleet (27b hybrid, two chats): ~50-90 ms a
+    /// step against ~16 ms for the replayed single-sequence one, i.e. two
+    /// users were slower together than one user alone.
+    fn submit(&self, seq_id: i32, pos0: i32, tokens: Vec<i32>) -> Result<RowOut, String> {
+        if tokens.is_empty() {
+            return Err("empty token batch".into());
+        }
+        if tokens.len() > self.n_batch as usize {
+            return Err(format!(
+                "batch of {} tokens exceeds n_batch {} (chunk your prefill)",
+                tokens.len(),
+                self.n_batch
+            ));
+        }
+        let single = tokens.len() == 1;
+        let ticket = {
+            let mut q = self.q.lock().unwrap();
+            let t = q.next_ticket;
+            q.next_ticket += 1;
+            q.pending.push_back(PendingItem { ticket: t, seq_id, pos0, tokens });
+            if single {
+                // a plain one-token step: this sequence is generating, so it
+                // belongs to the cohort the leader holds the batch for
+                q.stepping.insert(seq_id, Instant::now());
+            }
+            t
+        };
+        // wake a leader sitting in its cohort window. Nothing notified on
+        // submit before mm30, because nobody ever waited for an arrival.
+        self.cv.notify_all();
+        let mut q = self.q.lock().unwrap();
+        loop {
+            if let Some(r) = q.results.remove(&ticket) {
+                return r;
+            }
+            if !q.decoding && !q.pending.is_empty() {
+                // mm30: hold the batch for the rest of the cohort. This
+                // RELEASES the lock, so re-test both conditions afterwards.
+                q = self.cohort_wait(q);
+                if q.decoding || q.pending.is_empty() {
+                    continue;
+                }
+                if let Some(r) = q.results.remove(&ticket) {
+                    return r;
+                }
+                // become the leader: take from the front while it fits the
+                // batch, one item per sequence (positions within one call
+                // are per-item contiguous)
+                let mut items: Vec<PendingItem> = Vec::new();
+                let mut total = 0usize;
+                while let Some(it) = q.pending.front() {
+                    if total + it.tokens.len() > self.n_batch as usize && !items.is_empty() {
+                        break;
+                    }
+                    if items.iter().any(|p| p.seq_id == it.seq_id) {
+                        break;
+                    }
+                    let it = q.pending.pop_front().unwrap();
+                    total += it.tokens.len();
+                    // mm30: keep the batch ASCENDING by seq_id. Recurrent
+                    // cells are pinned at index == seq_id
+                    // (LLAMA_RS_PIN_CELLS), so an ascending batch already
+                    // satisfies the contiguity llama's find_slot packs for:
+                    // it swaps nothing, the recurrent head stays at
+                    // min(seq_ids), and llm_graph_input_rs::can_reuse keeps
+                    // passing. It also makes ubatch.seq_id_unq deterministic
+                    // for llm_graph_params::allow_reuse, which compares it
+                    // element by element.
+                    let at = items.partition_point(|p| p.seq_id < it.seq_id);
+                    items.insert(at, it);
+                }
+                q.decoding = true;
+                drop(q);
+                let results = self.decode_items(&items);
+                {
+                    let mut gperf = [0i64; 8];
+                    unsafe { ell_graph_perf2(self.raw, gperf.as_mut_ptr()); }
+                    let mut tot = self.gperf_total.lock().unwrap();
+                    for (t, g) in tot.iter_mut().zip(gperf.iter()) {
+                        if *g > 0 { *t += *g; }
+                    }
+                }
+                q = self.q.lock().unwrap();
+                for (it, res) in items.into_iter().zip(results) {
+                    q.results.insert(it.ticket, res);
+                }
+                q.decoding = false;
+                self.cv.notify_all();
+                continue; // our own result may be among them
+            }
+            q = self.cv.wait(q).unwrap();
+        }
+    }
+
+    /// Hold a would-be decode leader until every sequence that is currently
+    /// stepping has an item queued, or `ENCLAVE_GGML_COHORT_MS` elapses.
+    /// Returns the lock; the caller MUST re-test `decoding` and `pending`,
+    /// because this releases it while waiting.
+    ///
+    /// Only single-token steps are held. A prefill chunk is a one-off shape
+    /// nobody can join, and holding it would add the window to every
+    /// request's time-to-first-token for nothing.
+    ///
+    /// On timeout the absent sequences are dropped from the cohort rather
+    /// than waited for again: whatever they are doing (a tool call, a
+    /// finished answer, a speculative round that never reaches this queue)
+    /// they are not in lockstep with us, and the ones that are must not pay
+    /// the window on every token to keep discovering it. They rejoin on
+    /// their next submit, at a cost of exactly one rebuilt graph.
+    fn cohort_wait<'a>(
+        &'a self,
+        mut q: std::sync::MutexGuard<'a, DecodeQueue>,
+    ) -> std::sync::MutexGuard<'a, DecodeQueue> {
+        let window = cohort_ms();
+        if window == 0 || q.stepping.len() < 2 {
+            return q; // nothing to wait for: one generator, or switched off
+        }
+        let ttl = cohort_ttl();
+        let deadline = Instant::now() + Duration::from_millis(window);
+        loop {
+            if q.pending.iter().any(|p| p.tokens.len() != 1) {
+                return q; // a prefill is queued - never hold that up
+            }
+            let now = Instant::now();
+            q.stepping.retain(|_, t| now.duration_since(*t) < ttl);
+            let queued: Vec<i32> = q.pending.iter().map(|p| p.seq_id).collect();
+            if q.stepping.keys().all(|s| queued.contains(s)) {
+                return q; // the whole cohort is here
+            }
+            let Some(left) = deadline.checked_duration_since(now) else {
+                q.stepping.retain(|s, _| queued.contains(s));
+                return q;
+            };
+            let (nq, _) = self.cv.wait_timeout(q, left).unwrap();
+            q = nq;
+            if q.decoding {
+                return q; // someone else took the batch while we waited
+            }
+        }
+    }
+
+    /// One merged decode over `items` (results in item order). On a
+    /// pool-full rc 1 with several items, fall back to per-item decodes so
+    /// one over-long request cannot fail its batchmates (llama restores
+    /// state on rc 1, so the retry is sound).
+    fn decode_items(&self, items: &[PendingItem]) -> Vec<Result<RowOut, String>> {
+        match self.decode_raw(items) {
+            Ok(rows) => rows.into_iter().map(Ok).collect(),
+            Err(1) if items.len() > 1 => items
+                .iter()
+                .map(|it| match self.decode_raw(std::slice::from_ref(it)) {
+                    Ok(mut rows) => Ok(rows.pop().expect("one row per item")),
+                    Err(rc) => Err(decode_err(rc)),
+                })
+                .collect(),
+            Err(rc) => items.iter().map(|_| Err(decode_err(rc))).collect(),
+        }
+    }
+
+    /// EXCLUSIVE decode of one sequence with logits for EVERY position (the
+    /// speculative verify step: the target consumes the draft's tokens in one
+    /// pass and hands back each position's distribution). Takes the decode
+    /// turn like a leader, but alone - full-logits rows don't merge with
+    /// last-row batchmates.
+    ///
+    /// `mtp_for`: harvest the pass's per-position MTP hidden rows for that
+    /// sequence's head state, INSIDE the decode turn (a later decode would
+    /// overwrite them). The MTP head context is created on the first such
+    /// call — also inside the turn, because creation enables nextn output on
+    /// the target and must precede the decode being harvested.
+    fn submit_full(
+        &self,
+        seq_id: i32,
+        pos0: i32,
+        tokens: &[i32],
+        mtp_for: Option<i32>,
+    ) -> Result<RowsOut, String> {
+        self.submit_rows(seq_id, pos0, tokens, mtp_for, false)
+    }
+
+    /// Prompt prefill needs all unmasked nextn hidden rows, but only the
+    /// final vocabulary projection. Verification still requests every row.
+    fn submit_rows(
+        &self,
+        seq_id: i32,
+        pos0: i32,
+        tokens: &[i32],
+        mtp_for: Option<i32>,
+        last_only: bool,
+    ) -> Result<RowsOut, String> {
+        if tokens.is_empty() {
+            return Err("empty token batch".into());
+        }
+        if tokens.len() > self.n_batch as usize {
+            return Err(format!(
+                "batch of {} tokens exceeds n_batch {} (chunk your prefill)",
+                tokens.len(),
+                self.n_batch
+            ));
+        }
+        // mm9 phase split: the elapsed_us window on the verify verb carries
+        // ~20ms that no kernel, copy or boundary accounts for. Name the
+        // segment instead of guessing: gate wait / logits alloc (an SNP
+        // guest pays page-acceptance on fresh mappings) / decode / harvest.
+        let ph_t0 = std::time::Instant::now();
+        let mut q = self.q.lock().unwrap();
+        while q.decoding {
+            q = self.cv.wait(q).unwrap();
+        }
+        q.decoding = true;
+        drop(q);
+        let ph_gate = ph_t0.elapsed().as_micros() as i64;
+        self.last_phases.lock().unwrap()[2] = 0; // turn; the arbiter layer times it
+        let mut harvest_err = None;
+        if let Some(ms) = mtp_for {
+            if let Err(e) = self.ensure_mtp() {
+                harvest_err = Some(e);
+            } else {
+                let _ = ms; // harvested after the decode below
+            }
+        }
+        let ph_t1 = std::time::Instant::now();
+        let n_rows = if last_only { 1 } else { tokens.len() };
+        let mut logits = vec![0f32; n_rows * self.n_vocab];
+        let k_cap = self.dev_topk.max(0) as usize;
+        let mut tk_ids = if k_cap > 0 { vec![0i32; n_rows * k_cap] } else { Vec::new() };
+        let mut k_eff = 0usize;
+        let ph_alloc = ph_t1.elapsed().as_micros() as i64;
+        let ph_t2 = std::time::Instant::now();
+        let rc = if harvest_err.is_none() {
+            if last_only {
+                let count = tokens.len() as i32;
+                if k_cap > 0 {
+                    let r = unsafe {
+                        ell_decode_batch_topk(self.raw, self.model.raw, 1,
+                            &seq_id, &count, &pos0, tokens.as_ptr(), self.dev_topk,
+                            tk_ids.as_mut_ptr(), logits.as_mut_ptr())
+                    };
+                    if r > 0 { k_eff = r as usize; 0 } else { r }
+                } else {
+                    unsafe {
+                        ell_decode_batch(self.raw, self.model.raw, 1,
+                            &seq_id, &count, &pos0, tokens.as_ptr(), logits.as_mut_ptr())
+                    }
+                }
+            } else if k_cap > 0 {
+                let r = unsafe {
+                    ell_decode_seq_topk(self.raw, self.model.raw, seq_id, pos0,
+                                        tokens.as_ptr(), tokens.len() as i32,
+                                        self.dev_topk, tk_ids.as_mut_ptr(), logits.as_mut_ptr())
+                };
+                if r > 0 { k_eff = r as usize; 0 } else { r }
+            } else {
+                unsafe {
+                    ell_decode_seq_full(self.raw, self.model.raw, seq_id, pos0,
+                                        tokens.as_ptr(), tokens.len() as i32, logits.as_mut_ptr())
+                }
+            }
+        } else {
+            0
+        };
+        let ph_decode = ph_t2.elapsed().as_micros() as i64;
+        let mut gperf = [0i64; 8];
+        unsafe { ell_graph_perf2(self.raw, gperf.as_mut_ptr()); }
+        {
+            let mut tot = self.gperf_total.lock().unwrap();
+            for (t, g) in tot.iter_mut().zip(gperf.iter()) {
+                if *g > 0 { *t += *g; } // slot_state passes through untouched
+            }
+        }
+        {
+            // ph[2] (arbiter turn wait) was written inside the window ph_t2
+            // opened, so the decode slot subtracts it out; without the
+            // arbiter it stays the 0 reset above and the subtraction is exact.
+            let mut ph = self.last_phases.lock().unwrap();
+            ph[0] = ph_gate;
+            ph[1] = ph_alloc;
+            ph[3] = ph_decode - ph[2];
+            ph[4] = 0;
+            ph[5] = gperf[0];
+            ph[6] = gperf[1];
+            ph[7] = gperf[2];
+            ph[8] = gperf[3];
+        }
+        if rc == 0 && harvest_err.is_none() {
+            if let Some(ms) = mtp_for {
+                let ph_t3 = std::time::Instant::now();
+                let mtp = self.mtp.lock().unwrap();
+                if let Some(h) = mtp.as_ref() {
+                    unsafe { ell_mtp_harvest(h.0, self.raw, ms, tokens.len() as i32) };
+                }
+                self.last_phases.lock().unwrap()[4] = ph_t3.elapsed().as_micros() as i64;
+            }
+        }
+        let mut q = self.q.lock().unwrap();
+        q.decoding = false;
+        self.cv.notify_all();
+        drop(q);
+        if let Some(e) = harvest_err {
+            return Err(e);
+        }
+        if rc != 0 {
+            return Err(decode_err(rc));
+        }
+        if k_eff > 0 {
+            let n = n_rows;
+            let mut ids = Vec::with_capacity(n * k_eff);
+            let mut vals = Vec::with_capacity(n * k_eff);
+            for i in 0..n {
+                ids.extend_from_slice(&tk_ids[i * k_cap..i * k_cap + k_eff]);
+                vals.extend_from_slice(&logits[i * k_cap..i * k_cap + k_eff]);
+            }
+            return Ok(RowsOut::TopK { ids, vals, k: k_eff });
+        }
+        Ok(RowsOut::Dense(logits))
+    }
+
+    /// The fused speculative round (mm25): observe + draft + verify in ONE
+    /// call under ONE decode turn. Today's rewind-commit MTP round pays two
+    /// guest round trips (mtp_draft, then the all-positions verify) and two
+    /// arbiter grants; at k=1 that boundary is ~2-3 ms of a ~28 ms round.
+    /// The host has everything it needs to run the sequence itself: the
+    /// folded observe mirrors the last round's accepted tokens into the
+    /// head, the head drafts (device-sampled when armed), and the trunk
+    /// verifies [pending.., drafts..] with rows harvested for this same
+    /// sequence - which is also the one ORDERING that keeps the deferred
+    /// observe correct (it must land before this pass overwrites the
+    /// harvest rows it pairs with).
+    ///
+    /// The observe runs EXPLICITLY (not folded into the draft) so its
+    /// failure is visible BEFORE the trunk decode overwrites the harvest
+    /// rows: on [mtp_obs_failed] nothing has been decoded and the guest
+    /// recovers exactly like the standalone path (explicit mtp_accept
+    /// against the still-intact rows, then retry without the fold). A
+    /// failed or empty DRAFT is not an error: the verify runs on the
+    /// pending tokens alone and the round degrades to a plain step.
+    ///
+    /// Returns (drafts, flat logits rows, draft_us).
+    fn mtp_round(
+        &self,
+        seq_id: i32,
+        id_last: i32,
+        pos0: i32,
+        k: i32,
+        p_min: f32,
+        obs: Option<(i32, &[i32])>,
+        pending: &[i32],
+        shared_ok: bool,
+    ) -> Result<(Vec<i32>, RowsOut, i64), String> {
+        if pending.is_empty() {
+            return Err("mtp_round needs at least one pending token".into());
+        }
+        if pending.len() + k.max(0) as usize > self.n_batch as usize {
+            return Err(format!(
+                "mtp_round of {} pending + k {} exceeds n_batch {}",
+                pending.len(),
+                k,
+                self.n_batch
+            ));
+        }
+        // mm31: speculate only while this chat has the model to itself.
+        // OPT-IN: refusing a guest that does not know how to downgrade would
+        // turn a slow answer into a failed one, so the round is only refused
+        // when the caller said it can handle it (`shared_ok`). The sequence
+        // is marked either way - it IS generating, and its neighbour needs
+        // to know that whatever this guest does about it.
+        if self.mark_and_share(seq_id) && shared_ok {
+            return Err(SHARED_ERR.into());
+        }
+        let ph_t0 = std::time::Instant::now();
+        let mut q = self.q.lock().unwrap();
+        while q.decoding {
+            q = self.cv.wait(q).unwrap();
+        }
+        q.decoding = true;
+        drop(q);
+        let ph_gate = ph_t0.elapsed().as_micros() as i64;
+        self.last_phases.lock().unwrap()[2] = 0; // turn; the arbiter layer times it
+        let unlock = |slf: &Self| {
+            let mut q = slf.q.lock().unwrap();
+            q.decoding = false;
+            slf.cv.notify_all();
+        };
+        if let Err(e) = self.ensure_mtp() {
+            unlock(self);
+            return Err(e);
+        }
+        // -- observe (visible failure, rows still intact on error)
+        let ph_td = std::time::Instant::now();
+        if let Some((op, ot)) = obs {
+            let mtp = self.mtp.lock().unwrap();
+            let h = mtp.as_ref().unwrap(); // ensure_mtp above
+            let rc = unsafe { ell_mtp_observe(h.0, seq_id, op, ot.as_ptr(), ot.len() as i32) };
+            if rc != 0 {
+                drop(mtp);
+                unlock(self);
+                return Err(format!(
+                    "[mtp_obs_failed] fused observe failed (rc {rc}; harvested rows stale?)"
+                ));
+            }
+        }
+        // -- draft (0..=k tokens; empty is a plain-step round, not an error).
+        //    Drafts continue AFTER the pending tokens: the head already holds
+        //    every committed token (the observe above mirrored this round's),
+        //    and the last pending token is the draft seed exactly as in the
+        //    standalone verb.
+        let mut drafts = vec![0i32; k.max(0) as usize];
+        let n = {
+            let mtp = self.mtp.lock().unwrap();
+            let h = mtp.as_ref().unwrap();
+            unsafe {
+                ell_mtp_draft2(h.0, seq_id, id_last, pos0, k, p_min,
+                               drafts.as_mut_ptr(), 0, std::ptr::null(), 0)
+            }
+        };
+        drafts.truncate(n.max(0) as usize);
+        let ph_draft = ph_td.elapsed().as_micros() as i64;
+        // -- verify [pending.., drafts..] on this sequence, harvest for it
+        let mut ids: Vec<i32> = Vec::with_capacity(pending.len() + drafts.len());
+        ids.extend_from_slice(pending);
+        ids.extend_from_slice(&drafts);
+        let ph_t1 = std::time::Instant::now();
+        let mut logits = vec![0f32; ids.len() * self.n_vocab];
+        let k_cap = self.dev_topk.max(0) as usize;
+        let mut tk_ids = if k_cap > 0 { vec![0i32; ids.len() * k_cap] } else { Vec::new() };
+        let mut k_eff = 0usize;
+        let ph_alloc = ph_t1.elapsed().as_micros() as i64;
+        let ph_t2 = std::time::Instant::now();
+        let rc = if k_cap > 0 {
+            let r = unsafe {
+                ell_decode_seq_topk(self.raw, self.model.raw, seq_id, pos0,
+                                    ids.as_ptr(), ids.len() as i32,
+                                    self.dev_topk, tk_ids.as_mut_ptr(), logits.as_mut_ptr())
+            };
+            if r > 0 { k_eff = r as usize; 0 } else { r }
+        } else {
+            unsafe {
+                ell_decode_seq_full(self.raw, self.model.raw, seq_id, pos0,
+                                    ids.as_ptr(), ids.len() as i32, logits.as_mut_ptr())
+            }
+        };
+        let ph_decode = ph_t2.elapsed().as_micros() as i64;
+        let mut gperf = [0i64; 8];
+        unsafe { ell_graph_perf2(self.raw, gperf.as_mut_ptr()); }
+        {
+            let mut tot = self.gperf_total.lock().unwrap();
+            for (t, g) in tot.iter_mut().zip(gperf.iter()) {
+                if *g > 0 { *t += *g; } // slot_state passes through untouched
+            }
+        }
+        {
+            let mut ph = self.last_phases.lock().unwrap();
+            ph[0] = ph_gate;
+            ph[1] = ph_alloc;
+            ph[3] = ph_decode - ph[2];
+            ph[4] = 0;
+            ph[5] = gperf[0];
+            ph[6] = gperf[1];
+            ph[7] = gperf[2];
+            ph[8] = gperf[3];
+        }
+        if rc == 0 {
+            let ph_t3 = std::time::Instant::now();
+            let mtp = self.mtp.lock().unwrap();
+            if let Some(h) = mtp.as_ref() {
+                unsafe { ell_mtp_harvest(h.0, self.raw, seq_id, ids.len() as i32) };
+            }
+            self.last_phases.lock().unwrap()[4] = ph_t3.elapsed().as_micros() as i64;
+        }
+        unlock(self);
+        if rc != 0 {
+            return Err(decode_err(rc));
+        }
+        if k_eff > 0 {
+            let n = ids.len();
+            let mut tids = Vec::with_capacity(n * k_eff);
+            let mut tvals = Vec::with_capacity(n * k_eff);
+            for i in 0..n {
+                tids.extend_from_slice(&tk_ids[i * k_cap..i * k_cap + k_eff]);
+                tvals.extend_from_slice(&logits[i * k_cap..i * k_cap + k_eff]);
+            }
+            return Ok((drafts, RowsOut::TopK { ids: tids, vals: tvals, k: k_eff }, ph_draft));
+        }
+        Ok((drafts, RowsOut::Dense(logits), ph_draft))
+    }
+
+    /// Create the MTP head context if it does not exist yet. Caller holds the
+    /// decode turn (creation flips the target's nextn-output flag).
+    fn ensure_mtp(&self) -> Result<(), String> {
+        let mut mtp = self.mtp.lock().unwrap();
+        if mtp.is_some() {
+            return Ok(());
+        }
+        if !self.model.mtp {
+            return Err("[mtp_unavailable] this model has no MTP head".into());
+        }
+        let raw = unsafe {
+            // mm32: total_seqs, not n_seq_max — after a park fork the session
+            // continues on a park-range seq id and its mtp verbs must be in
+            // range for the head context too
+            ell_mtp_new(self.model.raw, self.raw, self.n_ctx, self.n_batch,
+                        self.total_seqs, self.type_k, self.type_v, self.flash_attn)
+        };
+        if raw.is_null() {
+            return Err(
+                "[mtp_unavailable] MTP head context creation failed (VRAM, or a \
+                 toolchain predating the MTP shim)"
+                    .to_string(),
+            );
+        }
+        *mtp = Some(MtpHandle(raw));
+        Ok(())
+    }
+
+    /// Encode one image into `seq_id` at `pos0` and return the POSITIONS it
+    /// consumed (M-RoPE numbers an image's positions by its grid, not by its
+    /// token count, so only libmtmd can say). Takes the decode turn
+    /// EXCLUSIVELY: the shim drives llama_decode itself here and, on models
+    /// that want it, flips the causal mask off and back around the image, so
+    /// nothing else may be decoding on this context meanwhile.
+    fn eval_image(&self, seq_id: i32, pos0: i32, bytes: &[u8]) -> Result<i32, String> {
+        if bytes.is_empty() {
+            return Err("empty image".into());
+        }
+        if bytes.len() > u32::MAX as usize {
+            return Err("image too large".into());
+        }
+        let syms = mtmd_syms().ok_or(
+            "[vision_unavailable] this node's llama.cpp toolchain predates the vision \
+             entry points (no libmtmd in the shim)",
+        )?;
+        let mut q = self.q.lock().unwrap();
+        while q.decoding {
+            q = self.cv.wait(q).unwrap();
+        }
+        q.decoding = true;
+        drop(q);
+        let mut n_pos = 0i32;
+        let outcome = match self.ensure_mtmd() {
+            Err(e) => Err(e),
+            Ok(handle) => {
+                let rc = unsafe {
+                    (syms.eval_image)(
+                        handle,
+                        self.raw,
+                        seq_id,
+                        pos0,
+                        bytes.as_ptr(),
+                        bytes.len() as u32,
+                        self.n_batch as i32,
+                        &mut n_pos,
+                    )
+                };
+                match rc {
+                    0 if n_pos > 0 => Ok(n_pos),
+                    0 => Err("the projector consumed no positions for this image".to_string()),
+                    1 => Err(decode_err(1)),
+                    2 => Err("[image_undecodable] not a readable image (png, jpeg, webp, \
+                              gif and bmp are what the encoder reads)"
+                        .to_string()),
+                    3 => Err(
+                        "[image_too_wide] this model decodes images with a non-causal mask, \
+                         which needs the whole image in one physical batch - raise \
+                         ENCLAVE_GGML_N_UBATCH on this node (or send a smaller image)"
+                            .to_string(),
+                    ),
+                    other => Err(format!("image encode failed (rc {other})")),
+                }
+            }
+        };
+        let mut q = self.q.lock().unwrap();
+        q.decoding = false;
+        self.cv.notify_all();
+        drop(q);
+        outcome
+    }
+
+    /// mm33: ONE video file into `seq_id` at `pos0` as sampled frames. Same
+    /// discipline as eval_image (exclusive decode turn, projector loaded
+    /// lazily); returns (positions consumed, frames used).
+    fn eval_video(&self, seq_id: i32, pos0: i32, bytes: &[u8], fps_milli: i32, max_frames: i32)
+        -> Result<(i32, i32), String>
+    {
+        if bytes.is_empty() {
+            return Err("empty video".into());
+        }
+        if bytes.len() > video_max_bytes() || bytes.len() > u32::MAX as usize {
+            return Err(format!(
+                "[video_too_large] this node accepts video files up to {} MiB (ENCLAVE_GGML_VIDEO_MAX_BYTES)",
+                video_max_bytes() >> 20
+            ));
+        }
+        let syms = mtmd_syms().ok_or(
+            "[vision_unavailable] this node's llama.cpp toolchain predates the vision \
+             entry points (no libmtmd in the shim)",
+        )?;
+        let Some(eval_video) = syms.eval_video else {
+            return Err("[video_unavailable] this node's llama.cpp toolchain predates the video \
+                        entry point (ell_mtmd_eval_video)".into());
+        };
+        let dir = CString::new(ffmpeg_dir()).map_err(|_| "bad ENCLAVE_GGML_FFMPEG_DIR".to_string())?;
+        let mut q = self.q.lock().unwrap();
+        while q.decoding {
+            q = self.cv.wait(q).unwrap();
+        }
+        q.decoding = true;
+        drop(q);
+        let (mut n_pos, mut n_frames) = (0i32, 0i32);
+        let outcome = match self.ensure_mtmd() {
+            Err(e) => Err(e),
+            Ok(handle) => {
+                let rc = unsafe {
+                    eval_video(
+                        handle, self.raw, seq_id, pos0,
+                        bytes.as_ptr(), bytes.len() as u32, self.n_batch as i32,
+                        fps_milli, max_frames, video_timestamp_ms(), dir.as_ptr(),
+                        &mut n_pos, &mut n_frames,
+                    )
+                };
+                match rc {
+                    0 if n_pos > 0 && n_frames > 0 => Ok((n_pos, n_frames)),
+                    0 => Err("the projector consumed no positions for this video".to_string()),
+                    1 => Err(decode_err(1)),
+                    2 => Err("[video_undecodable] not a decodable video (ffprobe could not read it), \
+                              or this node has no ffmpeg/ffprobe (ENCLAVE_GGML_FFMPEG_DIR)".to_string()),
+                    3 => Err("[image_too_wide] a frame of this video needs the whole image in one \
+                              physical batch - raise ENCLAVE_GGML_N_UBATCH on this node (or send a \
+                              smaller video)".to_string()),
+                    4 => Err("[video_unavailable] this node's engine was built without video support".to_string()),
+                    other => Err(format!("video encode failed (rc {other})")),
+                }
+            }
+        };
+        let mut q = self.q.lock().unwrap();
+        q.decoding = false;
+        self.cv.notify_all();
+        drop(q);
+        outcome
+    }
+
+    /// Load the vision projector if it is not loaded yet, returning its
+    /// handle. Caller holds the decode turn (the load allocates on the same
+    /// device the decode is about to use).
+    fn ensure_mtmd(&self) -> Result<*mut c_void, String> {
+        let mut m = self.mtmd.lock().unwrap();
+        if let Some(h) = m.as_ref() {
+            return Ok(h.0);
+        }
+        let syms = mtmd_syms().ok_or("[vision_unavailable] no libmtmd in this shim")?;
+        let path = self.model.mmproj.as_ref().ok_or(
+            "[vision_unavailable] this model volume carries no vision projector \
+             (add an *mmproj*.gguf beside the model)",
+        )?;
+        // 4 CPU threads is llama.cpp's own default for the preprocessing side;
+        // the encode itself rides the GPU whenever the model did.
+        let threads = env_i32("ENCLAVE_GGML_MTMD_THREADS", 4);
+        let max_tokens = env_i32("ENCLAVE_GGML_IMAGE_MAX_TOKENS", 0);
+        let raw = unsafe {
+            (syms.new)(
+                self.model.raw,
+                path.as_ptr(),
+                threads,
+                self.model.gpu as i32,
+                max_tokens,
+            )
+        };
+        if raw.is_null() {
+            return Err(
+                "[vision_unavailable] the vision projector failed to load (VRAM, or an \
+                 mmproj that does not match this model)"
+                    .to_string(),
+            );
+        }
+        *m = Some(MtmdHandle(raw));
+        Ok(raw)
+    }
+
+    /// Mirror a round's ACCEPTED tokens into the head's KV (pairs them with
+    /// the harvested hidden rows; the boundary row becomes the next draft
+    /// seed). Head-only work: serializes on the mtp lock, not the decode turn.
+    fn mtp_observe(&self, seq: i32, pos0: i32, tokens: &[i32]) -> Result<(), String> {
+        let mtp = self.mtp.lock().unwrap();
+        let h = mtp.as_ref().ok_or("[mtp_unavailable] no MTP state (harvest first)")?;
+        let rc = unsafe {
+            ell_mtp_observe(h.0, seq, pos0, tokens.as_ptr(), tokens.len() as i32)
+        };
+        if rc != 0 {
+            return Err(format!("mtp observe failed (rc {rc}; harvested rows stale?)"));
+        }
+        Ok(())
+    }
+
+    /// Propose up to k tokens from the head (greedy, confidence-gated).
+    /// `obs` folds the previous round's ACCEPTED tokens into the same head
+    /// session first (mm19: the separate mtp_accept round trip measured
+    /// 9.5-14 ms/round on the fleet, mostly boundary + sync). A failed
+    /// folded observe yields 0 drafts - the round degrades to plain decode
+    /// and the next explicit observe resynchronizes the head.
+    fn mtp_draft(&self, seq: i32, id_last: i32, n_past: i32, k: i32, p_min: f32,
+                 obs: Option<(i32, &[i32])>, shared_ok: bool)
+        -> Result<Vec<i32>, String>
+    {
+        // mm31: same rule (and the same opt-in) as the fused round - a lone
+        // chat drafts, a shared one decodes plain so its steps can merge
+        if self.mark_and_share(seq) && shared_ok {
+            return Err(SHARED_ERR.into());
+        }
+        let mtp = self.mtp.lock().unwrap();
+        let h = mtp.as_ref().ok_or("[mtp_unavailable] no MTP state (prefill with mtp first)")?;
+        let mut out = vec![0i32; k.max(0) as usize];
+        let (op, ot, on) = match obs {
+            Some((p, t)) => (p, t.as_ptr(), t.len() as i32),
+            None => (0, std::ptr::null(), 0),
+        };
+        let n = unsafe {
+            ell_mtp_draft2(h.0, seq, id_last, n_past, k, p_min, out.as_mut_ptr(), op, ot, on)
+        };
+        out.truncate(n.max(0) as usize);
+        Ok(out)
+    }
+
+    /// Forget one sequence's head state (session teardown; slots get reused).
+    fn mtp_reset(&self, seq: i32) {
+        let mtp = self.mtp.lock().unwrap();
+        if let Some(h) = mtp.as_ref() {
+            unsafe { ell_mtp_reset(h.0, seq) };
+        }
+    }
+
+    /// Drop a sequence's tokens from n_keep onward (a speculative round's
+    /// rejected tail). Holding the queue lock excludes decode leaders, the
+    /// same discipline as seq removal in Drop. Err = the memory REFUSED the
+    /// partial removal (recurrent/hybrid models keep no per-token state
+    /// history; nothing was mutated) — the caller must not decode on as-if
+    /// rewound. Branch-verify (`seq_copy`) is the strategy that needs no
+    /// rewind on any architecture.
+    fn rewind(&self, seq_id: i32, n_keep: i32) -> Result<(), String> {
+        let mut q = self.q.lock().unwrap();
+        while q.decoding {
+            q = self.cv.wait(q).unwrap();
+        }
+        let rc = unsafe { ell_seq_rewind(self.raw, seq_id, n_keep) };
+        drop(q);
+        if rc != 0 {
+            return Err(
+                "[rewind_unsupported] this model keeps recurrent state with no per-token \
+                 history; use branch-verify (copy_from) for speculative rounds"
+                    .to_string(),
+            );
+        }
+        Ok(())
+    }
+
+    /// Make dst an exact branch of src (dst's previous contents dropped).
+    /// Attention KV cells are shared; recurrent state is copy-on-write and
+    /// diverges only when dst next decodes — so branching costs nothing
+    /// until used, on every architecture. Same lock discipline as rewind.
+    fn seq_copy(&self, src_seq: i32, dst_seq: i32) {
+        let mut q = self.q.lock().unwrap();
+        while q.decoding {
+            q = self.cv.wait(q).unwrap();
+        }
+        unsafe { ell_seq_copy(self.raw, src_seq, dst_seq) };
+        drop(q);
+    }
+
+    /// The FFI call itself; Err carries the raw llama_decode rc.
+    fn decode_raw(&self, items: &[PendingItem]) -> Result<Vec<RowOut>, i32> {
+        let n = items.len();
+        let seq_ids: Vec<i32> = items.iter().map(|i| i.seq_id).collect();
+        let counts: Vec<i32> = items.iter().map(|i| i.tokens.len() as i32).collect();
+        let positions: Vec<i32> = items.iter().map(|i| i.pos0).collect();
+        let flat: Vec<i32> = items.iter().flat_map(|i| i.tokens.iter().copied()).collect();
+        let mut logits = vec![0f32; n * self.n_vocab];
+        if self.dev_topk > 0 {
+            let k_cap = self.dev_topk as usize;
+            let mut ids = vec![0i32; n * k_cap];
+            let rc = unsafe {
+                ell_decode_batch_topk(
+                    self.raw,
+                    self.model.raw,
+                    n as i32,
+                    seq_ids.as_ptr(),
+                    counts.as_ptr(),
+                    positions.as_ptr(),
+                    flat.as_ptr(),
+                    self.dev_topk,
+                    ids.as_mut_ptr(),
+                    logits.as_mut_ptr(),
+                )
+            };
+            if rc < 0 {
+                return Err(rc);
+            }
+            if rc > 0 {
+                let k = rc as usize;
+                return Ok((0..n)
+                    .map(|i| RowOut::TopK {
+                        ids: ids[i * k_cap..i * k_cap + k].to_vec(),
+                        vals: logits[i * k_cap..i * k_cap + k].to_vec(),
+                    })
+                    .collect());
+            }
+            // rc == 0: sampled path did not engage - full rows in `logits`
+            return Ok(logits
+                .chunks_exact(self.n_vocab)
+                .map(|c| RowOut::Dense(c.to_vec()))
+                .collect());
+        }
+        let rc = unsafe {
+            ell_decode_batch(
+                self.raw,
+                self.model.raw,
+                n as i32,
+                seq_ids.as_ptr(),
+                counts.as_ptr(),
+                positions.as_ptr(),
+                flat.as_ptr(),
+                logits.as_mut_ptr(),
+            )
+        };
+        if rc != 0 {
+            return Err(rc);
+        }
+        Ok(logits.chunks_exact(self.n_vocab).map(|c| RowOut::Dense(c.to_vec())).collect())
+    }
+}
+
+struct GgmlGraph {
+    model: Arc<GgmlModel>,
+    /// the shared server, created on FIRST use (that is when the KV pool
+    /// claims its VRAM) and kept for the graph's lifetime. Creation failure
+    /// is NOT cached — a later request retries (VRAM may have freed).
+    server: Mutex<Option<Arc<GgmlServer>>>,
+}
+unsafe impl Send for GgmlGraph {}
+unsafe impl Sync for GgmlGraph {}
+
+impl BackendGraph for GgmlGraph {
+    fn init_execution_context(&self) -> Result<ExecutionContext, BackendError> {
+        // covers the lazy GgmlServer::new (the KV pool's VRAM claim) too
+        let _wd = WatchdogGuard::compute("an execution-context init");
+        let server = {
+            let mut s = self.server.lock().unwrap();
+            match &*s {
+                Some(srv) => srv.clone(),
+                None => {
+                    let srv = GgmlServer::new(&self.model)?;
+                    *s = Some(srv.clone());
+                    srv
+                }
+            }
+        };
+        // Slot gate: a free seq id or an immediate, marker-tagged refusal.
+        // FAIL FAST, not a blocking wait — a waiter would pin an executor
+        // thread inside a sync host call, and enough waiters starve the
+        // slot holders into a deadlock. Guests turn this into their own
+        // wait-and-retry (llm-chat sleeps on a monotonic-clock pollable).
+        // mm32: the SESSION cap is n_seq_max, not the free-list — parked
+        // prefix forks hold ids out of `slots` without being sessions, so
+        // "how many sessions live" is derived: total - free - parked.
+        // Lock order parked -> slots (park_now and Drop match it).
+        let seq_id = {
+            let parked = server.parked.lock().unwrap();
+            let mut slots = server.slots.lock().unwrap();
+            let active = server.total_seqs as usize - slots.len() - parked.len();
+            if active >= server.n_seq_max as usize {
+                return Err(err(format!(
+                    "[sessions_busy] all {} inference session slot(s) are in use; retry \
+                     shortly (ENCLAVE_GGML_MAX_SESSIONS caps concurrent sequences in the \
+                     shared KV pool)",
+                    server.n_seq_max
+                )));
+            }
+            // active < n_seq_max and parked <= park_slots, so outstanding ids
+            // (active + parked) < total_seqs: a free id always exists here.
+            slots.pop().expect("free-list empty below the session cap")
+        };
+        let ctx: Box<dyn BackendExecutionContext> = Box::new(GgmlExecutionContext {
+            server,
+            seq_id,
+            n_past: 0,
+            pending: None,
+            logits: None,
+            fed: Vec::new(),
+            prompt_done: false,
+            defer: None,
+            no_cache: false,
+            parked_from: None,
+            park_pin: None,
+            last_row: None,
+            plan: None,
+            claim_id: CLAIM_IDS.fetch_add(1, Ordering::Relaxed) + 1,
+        });
+        Ok(ctx.into())
+    }
+}
+
+/// A sequence handle: one chat's stateful cursor into the shared server.
+struct GgmlExecutionContext {
+    server: Arc<GgmlServer>,
+    seq_id: i32,
+    n_past: i32,
+    pending: Option<Vec<i32>>,  // WITX-style set_input staging
+    logits: Option<Tensor>,     // last compute's output for get_output
+    // -- mm32 prefix cache (all inert while ENCLAVE_GGML_PARK_SLOTS=0) --
+    /// every token fed through the WIT "tokens" paths, in order, until the
+    /// prompt completes — the exact stream a park records and a later
+    /// request matches against. Bookkeeping only; rewind truncates it.
+    fed: Vec<i32>,
+    /// latched by the first generation-shaped verb (a 1-token feed, an
+    /// mtp_round/mtp_draft, a verify pass): the prompt is over, park once.
+    prompt_done: bool,
+    /// tokens buffered instead of fed while they still match a parked
+    /// prefix; resolved (branch + tail-feed) or abandoned (fed verbatim) at
+    /// the first divergence, generation verb, or non-token verb.
+    defer: Option<Vec<i32>>,
+    /// guest opt-out ({"prefix_cache": [0]}): never defer this context's
+    /// feeds. The park side stays on — parking is invisible to the guest.
+    no_cache: bool,
+    /// the seq id this session fed its prompt into before donating it as a
+    /// park (the reversed fork). Keeps the alias entry removable at Drop.
+    parked_from: Option<i32>,
+    /// pin held on a park this session's sequence is an un-diverged copy
+    /// of (donated or reused); released by the first decode. The park is
+    /// un-evictable while its count is non-zero.
+    park_pin: Option<Arc<AtomicUsize>>,
+    /// the final prompt position's output row, captured from the last
+    /// multi-token feed so a park can serve an exact-match reuse without
+    /// re-decoding that position (self.logits only holds DENSE outputs; the
+    /// topk-flavored feeds never set it, so the row is kept in RowOut form).
+    last_row: Option<RowOut>,
+    /// mm34: the branch a declared prompt settled on at its first chunk.
+    plan: Option<PromptPlan>,
+    /// mm36: this context's identity in the server's prefix claims (stable
+    /// across the seq_id swaps a park fork makes)
+    claim_id: u64,
+}
+unsafe impl Send for GgmlExecutionContext {}
+unsafe impl Sync for GgmlExecutionContext {}
+impl Drop for GgmlExecutionContext {
+    fn drop(&mut self) {
+        // the decode-turn wait below is unbounded when the turn holder is
+        // wedged, and a hung teardown pins an executor thread and its slot
+        let _wd = WatchdogGuard::compute("a session teardown");
+        // mm36: whatever prefix this context promised to park is off the
+        // table - followers re-plan against the parks and lead from there.
+        // Taken alone, before any other lock (claims is a leaf).
+        self.server.claims.lock().unwrap().release_all(self.claim_id);
+        // seq removal mutates the llama context: wait out any in-flight
+        // batch (bounded — one llama_decode), remove under the queue lock so
+        // no leader starts meanwhile, then free the slot. The slot lock is
+        // held through the idle check below: all slots free means no handle
+        // exists to submit, and init_execution_context can't mint one while
+        // we hold it — the reset can never race a live sequence.
+        let mut q = self.server.q.lock().unwrap();
+        while q.decoding {
+            q = self.server.cv.wait(q).unwrap();
+        }
+        unsafe { ell_seq_remove(self.server.raw, self.seq_id) };
+        // mm30: it is not stepping any more, so nobody should hold a batch
+        // waiting for it. The TTL would notice eventually; doing it here
+        // means the sequences that remain never miss even one window.
+        q.stepping.remove(&self.seq_id);
+        // the MTP head keeps per-seq state (KV + draft seed); slots get
+        // reused by other streams, so forget this one before the slot frees
+        self.server.mtp_reset(self.seq_id);
+        // mm32: the park this session donated (if any) outlives it — that is
+        // the point — but its safety pin and its caps-id alias do not. An
+        // un-diverged copy being removed is fine either direction; only the
+        // park's own removal was direction-sensitive, and the pin has kept
+        // that at bay until here.
+        if let Some(pin) = self.park_pin.take() {
+            pin.fetch_sub(1, Ordering::AcqRel);
+        }
+        if let Some(old) = self.parked_from.take() {
+            self.server.alias.lock().unwrap().remove(&old);
+        }
+        let mut parked = self.server.parked.lock().unwrap();
+        let mut slots = self.server.slots.lock().unwrap();
+        slots.push(self.seq_id);
+        // IDLE RESET: a unified pool FRAGMENTS under churn — used cells
+        // scatter upward and every decode step's attention then spans the
+        // high-water mark, which decayed live decode ~20 -> ~7 tok/s over a
+        // few hours of traffic (2026-07-24; defrag_thold is deprecated at
+        // our llama.cpp pin, nothing heals it). Sessions are transient and
+        // the pool holds NOTHING between them, so the moment the last one
+        // ends, clear the memory outright — fragmentation can only build
+        // within one continuous busy burst, and any quiet moment heals it.
+        //
+        // mm32: parked prefixes ARE held between sessions, so while any park
+        // is fresh the heal must wait (their cells would be wiped). Once
+        // every park has aged past PARK_TTL with no session alive, the parks
+        // stand down and the pool clears — long-idle heals exactly as before
+        // the feature, and a busy burst keeps its parks.
+        if slots.len() + parked.len() == self.server.total_seqs as usize {
+            if parked.is_empty() {
+                unsafe { ell_reset(self.server.raw) };
+            } else if parked.iter().all(|p| {
+                p.at.elapsed() > (if p.boundary { prefix_ttl() } else { park_ttl() })
+                    && p.pin.load(Ordering::Acquire) == 0
+            }) {
+                for p in parked.drain(..) {
+                    unsafe { ell_seq_remove(self.server.raw, p.seq_id) };
+                    slots.push(p.seq_id);
+                }
+                unsafe { ell_reset(self.server.raw) };
+            }
+        }
+        drop(slots);
+        drop(parked);
+        drop(q);
+    }
+}
+
+fn tokens_from_tensor(tensor: &Tensor) -> Result<Vec<i32>, BackendError> {
+    match tensor.ty {
+        TensorType::I32 => {}
+        _ => return Err(BackendError::UnsupportedTensorType(format!("{:?}", tensor.ty))),
+    }
+    if tensor.data.len() % 4 != 0 {
+        return Err(err("token tensor data is not a whole number of i32s"));
+    }
+    Ok(tensor
+        .data
+        .chunks_exact(4)
+        .map(|b| i32::from_le_bytes([b[0], b[1], b[2], b[3]]))
+        .collect())
+}
+
+/// mm32: what one deferred-feed step decided (see defer_step).
+enum DeferAction {
+    /// a park covered a prefix of the buffered stream: this sequence is now
+    /// a branch of it (n_past updated). `remainder` is what still needs
+    /// feeding (at most the current call's tokens); when it is empty the
+    /// stream matched the park exactly and `row` is the stored final-row.
+    Branch { remainder: Vec<i32>, row: Option<RowOut> },
+    /// no park matches any more: feed these buffered tokens instead of the
+    /// call's own (they include it), through the caller's own verb path.
+    Replay(Vec<i32>),
+}
+
+/// mm34: the branch a DECLARED prompt settles on at its first chunk.
+///
+/// A guest that chunks its prefill (every guest on a CPU node must: one
+/// chunk is its unit of liveness, and a proxy cuts a stream silent for 180 s)
+/// sends {"prompt": I32 [1, N]}, the whole prompt's token ids, beside its
+/// first "tokens" feed. The engine then knows what is coming, so it can
+/// decide the whole branch right there: the longest park whose tokens are a
+/// PREFIX of the declared prompt is copied into this sequence, and each later
+/// chunk feeds only what lies past the park. A chunk never costs the guest
+/// more than its own tokens.
+///
+/// mm32 tried to reach the same win without the declaration, by HOLDING each
+/// {"more":1} chunk that still matched a park and replaying the held stream
+/// in one call when it diverged. The divergence of a new chat is its user
+/// message, i.e. the last chunk, so the replay was the whole ~3,000-token
+/// prompt inside ONE host call: ~210 s on a CPU node, no byte out, and the
+/// supervisor's idle cut killed every such turn (9eb4e600 on metal0,
+/// 2026-09-02). The hold is gone; a guest that declares nothing gets plain
+/// chunk-bounded feeds and the single-feed exact/extension branch.
+struct PromptPlan {
+    /// the declared prompt, checked chunk by chunk against what arrives
+    prompt: Vec<i32>,
+    /// prompt[..covered] is already in place from the park copy
+    covered: usize,
+    /// the park's stored final-position row when covered == prompt.len()
+    /// (an exact repeat): the last chunk answers it without a decode
+    exact_row: Option<RowOut>,
+    /// how far the guest's chunk stream has come
+    seen: usize,
+    /// mm35: declared boundaries still ahead (ascending, past `covered`):
+    /// the prefix so far is parked as prefill crosses each one
+    marks: Vec<usize>,
+}
+
+impl GgmlExecutionContext {
+    /// mm32: shadow a fed token stream while the prompt is still open.
+    fn shadow(&mut self, ids: &[i32]) {
+        if !self.prompt_done && park_slots() > 0 {
+            self.fed.extend_from_slice(ids);
+        }
+    }
+
+    /// mm32: the first decode on the continuation copy diverges its
+    /// recurrent state from the donated park's — from here the park stands
+    /// on its own cells and may be evicted like any other.
+    fn mark_diverged(&mut self) {
+        if let Some(pin) = self.park_pin.take() {
+            pin.fetch_sub(1, Ordering::AcqRel);
+        }
+    }
+
+    /// mm32 match-and-branch for a guest that declared no prompt. Called with
+    /// each multi-token feed while the prompt is open; decides whether to
+    /// branch (a park is a prefix of the stream so far), replay this feed
+    /// verbatim (no park fits), or stay out of the way entirely (None: feed
+    /// exactly as before mm32). Nothing is held back across calls any more
+    /// (see PromptPlan for why), so with chunked prefill only a park no
+    /// longer than the FIRST chunk can ever branch here; the whole-prompt
+    /// win needs the declaration.
+    fn defer_step(&mut self, ids: &[i32]) -> Result<Option<DeferAction>, BackendError> {
+        if park_slots() == 0 || self.no_cache || self.prompt_done {
+            return Ok(None);
+        }
+        // only a context's FIRST feeds can match a park (a park is a whole
+        // prompt from position 0); a 1-token opener is generation-shaped
+        if self.defer.is_none() && (self.n_past > 0 || ids.len() < 2) {
+            return Ok(None);
+        }
+        let mut buf = self.defer.take().unwrap_or_default();
+        // fast path: on the very first chunk, engage only if some park
+        // actually relates to it — otherwise this request never defers
+        if buf.is_empty() {
+            let parked = self.server.parked.lock().unwrap();
+            let engages = parked.iter().any(|p| {
+                let n = ids.len().min(p.tokens.len());
+                p.tokens[..n] == ids[..n]
+            });
+            if !engages {
+                return Ok(None);
+            }
+        }
+        buf.extend_from_slice(ids);
+        // Every feed is treated as possibly final and resolved right here:
+        // guests sample their first generation token from the LAST feed's
+        // returned row, and the engine cannot see the end of a chunked prompt
+        // (live 2026-09-01: a held exact-length match handed the app a zero
+        // row to sample from - uniformly random, occasionally EOS). A
+        // single-feed prompt still gets the whole win: an exact repeat
+        // branches with the stored row, an extension branches and feeds only
+        // the tail.
+        // If a park IS a prefix of the stream, branch off the longest such
+        // park and feed only the tail. Re-find by content under the decode turn (lock order
+        // q -> parked, matching Drop) so the copy cannot race an eviction.
+        let mut q = self.server.q.lock().unwrap();
+        while q.decoding {
+            q = self.server.cv.wait(q).unwrap();
+        }
+        let mut parked = self.server.parked.lock().unwrap();
+        let best = parked
+            .iter_mut()
+            .filter(|p| p.tokens.len() >= park_min_tokens() && p.tokens.len() <= buf.len()
+                        && buf[..p.tokens.len()] == p.tokens[..])
+            .max_by_key(|p| p.tokens.len());
+        let action = match best {
+            Some(p) => {
+                unsafe { ell_seq_copy(self.server.raw, p.seq_id, self.seq_id) };
+                p.at = Instant::now(); // reuse refreshes LRU age
+                // this sequence is an un-diverged copy of the park until its
+                // first decode — pin the park so eviction cannot orphan it
+                if self.park_pin.is_none() {
+                    p.pin.fetch_add(1, Ordering::AcqRel);
+                    self.park_pin = Some(p.pin.clone());
+                }
+                let plen = p.tokens.len();
+                let row = if plen == buf.len() { Some(p.row.clone()) } else { None };
+                self.n_past = plen as i32;
+                DeferAction::Branch { remainder: buf[plen..].to_vec(), row }
+            }
+            None => DeferAction::Replay(buf.clone()),
+        };
+        drop(parked);
+        drop(q);
+        // either way the shadow is the full stream so far (a Replay's n_past
+        // stays 0 and the caller feeds the whole buffer; callers never
+        // shadow again on a Some return — defer_step owns the bookkeeping)
+        self.fed = buf;
+        Ok(Some(action))
+    }
+
+    /// mm34: settle the branch for a declared prompt (see PromptPlan). Only a
+    /// context's first feed may declare, and only while the cache is armed and
+    /// not opted out; anything else is ignored, exactly as an engine predating
+    /// the input would ignore it.
+    ///
+    /// mm36: with `wait_ok`, a caller whose still-pending mark another live
+    /// context is already preparing is refused with PREFIX_WARMING_ERR and
+    /// left untouched (no copy, no pin, no plan), so its retry of the same
+    /// chunk is a clean re-plan that branches off the park once it stands.
+    /// Otherwise it leads, claiming its pending marks (see prefix_claims.rs).
+    fn plan_prompt(&mut self, prompt: Vec<i32>, marks: Vec<usize>, wait_ok: bool)
+        -> Result<(), BackendError>
+    {
+        if park_slots() == 0 || self.no_cache || self.prompt_done || self.n_past > 0
+            || self.defer.is_some() || self.plan.is_some() || prompt.len() < 2
+        {
+            return Ok(());
+        }
+        // the boundaries a caller could park or wait on: inside the prompt
+        // and long enough to earn a slot (those a park already covers are
+        // dropped below, once the parks have been read)
+        let mut marks: Vec<usize> = if prefix_slots() == 0 { Vec::new() } else {
+            marks.into_iter()
+                .filter(|&m| m <= prompt.len() && m >= park_min_tokens())
+                .collect()
+        };
+        marks.sort_unstable();
+        marks.dedup();
+        // mm36 fast path for a follower's retry: a leader mid-chunk holds the
+        // decode turn for up to ~45 s on the slowest node, and the turn wait
+        // below would sit inside this host call for all of it. The claims
+        // table alone answers "is somebody preparing my prefix" at once; a
+        // claim that resolves between here and the re-check under the turn
+        // costs one more retry, never a wrong answer.
+        if wait_ok && !marks.is_empty() {
+            let blocking = self.server.claims.lock().unwrap()
+                .blocking(self.claim_id, &prompt, &marks, Instant::now());
+            if let Some((done, total)) = blocking {
+                return Err(prefix_warming(done, total));
+            }
+        }
+        // lock order q -> parked, matching Drop, so the copy cannot race an
+        // eviction
+        let mut q = self.server.q.lock().unwrap();
+        while q.decoding {
+            q = self.server.cv.wait(q).unwrap();
+        }
+        let mut parked = self.server.parked.lock().unwrap();
+        let best = parked
+            .iter_mut()
+            .filter(|p| p.tokens.len() >= park_min_tokens() && p.tokens.len() <= prompt.len()
+                        && prompt[..p.tokens.len()] == p.tokens[..])
+            .max_by_key(|p| p.tokens.len());
+        let covered = best.as_ref().map_or(0, |p| p.tokens.len());
+        // the boundaries still worth parking: past what the branch covers
+        marks.retain(|&m| m > covered);
+        // mm36: settle the claims against the parks just read and BEFORE
+        // this context is touched. claims is a leaf lock: q -> parked ->
+        // claims here, released before the copy below.
+        if !marks.is_empty() {
+            let verdict = self.server.claims.lock().unwrap()
+                .plan(self.claim_id, &prompt, &marks, wait_ok, Instant::now());
+            if let ClaimVerdict::Wait { done, total } = verdict {
+                drop(parked);
+                drop(q);
+                return Err(prefix_warming(done, total));
+            }
+        }
+        let exact_row = match best {
+            Some(p) => {
+                unsafe { ell_seq_copy(self.server.raw, p.seq_id, self.seq_id) };
+                p.at = Instant::now(); // reuse refreshes LRU age
+                // an un-diverged copy of the park until its first decode -
+                // pin the park so eviction cannot orphan it
+                if self.park_pin.is_none() {
+                    p.pin.fetch_add(1, Ordering::AcqRel);
+                    self.park_pin = Some(p.pin.clone());
+                }
+                if p.tokens.len() == prompt.len() { Some(p.row.clone()) } else { None }
+            }
+            None => None,
+        };
+        drop(parked);
+        drop(q);
+        if covered == 0 && marks.is_empty() {
+            return Ok(()); // no park relates and nothing to park: plain feeds
+        }
+        self.n_past = covered as i32;
+        self.fed = prompt[..covered].to_vec();
+        self.plan = Some(PromptPlan { prompt, covered, exact_row, seen: 0, marks });
+        Ok(())
+    }
+
+    /// mm36: the prefill just advanced to n_past - followers waiting on a
+    /// later mark of this plan see it as progress. Taken alone.
+    fn claim_progress(&self) {
+        self.server.claims.lock().unwrap()
+            .progress(self.claim_id, self.n_past.max(0) as usize, Instant::now());
+    }
+
+    /// mm36: this plan crossed `mark` (parked it, or found it unparkable):
+    /// its claim there is settled either way - followers re-plan against
+    /// the parks, which are the truth. Taken alone.
+    fn claim_resolve(&self, mark: usize) {
+        self.server.claims.lock().unwrap().resolve(self.claim_id, mark);
+    }
+
+    /// mm34: one chunk of a declared prompt (see PromptPlan). None = no plan
+    /// stands, feed as before. Some(None) = the chunk lay entirely inside the
+    /// park copy: answer a zero row, which the guest discards (its FINAL chunk
+    /// excepted - an exact repeat answers the park's stored row instead).
+    /// Some(Some(row)) = the part past the park was fed; this is its row.
+    fn plan_step(&mut self, ids: &[i32], mtp: bool) -> Result<Option<Option<RowOut>>, BackendError> {
+        let had_plan = self.plan.is_some();
+        let r = self.plan_step_inner(ids, mtp);
+        // mm36: a plan that ended (served, outgrown, or failed) promises
+        // nothing more - followers re-plan against whatever got parked
+        if had_plan && (r.is_err() || self.plan.is_none()) {
+            self.server.claims.lock().unwrap().release_all(self.claim_id);
+        }
+        r
+    }
+
+    fn plan_step_inner(&mut self, ids: &[i32], mtp: bool) -> Result<Option<Option<RowOut>>, BackendError> {
+        let (tail, last, pos0, marks) = {
+            let Some(plan) = self.plan.as_mut() else { return Ok(None) };
+            if self.prompt_done || plan.seen >= plan.prompt.len() {
+                // the prompt ended (a generation verb), or the guest went past
+                // its declaration: the plan has served
+                self.plan = None;
+                return Ok(None);
+            }
+            let start = plan.seen;
+            let n = ids.len().min(plan.prompt.len() - start);
+            if plan.prompt[start..start + n] != ids[..n] {
+                return Err(err(format!(
+                    "prompt chunk differs from the declared prompt at position {start}"
+                )));
+            }
+            let end = start + ids.len();
+            plan.seen = end;
+            let skip = plan.covered.saturating_sub(start).min(ids.len());
+            if skip == ids.len() {
+                if end == plan.prompt.len() {
+                    let row = plan.exact_row.clone().ok_or_else(|| {
+                        err("declared prompt matched a park exactly but no row was stored")
+                    })?;
+                    self.plan = None;
+                    self.last_row = Some(row.clone());
+                    return Ok(Some(Some(row)));
+                }
+                return Ok(Some(None));
+            }
+            let pos0 = start + skip;
+            // the declared boundaries this chunk crosses, in order
+            let marks: Vec<usize> =
+                plan.marks.iter().copied().filter(|&m| m > pos0 && m <= end).collect();
+            plan.marks.retain(|&m| m > end);
+            (ids[skip..].to_vec(), end >= plan.prompt.len(), pos0, marks)
+        };
+        if last {
+            self.plan = None;
+        }
+        // Feed the tail, parking the prefix as each declared boundary is
+        // crossed (mm35). The shadow stays the exact stream (fed == n_past):
+        // the park copy supplied prompt[..covered], the pieces arrive here.
+        let mut off = 0usize;
+        let mut pos = pos0;
+        let mut row: Option<RowOut> = None;
+        for m in marks {
+            let n = m - pos;
+            if n > 0 {
+                let piece = &tail[off..off + n];
+                self.shadow(piece);
+                let r = if mtp { self.feed_mtp(piece)? } else { self.feed_plain(piece)? };
+                self.last_row = Some(r.clone());
+                row = Some(r);
+                off += n;
+                pos = m;
+            }
+            self.fork_park(true);
+            // mm36: parked or not, the claim on this mark is settled
+            self.claim_resolve(m);
+        }
+        if off < tail.len() {
+            let piece = &tail[off..];
+            self.shadow(piece);
+            row = Some(if mtp { self.feed_mtp(piece)? } else { self.feed_plain(piece)? });
+        }
+        self.claim_progress();
+        let row = row.ok_or_else(|| err("empty token feed"))?;
+        if !self.prompt_done {
+            self.last_row = Some(row.clone());
+        }
+        Ok(Some(Some(row)))
+    }
+
+    /// mm32: a generation-shaped or non-token verb arrived while feeds were
+    /// still deferred — the prompt is over. If the buffered stream exactly
+    /// equals (or outgrew) a park, branch as usual; otherwise feed it
+    /// verbatim (plain decode, rows discarded — the guest already consumed
+    /// zero-rows for those chunks and only ever samples the final ones).
+    fn resolve_defer(&mut self) -> Result<(), BackendError> {
+        let Some(buf) = self.defer.take() else { return Ok(()) };
+        self.fed = buf.clone();
+        // reuse defer_step's branch logic by simulating "stream ended here":
+        // find the longest park that is a prefix of (or equal to) buf
+        let mut q = self.server.q.lock().unwrap();
+        while q.decoding {
+            q = self.server.cv.wait(q).unwrap();
+        }
+        let mut parked = self.server.parked.lock().unwrap();
+        let hit = parked
+            .iter_mut()
+            .filter(|p| p.tokens.len() <= buf.len() && buf[..p.tokens.len()] == p.tokens[..])
+            .max_by_key(|p| p.tokens.len());
+        let (start, row) = match hit {
+            Some(p) => {
+                unsafe { ell_seq_copy(self.server.raw, p.seq_id, self.seq_id) };
+                p.at = Instant::now();
+                if self.park_pin.is_none() {
+                    p.pin.fetch_add(1, Ordering::AcqRel);
+                    self.park_pin = Some(p.pin.clone());
+                }
+                let plen = p.tokens.len();
+                (plen, if plen == buf.len() { Some(p.row.clone()) } else { None })
+            }
+            None => (0, None),
+        };
+        drop(parked);
+        drop(q);
+        self.n_past = start as i32;
+        if let Some(row) = row {
+            self.last_row = Some(row);
+            return Ok(());
+        }
+        // feed the un-covered tail in engine-sized chunks; the last chunk's
+        // row is the final prompt row this context should stand on
+        let nb = self.server.n_batch.max(1) as usize;
+        for chunk in buf[start..].chunks(nb) {
+            let row = self
+                .server
+                .submit(self.seq_id, self.n_past, chunk.to_vec())
+                .map_err(err)?;
+            self.n_past += chunk.len() as i32;
+            self.last_row = Some(row);
+        }
+        self.mark_diverged();
+        Ok(())
+    }
+
+    /// mm32: the prompt just completed (first generation-shaped verb). Park
+    /// this sequence's prompt state via the REVERSED fork: the prompt-fed
+    /// sequence itself becomes the park (it owns its cells — an un-diverged
+    /// copy would not, and removing its source corrupts it on hybrids), and
+    /// the session continues on a fresh copy that diverges with its first
+    /// decode. Skipped whenever the token shadow cannot vouch for the state
+    /// (images, rewinds) or the prompt is too short to earn a slot.
+    fn park_now(&mut self) {
+        if self.prompt_done {
+            return;
+        }
+        self.prompt_done = true;
+        self.fork_park(false);
+        self.fed = Vec::new();
+    }
+
+    /// The REVERSED fork behind every park (mm32 turn parks, mm35 boundary
+    /// parks): the prompt-fed sequence itself becomes the park (it owns its
+    /// cells - an un-diverged copy would not, and removing its source
+    /// corrupts it on hybrids), and the session continues on a fresh copy
+    /// that diverges with its next decode or feed. Skipped whenever the
+    /// token shadow cannot vouch for the state (images, rewinds), the prefix
+    /// is too short to earn a slot, or an identical park already stands
+    /// (refreshed instead). A session may fork more than once - at each
+    /// declared boundary and again at the end of its prompt - and its guest
+    /// keeps addressing it by the id it was first told (`parked_from`, the
+    /// alias root), which follows the live sequence through every fork.
+    fn fork_park(&mut self, boundary: bool) {
+        let cap = if boundary { prefix_slots() } else { park_slots() };
+        if cap == 0 || self.n_past <= 0 {
+            return;
+        }
+        let ok = self.fed.len() == self.n_past as usize && self.fed.len() >= park_min_tokens();
+        let Some(row) = self.last_row.clone() else { return };
+        if !ok {
+            return;
+        }
+        let old = self.seq_id;
+        let mut q = self.server.q.lock().unwrap();
+        while q.decoding {
+            q = self.server.cv.wait(q).unwrap();
+        }
+        let mut parked = self.server.parked.lock().unwrap();
+        // an identical park already standing: refresh it, keep this session
+        // on its own sequence - nothing to fork
+        if let Some(p) = parked.iter_mut().find(|p| p.tokens == self.fed) {
+            p.at = Instant::now();
+            return;
+        }
+        // capacity, per kind: evict the oldest un-pinned park of this kind (a
+        // pinned one still shares recurrent state with an un-diverged copy)
+        if parked.iter().filter(|p| p.boundary == boundary).count() >= cap {
+            let oldest = parked
+                .iter()
+                .enumerate()
+                .filter(|(_, p)| p.boundary == boundary && p.pin.load(Ordering::Acquire) == 0)
+                .min_by_key(|(_, p)| p.at)
+                .map(|(i, _)| i);
+            let Some(i) = oldest else { return };
+            let old_park = parked.remove(i);
+            unsafe { ell_seq_remove(self.server.raw, old_park.seq_id) };
+            // the alias entry (if its donor still lives) dies with the park:
+            // a caps id from before THIS point stops resolving, which is the
+            // documented, deliberately narrow staleness window
+            self.server.alias.lock().unwrap().remove(&old_park.seq_id);
+            self.server.slots.lock().unwrap().push(old_park.seq_id);
+        }
+        let fresh = {
+            let mut slots = self.server.slots.lock().unwrap();
+            match slots.pop() {
+                Some(id) => id,
+                // cannot happen while parks < cap and sessions <= cap, but a
+                // missing fork must never break the session
+                None => return,
+            }
+        };
+        unsafe { ell_seq_copy(self.server.raw, old, fresh) };
+        let pin = Arc::new(AtomicUsize::new(1));
+        parked.push(ParkedPrefix {
+            seq_id: old,
+            // a boundary park is taken mid-prompt: the shadow carries on
+            tokens: self.fed.clone(),
+            row,
+            at: Instant::now(),
+            pin: pin.clone(),
+            boundary,
+        });
+        drop(parked);
+        // the cohort must not wait for the donated sequence, and the MTP
+        // head's per-seq state must not ride along to a future session that
+        // reuses the id - the session's head re-warms under its fresh id
+        // within a few rounds (draft-quality dip, never correctness: verify
+        // re-checks every draft)
+        q.stepping.remove(&old);
+        drop(q);
+        self.server.mtp_reset(old);
+        {
+            let mut alias = self.server.alias.lock().unwrap();
+            alias.insert(old, fresh);
+            if let Some(root) = self.parked_from {
+                alias.insert(root, fresh);
+            }
+        }
+        if self.parked_from.is_none() {
+            self.parked_from = Some(old);
+        }
+        // a pin from an earlier fork was released by the feed that diverged
+        // the copy (mark_diverged); one still held is released here
+        if let Some(prev) = self.park_pin.take() {
+            prev.fetch_sub(1, Ordering::AcqRel);
+        }
+        self.park_pin = Some(pin);
+        self.seq_id = fresh;
+    }
+
+    /// mm32: every generation-shaped verb funnels through here first.
+    fn park_check(&mut self) -> Result<(), BackendError> {
+        if self.prompt_done {
+            return Ok(());
+        }
+        self.resolve_defer()?;
+        self.park_now();
+        Ok(())
+    }
+
+
+    /// mm32: the last position's row out of a submit_full flat result.
+    fn last_of(&self, flat: &RowsOut, n: usize) -> RowOut {
+        match flat {
+            RowsOut::Dense(f) => RowOut::Dense(f[(n - 1) * self.server.n_vocab..].to_vec()),
+            RowsOut::TopK { ids, vals, k } => RowOut::TopK {
+                ids: ids[(n - 1) * k..].to_vec(),
+                vals: vals[(n - 1) * k..].to_vec(),
+            },
+        }
+    }
+
+    /// mm32: feed prompt tokens through the plain path in engine-sized
+    /// chunks and return the final chunk's row.
+    fn feed_plain(&mut self, toks: &[i32]) -> Result<RowOut, BackendError> {
+        let nb = self.server.n_batch.max(1) as usize;
+        let mut last = None;
+        for chunk in toks.chunks(nb) {
+            let row = self
+                .server
+                .submit(self.seq_id, self.n_past, chunk.to_vec())
+                .map_err(err)?;
+            self.n_past += chunk.len() as i32;
+            last = Some(row);
+        }
+        self.mark_diverged();
+        last.ok_or_else(|| err("empty token feed"))
+    }
+
+    /// mm32: the same through the MTP-aware path — the head observes every
+    /// position, exactly as the un-deferred mtp-flagged feed would.
+    fn feed_mtp(&mut self, toks: &[i32]) -> Result<RowOut, BackendError> {
+        let nb = self.server.n_batch.max(1) as usize;
+        let mut last = None;
+        for chunk in toks.chunks(nb) {
+            let pos0 = self.n_past;
+            let flat = self
+                .server
+                .submit_rows(self.seq_id, pos0, chunk, Some(self.seq_id), true)
+                .map_err(err)?;
+            self.server.mtp_observe(self.seq_id, pos0, chunk).map_err(err)?;
+            self.n_past += chunk.len() as i32;
+            last = Some(self.last_of(&flat, 1));
+        }
+        self.mark_diverged();
+        last.ok_or_else(|| err("empty token feed"))
+    }
+
+    /// mm32: render one final-position row the way this call asked for it
+    /// (the same three shapes the un-deferred paths produce).
+    fn render_row(&mut self, row: RowOut, topk: Option<usize>)
+        -> Result<Vec<NamedTensor>, BackendError>
+    {
+        if let Some(kv) = topk {
+            let (ti, tv) = match &row {
+                RowOut::Dense(r) => topk_rows(r, 1, self.server.n_vocab, kv),
+                RowOut::TopK { ids, vals } => topk_tensors(ids, vals, 1, ids.len(), kv),
+            };
+            return Ok(vec![
+                NamedTensor { name: "topk_ids".to_string(), tensor: ti },
+                NamedTensor { name: "topk_logits".to_string(), tensor: tv },
+            ]);
+        }
+        let RowOut::Dense(r) = row else {
+            return Err(err(
+                "this engine is armed for device top-k (nnDevTopk); dense \"logits\" \
+                 output is unavailable - request {\"topk\": K}",
+            ));
+        };
+        let mut data = Vec::with_capacity(r.len() * 4);
+        for v in r {
+            data.extend_from_slice(&v.to_le_bytes());
+        }
+        let t = Tensor {
+            dimensions: vec![1, self.server.model.n_vocab],
+            ty: TensorType::Fp32,
+            data,
+        };
+        self.logits = Some(t.clone());
+        Ok(vec![NamedTensor { name: "logits".to_string(), tensor: t }])
+    }
+
+    /// mm32: the zero-shaped answer a deferred prompt chunk gets. Both
+    /// first-party guests discard every non-final prompt row; a guest that
+    /// does not opts out with {"prefix_cache": [0]}.
+    /// A zero-shaped row for a chunk that decoded nothing (mm34: it lay
+    /// inside the park copy a declared prompt branched off). The guest
+    /// discards every non-final prompt row, so its shape is all that matters.
+    fn hold_output(&self, topk: Option<usize>) -> Vec<NamedTensor> {
+        match topk {
+            Some(kv) => vec![
+                NamedTensor { name: "topk_ids".to_string(), tensor: Tensor {
+                    dimensions: vec![1, kv as u32], ty: TensorType::I32, data: vec![0; kv * 4] } },
+                NamedTensor { name: "topk_logits".to_string(), tensor: Tensor {
+                    dimensions: vec![1, kv as u32], ty: TensorType::Fp32, data: vec![0; kv * 4] } },
+            ],
+            None => vec![NamedTensor { name: "logits".to_string(), tensor: Tensor {
+                dimensions: vec![1, self.server.model.n_vocab],
+                ty: TensorType::Fp32,
+                data: vec![0; self.server.n_vocab * 4],
+            } }],
+        }
+    }
+
+    fn decode(&mut self, tokens: &[i32]) -> Result<Tensor, BackendError> {
+        let row = self
+            .server
+            .submit(self.seq_id, self.n_past, tokens.to_vec())
+            .map_err(err)?;
+        self.mark_diverged();
+        self.n_past += tokens.len() as i32;
+        let RowOut::Dense(row) = row else {
+            // mm26: a dense-logits request on a device-top-k-armed engine -
+            // the full row never left the device. Deployments that arm
+            // nnDevTopk serve guests that always ask for "topk".
+            return Err(err(
+                "this engine is armed for device top-k (nnDevTopk); dense logits output is unavailable - request a topk input",
+            ));
+        };
+        let mut data = Vec::with_capacity(row.len() * 4);
+        for v in row {
+            data.extend_from_slice(&v.to_le_bytes());
+        }
+        Ok(Tensor {
+            dimensions: vec![1, self.server.model.n_vocab],
+            ty: TensorType::Fp32,
+            data,
+        })
+    }
+}
+
+impl BackendExecutionContext for GgmlExecutionContext {
+    fn set_input(&mut self, id: Id, tensor: &Tensor) -> Result<(), BackendError> {
+        match id {
+            Id::Index(0) => {}
+            Id::Name(ref n) if n == "tokens" => {}
+            other => return Err(err(format!("unknown input {other:?} (expected \"tokens\")"))),
+        }
+        self.pending = Some(tokens_from_tensor(tensor)?);
+        Ok(())
+    }
+
+    fn compute(
+        &mut self,
+        inputs: Option<Vec<NamedTensor>>,
+    ) -> Result<Option<Vec<NamedTensor>>, BackendError> {
+        // {"timing": I32 [1] = 1} beside any verb: append "elapsed_us" I32 [1]
+        // (wall time of this whole compute call, lock waits included) to the
+        // outputs - the per-verb decomposition instrument that ended the
+        // speculation round-cost guessing game. Requested per call by the
+        // guest, so it costs nothing when unused.
+        let t_start = std::time::Instant::now();
+        // one guard for the whole verb, decode-turn and lock waits included:
+        // a wait on a wedged holder is the same emergency as being one
+        let _wd = WatchdogGuard::compute("a compute verb");
+        let want_timing = inputs.as_ref().map_or(false, |v| {
+            v.iter().any(|nt| nt.name == "timing"
+                && tokens_from_tensor(&nt.tensor).map(|t| t.first() == Some(&1)).unwrap_or(false))
+        });
+        let out = self.compute_inner(inputs);
+        if want_timing {
+            if let Ok(Some(mut v)) = out {
+                let us = t_start.elapsed().as_micros().min(i32::MAX as u128) as i32;
+                v.push(NamedTensor {
+                    name: "elapsed_us".to_string(),
+                    tensor: Tensor { dimensions: vec![1], ty: TensorType::I32, data: us.to_le_bytes().to_vec() },
+                });
+                return Ok(Some(v));
+            } else {
+                return out;
+            }
+        }
+        out
+    }
+
+    fn get_output(&mut self, id: Id) -> Result<Tensor, BackendError> {
+        match id {
+            Id::Index(0) => {}
+            Id::Name(ref n) if n == "logits" => {}
+            other => return Err(err(format!("unknown output {other:?} (expected \"logits\")"))),
+        }
+        self.logits
+            .clone()
+            .ok_or_else(|| err("no logits available (has `compute` been called?)"))
+    }
+}
+
+impl GgmlExecutionContext {
+    fn compute_inner(
+        &mut self,
+        inputs: Option<Vec<NamedTensor>>,
+    ) -> Result<Option<Vec<NamedTensor>>, BackendError> {
+        match inputs {
+            // WIT path: named tensors in, named tensors out
+            Some(inputs) => {
+                // control verb {"caps": I32 [1]} (value ignored): this
+                // sequence handle's identity and its model's capabilities,
+                // for speculative callers - "caps" I32 [seq_id, recurrent,
+                // ...]. seq_id names this handle as a copy_from source;
+                // recurrent 1 = partial rewind is impossible on this model
+                // (branch-verify is the only speculative strategy) UNLESS
+                // the trailing rewind_depth element is > 0 (recurrent
+                // snapshots; see the "rewind" verb below).
+                // {"tokenize": U8 [n]} = UTF-8 text -> "ids" I32 [m]: the
+                // GGUF's own tokenizer, host-side (parse_special on, so
+                // template markers map to their special ids). Pure vocab
+                // lookup - no decode turn, safe concurrently. Saves guests
+                // the multi-MB tokenizer.json parse every fresh instance
+                // paid (~535ms of TTFT measured 2026-08-01).
+                // {"d2h_probe": I32 [size_mb]} -> "d2h" I32 [pinned_ok,
+                // pinned_us, pageable_us]: times a device->host copy of
+                // size_mb into pinned (if the device host buffer type
+                // allocates) and plain pageable memory. The CVM-side
+                // measurement behind the 2026-08-02 multi-token-pass
+                // post-mortem: llama's logits buffer wants pinned memory
+                // but ggml-cuda silently demotes to pageable when
+                // cudaMallocHost fails, and only this number says which
+                // path this enclave actually runs. Read-only wrt sessions,
+                // safe concurrently.
+                if let Some(pv) = inputs.iter().find(|nt| nt.name == "d2h_probe") {
+                    let size_mb = pv.tensor.data.get(0..4)
+                        .map(|b| i32::from_le_bytes([b[0], b[1], b[2], b[3]]))
+                        .unwrap_or(4);
+                    let mut out = [0i64; 3];
+                    let rc = unsafe { ell_d2h_probe(size_mb, out.as_mut_ptr()) };
+                    if rc != 0 {
+                        return Err(err("d2h probe failed (no GPU device or allocation failure)"));
+                    }
+                    let vals: Vec<i32> = out.iter().map(|&v| v.clamp(i32::MIN as i64, i32::MAX as i64) as i32).collect();
+                    let mut data = Vec::with_capacity(12);
+                    for v in &vals {
+                        data.extend_from_slice(&v.to_le_bytes());
+                    }
+                    return Ok(Some(vec![NamedTensor {
+                        name: "d2h".to_string(),
+                        tensor: Tensor { dimensions: vec![3], ty: TensorType::I32, data },
+                    }]));
+                }
+                if let Some(tv) = inputs.iter().find(|nt| nt.name == "tokenize") {
+                    let text = tv.tensor.data.clone();
+                    let mut cap = text.len() as i32 + 64;
+                    loop {
+                        let mut ids = vec![0i32; cap as usize];
+                        let n = unsafe {
+                            ell_tokenize(self.server.model.raw, text.as_ptr() as *const i8,
+                                         text.len() as i32, ids.as_mut_ptr(), cap)
+                        };
+                        if n == i32::MIN {
+                            return Err(err("host tokenizer failed on this text"));
+                        }
+                        if n < 0 {
+                            cap = -n;
+                            continue;
+                        }
+                        ids.truncate(n as usize);
+                        let mut data = Vec::with_capacity(ids.len() * 4);
+                        for t in &ids {
+                            data.extend_from_slice(&t.to_le_bytes());
+                        }
+                        return Ok(Some(vec![NamedTensor {
+                            name: "ids".to_string(),
+                            tensor: Tensor { dimensions: vec![ids.len() as u32], ty: TensorType::I32, data },
+                        }]));
+                    }
+                }
+                // {"vocab_pieces": I32 [1] = 1} -> the WHOLE vocabulary's raw
+                // byte pieces: "bytes" U8 [total] + "offsets" I32 [n_vocab+1]
+                // (prefix offsets; piece i = bytes[offsets[i]..offsets[i+1]]).
+                // One ~2-3MB copy per session replaces the guest-side
+                // tokenizer for DECODING entirely (detok = table lookup).
+                if inputs.iter().any(|nt| nt.name == "vocab_pieces") {
+                    let n_vocab = self.server.n_vocab as i32;
+                    let mut bytes: Vec<u8> = Vec::with_capacity(n_vocab as usize * 7);
+                    let mut offsets: Vec<u8> = Vec::with_capacity((n_vocab as usize + 1) * 4);
+                    offsets.extend_from_slice(&0i32.to_le_bytes());
+                    let mut buf = vec![0i8; 256];
+                    for id in 0..n_vocab {
+                        let mut n = unsafe {
+                            ell_token_piece(self.server.model.raw, id, buf.as_mut_ptr(), buf.len() as i32)
+                        };
+                        if n < 0 && -n as usize > buf.len() {
+                            buf.resize(-n as usize, 0);
+                            n = unsafe {
+                                ell_token_piece(self.server.model.raw, id, buf.as_mut_ptr(), buf.len() as i32)
+                            };
+                        }
+                        if n > 0 {
+                            let b: &[u8] = unsafe {
+                                std::slice::from_raw_parts(buf.as_ptr() as *const u8, n as usize)
+                            };
+                            bytes.extend_from_slice(b);
+                        }
+                        offsets.extend_from_slice(&(bytes.len() as i32).to_le_bytes());
+                    }
+                    return Ok(Some(vec![
+                        NamedTensor {
+                            name: "bytes".to_string(),
+                            tensor: Tensor { dimensions: vec![bytes.len() as u32], ty: TensorType::U8, data: bytes },
+                        },
+                        NamedTensor {
+                            name: "offsets".to_string(),
+                            tensor: Tensor { dimensions: vec![n_vocab as u32 + 1], ty: TensorType::I32, data: offsets },
+                        },
+                    ]));
+                }
+                // probe verb {"gperf": I32 [1]} (value ignored): cumulative
+                // llama decode-stage micros for this server as "gperf"
+                // I32 [8] in MILLIseconds [build, alloc, input, slot,
+                // mem-init, compute-call, output, out-get]. Monotonic;
+                // guests report per-generation deltas (mm21/22).
+                if inputs.iter().any(|nt| nt.name == "gperf") {
+                    let tot = *self.server.gperf_total.lock().unwrap();
+                    let mut data = Vec::with_capacity(8 * 4);
+                    for v in tot {
+                        data.extend_from_slice(&(((v / 1000) & 0x7fff_ffff) as i32).to_le_bytes());
+                    }
+                    let t = Tensor { dimensions: vec![8], ty: TensorType::I32, data };
+                    return Ok(Some(vec![NamedTensor { name: "gperf".to_string(), tensor: t }]));
+                }
+                // mm32 control input {"prefix_cache": I32 [1] = 0}: opt this
+                // context out of match-and-defer (a guest that samples
+                // non-final prompt rows must send it before its first feed).
+                // Parking stays on - it is invisible to the guest. Standalone
+                // or beside a feed; standalone returns no outputs.
+                if let Some(pc) = inputs.iter().find(|nt| nt.name == "prefix_cache") {
+                    if tokens_from_tensor(&pc.tensor)?.first() == Some(&0) {
+                        self.no_cache = true;
+                        self.resolve_defer()?;
+                    }
+                    if !inputs.iter().any(|nt| nt.name == "tokens" || nt.name == "0") {
+                        return Ok(Some(vec![]));
+                    }
+                }
+                if inputs.iter().any(|nt| nt.name == "caps") {
+                    // mm20 sync-instr: cumulative CUDA stream-sync time and
+                    // call count since process start (the per-decode
+                    // fixed-cost investigation). -1/-1 = the loaded engine
+                    // module predates the instrument (or no GPU module).
+                    let mut sync = [0i64; 2];
+                    if unsafe { ell_cuda_sync_stats(sync.as_mut_ptr()) } != 0 {
+                        sync = [-1, -1];
+                    }
+                    // mm36: read one at a time (claims and parked are never
+                    // nested), before the row is assembled
+                    let warming = self.server.claims.lock().unwrap().active(Instant::now()) as i32;
+                    let parks = self.server.parked.lock().unwrap().len() as i32;
+                    let vals = [
+                        self.seq_id,
+                        self.server.model.recurrent as i32,
+                        self.server.model.mtp as i32,
+                        self.server.model.vision as i32,
+                        // the host's real batch cap: guests size their prefill
+                        // chunks to it instead of hardcoding the historical 128
+                        // (an ENCLAVE_GGML_N_BATCH re-save then delivers
+                        // fewer, bigger prefill passes with no app change)
+                        self.server.n_batch as i32,
+                        // host tokenizer available ("tokenize"/"vocab_pieces")
+                        1,
+                        // recurrent-snapshot rewind depth: > 0 means "rewind"
+                        // works on this model for up to that many trailing
+                        // tokens of the last decode, EVEN when recurrent=1 -
+                        // a speculative guest should then verify on its real
+                        // sequence and rewind the rejected tail (stable seq
+                        // and shape keep the engine's graph caches hot)
+                        // instead of branch-verify. 0 = the historical
+                        // contract (branch via copy_from).
+                        self.server.rewind_depth,
+                        // mtp observe-fold: "mtp_draft" accepts a companion
+                        // "mtp_obs" input (mm19+), saving the mtp_accept
+                        // round trip each round
+                        1,
+                        // cumulative CUDA sync ms (wraps ~24 days) + calls;
+                        // guests report per-generation DELTAS (mm20)
+                        if sync[0] >= 0 { (sync[0] / 1000) as i32 } else { -1 },
+                        if sync[1] >= 0 { (sync[1] & 0x7fff_ffff) as i32 } else { -1 },
+                        // fused speculative round: "mtp_round" runs
+                        // observe + draft + verify in one call (mm25)
+                        1,
+                        // device top-k: the K this engine is armed with
+                        // (mm26, nnDevTopk); 0 = host-side topk_rows
+                        self.server.dev_topk,
+                        // mm31: another sequence is generating right now, so
+                        // the MTP verbs would refuse (SHARED_ERR). A guest
+                        // that reads this opens PLAIN instead of opening a
+                        // speculative rig and downgrading one round later.
+                        // Advisory only - the refusal is the authority, and
+                        // it is re-evaluated every round.
+                        self.server.shared_with(self.seq_id) as i32,
+                        // mm32: prefix-cache park slots armed on this node
+                        // (0 = off). When armed, non-final prompt-chunk rows
+                        // may come back zeroed; {"prefix_cache": [0]} opts a
+                        // context out of that deferral.
+                        park_slots() as i32,
+                        // mm33: the "video" verb exists on this engine (the
+                        // shim carries ell_mtmd_eval_video); whether the node
+                        // also has ffmpeg is the verb's own error to report
+                        mtmd_syms().map_or(0, |s| s.eval_video.is_some() as i32),
+                        // mm35: boundary-park slots armed (0 = off): a guest
+                        // may send "marks" beside its "prompt" declaration
+                        prefix_slots() as i32,
+                        // mm36: shared prefix warming protocol (1 = the
+                        // "prefix_wait" opt-in and the [prefix_warming]
+                        // refusal exist), live claims (someone is preparing
+                        // a prefix right now), standing parks. A guest reads
+                        // the last two as proof the model serves under this
+                        // share and skips its own probe feed.
+                        1,
+                        warming,
+                        parks,
+                    ];
+                    let mut data = Vec::with_capacity(vals.len() * 4);
+                    for v in vals {
+                        data.extend_from_slice(&v.to_le_bytes());
+                    }
+                    let t = Tensor {
+                        dimensions: vec![vals.len() as u32],
+                        ty: TensorType::I32,
+                        data,
+                    };
+                    return Ok(Some(vec![NamedTensor { name: "caps".to_string(), tensor: t }]));
+                }
+                // {"image": U8 [n]} = one image FILE (png/jpeg/webp/gif/bmp
+                // bytes, exactly as uploaded): encode it into this sequence at
+                // the current position and answer "image_pos" I32 [1] with the
+                // positions it consumed. No logits - an image is never the end
+                // of a prompt, the text turn that follows produces the row the
+                // guest samples from. Interleaving is therefore just: feed the
+                // text before the picture as "tokens", feed the picture, feed
+                // the text after it. Everything model-specific (the marker
+                // tokens around the image, the mask, M-RoPE's 2-D positions)
+                // happens inside libmtmd, which is why the guest sends raw file
+                // bytes and does no vision work of its own.
+                if let Some(img) = inputs.iter().find(|nt| nt.name == "image") {
+                    // mm32: buffered prompt tokens must land before the image
+                    // does, or its positions would be wrong. (A prompt with
+                    // images also never parks: the token shadow cannot vouch
+                    // for state that includes encoded pictures.)
+                    self.resolve_defer()?;
+                    if img.tensor.ty != TensorType::U8 {
+                        return Err(err(format!(
+                            "\"image\" must be a U8 tensor of file bytes (got {:?})",
+                            img.tensor.ty
+                        )));
+                    }
+                    let n_pos = self
+                        .server
+                        .eval_image(self.seq_id, self.n_past, &img.tensor.data)
+                        .map_err(err)?;
+                    self.n_past += n_pos;
+                    let t = Tensor {
+                        dimensions: vec![1],
+                        ty: TensorType::I32,
+                        data: n_pos.to_le_bytes().to_vec(),
+                    };
+                    return Ok(Some(vec![NamedTensor {
+                        name: "image_pos".to_string(),
+                        tensor: t,
+                    }]));
+                }
+                // mm33 {"video": U8 [n]} = one video FILE's bytes (whatever
+                // ffmpeg reads: mp4/webm/mov/mkv/avi/gif...), sampled into
+                // this sequence at the current position as frames, answering
+                // "video_pos" I32 [1] (positions consumed) and "video_frames"
+                // I32 [1] (frames used). Optional {"video_fps_milli": I32 [1]}
+                // and {"video_max_frames": I32 [1]} tune the sampling, both
+                // clamped to the node's ceilings. Like "image": never the end
+                // of a prompt, the text turn that follows produces the row.
+                if let Some(vid) = inputs.iter().find(|nt| nt.name == "video") {
+                    self.resolve_defer()?;
+                    if vid.tensor.ty != TensorType::U8 {
+                        return Err(err(format!(
+                            "\"video\" must be a U8 tensor of file bytes (got {:?})",
+                            vid.tensor.ty
+                        )));
+                    }
+                    let opt = |name: &str| -> Option<i32> {
+                        inputs.iter().find(|nt| nt.name == name)
+                            .and_then(|nt| tokens_from_tensor(&nt.tensor).ok())
+                            .and_then(|v| v.first().copied())
+                    };
+                    let fps = opt("video_fps_milli").filter(|v| *v > 0).unwrap_or_else(video_fps_milli).clamp(100, 30_000);
+                    let frames = opt("video_max_frames").filter(|v| *v > 0).unwrap_or_else(video_max_frames).min(video_max_frames());
+                    let (n_pos, n_frames) = self
+                        .server
+                        .eval_video(self.seq_id, self.n_past, &vid.tensor.data, fps, frames)
+                        .map_err(err)?;
+                    self.n_past += n_pos;
+                    return Ok(Some(vec![
+                        NamedTensor { name: "video_pos".to_string(), tensor: Tensor {
+                            dimensions: vec![1], ty: TensorType::I32, data: n_pos.to_le_bytes().to_vec() } },
+                        NamedTensor { name: "video_frames".to_string(), tensor: Tensor {
+                            dimensions: vec![1], ty: TensorType::I32, data: n_frames.to_le_bytes().to_vec() } },
+                    ]));
+                }
+                // control verb {"copy_from": I32 [2] = [src_seq, src_n_past]}:
+                // make THIS sequence an exact branch of src_seq (previous
+                // contents dropped; recurrent state copy-on-write). src_seq
+                // comes from the source handle's "caps" probe; src_n_past is
+                // the caller's token count for it (positions are the guest's
+                // own bookkeeping - a wrong count only breaks its own
+                // stream). The speculative pattern: branch the target, verify
+                // draft tokens on the branch, then adopt the branch back on
+                // full accept or re-feed only the accepted tokens on the
+                // real sequence - no rewind on any architecture.
+                if let Some(cp) = inputs.iter().find(|nt| nt.name == "copy_from") {
+                    // mm32: a branch target's feeds are verify content, not a
+                    // prompt - drop any deferral (the copy overwrites this
+                    // sequence wholesale) and never park it. A source id from
+                    // a pre-fork caps probe resolves to the donor's live
+                    // sequence through the alias map.
+                    self.defer = None;
+                    self.fed = Vec::new();
+                    self.prompt_done = true;
+                    self.mark_diverged();
+                    let v = tokens_from_tensor(&cp.tensor)?;
+                    let (src, src_n_past) = match v.as_slice() {
+                        [s, n] => (*s, *n),
+                        _ => return Err(err("copy_from needs [src_seq, src_n_past]")),
+                    };
+                    let src = self.server.alias.lock().unwrap().get(&src).copied().unwrap_or(src);
+                    if src < 0 || src >= self.server.total_seqs as i32 || src == self.seq_id {
+                        return Err(err(format!(
+                            "copy_from src {src} outside this graph's sequences"
+                        )));
+                    }
+                    if src_n_past < 0 {
+                        return Err(err("copy_from src_n_past must be >= 0"));
+                    }
+                    self.server.seq_copy(src, self.seq_id);
+                    self.n_past = src_n_past;
+                    return Ok(Some(vec![]));
+                }
+                // control verb {"rewind": I32 [1]}: drop this sequence's
+                // tokens from the given position on (a speculative round's
+                // rejected tail) - no decode, no outputs. Errors (nothing
+                // mutated) on recurrent/hybrid models, which keep no
+                // per-token state history - branch via copy_from instead.
+                // EXCEPTION: caps' rewind_depth > 0 means the context keeps
+                // that many per-token recurrent snapshots, and a rewind of
+                // up to that many trailing tokens of the LAST decode
+                // succeeds even here.
+                if let Some(rw) = inputs.iter().find(|nt| nt.name == "rewind") {
+                    // mm32: rewind is generation-shaped - the prompt is over
+                    self.park_check()?;
+                    let v = tokens_from_tensor(&rw.tensor)?;
+                    let n_keep = *v.first().ok_or_else(|| err("rewind needs one i32"))?;
+                    if n_keep < 0 || n_keep > self.n_past {
+                        return Err(err(format!("rewind to {n_keep} outside 0..={}", self.n_past)));
+                    }
+                    self.server.rewind(self.seq_id, n_keep).map_err(err)?;
+                    self.n_past = n_keep;
+                    return Ok(Some(vec![]));
+                }
+                // control verb {"mtp_round": I32 [3] = [id_last, k, p_min_milli]}
+                // beside {"tokens": [pending...]} and {"topk": [K]} (mm25,
+                // caps[10]): the WHOLE speculative round in one call - the
+                // optional {"mtp_obs"} observe, the head's k-draft chain, and
+                // the all-positions verify of [pending.., drafts..] with rows
+                // harvested for THIS sequence (rewind-commit mode only).
+                // Outputs "draft" I32 [m] + "topk_ids"/"topk_logits" over
+                // pending+m rows + "phase_us" I32 [11] ([..10] as the verify
+                // verb, [10] = the draft chain). One boundary crossing and
+                // one arbiter grant instead of two - at k=1 that is ~2-3 ms
+                // of a ~28 ms round. [mtp_obs_failed] = the folded observe
+                // failed BEFORE any decode: recover exactly like the
+                // standalone path (explicit mtp_accept, then retry unfolded).
+                if let Some(mr) = inputs.iter().find(|nt| nt.name == "mtp_round") {
+                    // mm32: first generation verb - resolve any deferred
+                    // prompt and park it before the round decodes
+                    self.park_check()?;
+                    let v = tokens_from_tensor(&mr.tensor)?;
+                    let (id_last, k, pmm) = match v.as_slice() {
+                        [i, k, p] => (*i, *k, *p),
+                        _ => return Err(err("mtp_round needs [id_last, k, p_min_milli]")),
+                    };
+                    let k = k.clamp(1, 16);
+                    let p_min = (pmm.clamp(0, 1000) as f32) / 1000.0;
+                    let obs_v;
+                    let obs = match inputs.iter().find(|nt| nt.name == "mtp_obs") {
+                        Some(mo) => {
+                            obs_v = tokens_from_tensor(&mo.tensor)?;
+                            match obs_v.split_first() {
+                                Some((p, rest)) if !rest.is_empty() && *p >= 0 => {
+                                    Some((*p, rest))
+                                }
+                                _ => return Err(err("mtp_obs needs [pos0>=0, tokens...]")),
+                            }
+                        }
+                        None => None,
+                    };
+                    let pending = inputs
+                        .iter()
+                        .find(|nt| nt.name == "tokens")
+                        .ok_or_else(|| err("mtp_round needs a \"tokens\" input"))?;
+                    let pending = tokens_from_tensor(&pending.tensor)?;
+                    let kv = inputs
+                        .iter()
+                        .find(|nt| nt.name == "topk")
+                        .map(|nt| tokens_from_tensor(&nt.tensor))
+                        .transpose()?
+                        .and_then(|v| v.first().copied())
+                        .map(|kv| kv.clamp(16, 1024) as usize)
+                        .ok_or_else(|| err("mtp_round needs a \"topk\" input"))?;
+                    let (drafts, flat, draft_us) = self
+                        .server
+                        .mtp_round(self.seq_id, id_last, self.n_past, k, p_min, obs, &pending,
+                                   shared_ok(&inputs))
+                        .map_err(err)?;
+                    self.mark_diverged();
+                    let n_rows = pending.len() + drafts.len();
+                    self.n_past += n_rows as i32;
+                    let ph = *self.server.last_phases.lock().unwrap();
+                    let ph_t4 = std::time::Instant::now();
+                    let (ti, tv) = match &flat {
+                        RowsOut::Dense(flat) => topk_rows(flat, n_rows, self.server.n_vocab, kv),
+                        RowsOut::TopK { ids, vals, k } => topk_tensors(ids, vals, n_rows, *k, kv),
+                    };
+                    let ph_topk = ph_t4.elapsed().as_micros() as i64;
+                    let mut pdata = Vec::with_capacity(44);
+                    for v in [ph[0], ph[1], ph[2], ph[3], ph[4], ph_topk,
+                              ph[5], ph[6], ph[7], ph[8], draft_us] {
+                        pdata.extend_from_slice(&(v.clamp(0, i32::MAX as i64) as i32).to_le_bytes());
+                    }
+                    let mut ddata = Vec::with_capacity(drafts.len() * 4);
+                    for t in &drafts {
+                        ddata.extend_from_slice(&t.to_le_bytes());
+                    }
+                    return Ok(Some(vec![
+                        NamedTensor {
+                            name: "draft".to_string(),
+                            tensor: Tensor {
+                                dimensions: vec![drafts.len() as u32],
+                                ty: TensorType::I32,
+                                data: ddata,
+                            },
+                        },
+                        NamedTensor { name: "topk_ids".to_string(), tensor: ti },
+                        NamedTensor { name: "topk_logits".to_string(), tensor: tv },
+                        NamedTensor { name: "phase_us".to_string(),
+                                      tensor: Tensor { dimensions: vec![11], ty: TensorType::I32, data: pdata } },
+                    ]));
+                }
+                // control verb {"mtp_draft": I32 [3] = [id_last, k, p_min_milli]}:
+                // the model's own MTP head proposes up to k tokens continuing
+                // this sequence (greedy, stops below p_min confidence) -
+                // output "draft" I32 [n], possibly empty. Near-zero cost: the
+                // head is one layer riding state harvested from prior passes.
+                // Optional companion {"mtp_obs": I32 [1+n] = [pos0, tokens...]}
+                // (mm19, caps[7]): the previous round's accepted tokens are
+                // observed into the head IN THE SAME CALL - what mtp_accept
+                // does, minus its round trip. Rows must still come from the
+                // last mtp-flagged pass, exactly as with mtp_accept.
+                if let Some(md) = inputs.iter().find(|nt| nt.name == "mtp_draft") {
+                    self.park_check()?;
+                    let v = tokens_from_tensor(&md.tensor)?;
+                    let (id_last, k, pmm) = match v.as_slice() {
+                        [i, k, p] => (*i, *k, *p),
+                        _ => return Err(err("mtp_draft needs [id_last, k, p_min_milli]")),
+                    };
+                    let k = k.clamp(1, 16);
+                    let p_min = (pmm.clamp(0, 1000) as f32) / 1000.0;
+                    let obs_v;
+                    let obs = match inputs.iter().find(|nt| nt.name == "mtp_obs") {
+                        Some(mo) => {
+                            obs_v = tokens_from_tensor(&mo.tensor)?;
+                            match obs_v.split_first() {
+                                Some((p, rest)) if !rest.is_empty() && *p >= 0 => {
+                                    Some((*p, rest))
+                                }
+                                _ => return Err(err("mtp_obs needs [pos0>=0, tokens...]")),
+                            }
+                        }
+                        None => None,
+                    };
+                    let toks = self
+                        .server
+                        .mtp_draft(self.seq_id, id_last, self.n_past, k, p_min, obs,
+                                   shared_ok(&inputs))
+                        .map_err(err)?;
+                    let mut data = Vec::with_capacity(toks.len() * 4);
+                    for t in &toks {
+                        data.extend_from_slice(&t.to_le_bytes());
+                    }
+                    let t = Tensor {
+                        dimensions: vec![toks.len() as u32],
+                        ty: TensorType::I32,
+                        data,
+                    };
+                    return Ok(Some(vec![NamedTensor { name: "draft".to_string(), tensor: t }]));
+                }
+                // control verb {"mtp_accept": I32 [1+n] = [pos0, tokens...]}:
+                // mirror a verify round's ACCEPTED tokens into the head's KV
+                // (pairs them with the rows harvested by the last mtp-flagged
+                // pass). Rejected proposals never reach the head.
+                if let Some(ma) = inputs.iter().find(|nt| nt.name == "mtp_accept") {
+                    self.park_check()?;
+                    let v = tokens_from_tensor(&ma.tensor)?;
+                    let (pos0, toks) = match v.split_first() {
+                        Some((p, rest)) if !rest.is_empty() => (*p, rest),
+                        _ => return Err(err("mtp_accept needs [pos0, tokens...]")),
+                    };
+                    if pos0 < 0 {
+                        return Err(err("mtp_accept pos0 must be >= 0"));
+                    }
+                    self.server.mtp_observe(self.seq_id, pos0, toks).map_err(err)?;
+                    return Ok(Some(vec![]));
+                }
+                let tokens = inputs
+                    .iter()
+                    .find(|nt| nt.name == "tokens" || nt.name == "0")
+                    .ok_or_else(|| err("missing \"tokens\" input"))?;
+                let ids = tokens_from_tensor(&tokens.tensor)?;
+                // mm34: {"prompt": I32 [1, N]} beside a prompt's FIRST chunk
+                // declares the whole prompt (see PromptPlan); the branch is
+                // settled here, before the chunk is fed
+                if let Some(pt) = inputs.iter().find(|nt| nt.name == "prompt") {
+                    // mm35: {"marks": I32 [k]} beside it names the positions
+                    // where a shared prefix ends, to be parked as crossed
+                    let marks: Vec<usize> = match inputs.iter().find(|nt| nt.name == "marks") {
+                        Some(mk) => tokens_from_tensor(&mk.tensor)?
+                            .into_iter().filter(|&m| m > 0).map(|m| m as usize).collect(),
+                        None => Vec::new(),
+                    };
+                    // mm36: {"prefix_wait": I32 [1] = 1} opts this call into
+                    // waiting for another context that is preparing the same
+                    // prefix (refused with PREFIX_WARMING_ERR, retried by the
+                    // guest); absent = warm concurrently, as before mm36
+                    let wait_ok = inputs.iter().any(|nt| nt.name == "prefix_wait"
+                        && tokens_from_tensor(&nt.tensor).map(|v| v.first() == Some(&1)).unwrap_or(false));
+                    self.plan_prompt(tokens_from_tensor(&pt.tensor)?, marks, wait_ok)?;
+                }
+                let flag = |name: &str| {
+                    inputs.iter().any(|nt| nt.name == name
+                        && tokens_from_tensor(&nt.tensor).map(|v| v.first() == Some(&1)).unwrap_or(false))
+                };
+                // {"all": I32 [1] = 1} beside "tokens": logits for EVERY fed
+                // position, dims [n, vocab] - the speculative verify step.
+                // {"mtp_for": I32 [1] = seq} harvests the pass's MTP hidden
+                // rows for that sequence (the verify runs on a scratch branch
+                // but the head state belongs to the REAL sequence).
+                let want_all = flag("all");
+                // {"topk": I32 [1] = K}: reduce every logits row host-side
+                // to its top-K before crossing the guest boundary (see
+                // topk_rows). Engines predating this input simply ignore it
+                // and return dense "logits" - guests sniff the output name.
+                let topk = inputs
+                    .iter()
+                    .find(|nt| nt.name == "topk")
+                    .map(|nt| tokens_from_tensor(&nt.tensor))
+                    .transpose()?
+                    .and_then(|v| v.first().copied())
+                    .map(|kv| kv.clamp(16, 1024) as usize);
+                let mtp_for = inputs
+                    .iter()
+                    .find(|nt| nt.name == "mtp_for")
+                    .map(|nt| tokens_from_tensor(&nt.tensor))
+                    .transpose()?
+                    .and_then(|v| v.first().copied());
+                // mm32: a donor's pre-fork caps id routes to its live sequence
+                let mtp_for = mtp_for.map(|ms| {
+                    self.server.alias.lock().unwrap().get(&ms).copied().unwrap_or(ms)
+                });
+                if let Some(ms) = mtp_for {
+                    if ms < 0 || ms >= self.server.total_seqs as i32 {
+                        return Err(err(format!("mtp_for seq {ms} outside this graph's sequences")));
+                    }
+                }
+                // mm32: a single-token feed is generation-shaped - the
+                // prompt (if any) is over; resolve and park it first
+                if ids.len() == 1 {
+                    self.park_check()?;
+                }
+                if want_all {
+                    self.park_check()?;
+                    let flat = self
+                        .server
+                        .submit_full(self.seq_id, self.n_past, &ids, mtp_for)
+                        .map_err(err)?;
+                    self.mark_diverged();
+                    self.n_past += ids.len() as i32;
+                    // mm9: name where the verify verb's time goes -
+                    // "phase_us" I32 [gate, alloc, decode, harvest, topk].
+                    // The wrapper in wit.rs appends elapsed_us; the delta
+                    // between elapsed and this sum is wit-layer overhead.
+                    let ph = *self.server.last_phases.lock().unwrap();
+                    let ph_t4 = std::time::Instant::now();
+                    if let Some(kv) = topk {
+                        let (ti, tv) = match &flat {
+                            RowsOut::Dense(flat) => topk_rows(flat, ids.len(), self.server.n_vocab, kv),
+                            RowsOut::TopK { ids: ti, vals, k } => topk_tensors(ti, vals, ids.len(), *k, kv),
+                        };
+                        let ph_topk = ph_t4.elapsed().as_micros() as i64;
+                        let mut pdata = Vec::with_capacity(40);
+                        for v in [ph[0], ph[1], ph[2], ph[3], ph[4], ph_topk, ph[5], ph[6], ph[7], ph[8]] {
+                            pdata.extend_from_slice(&(v.clamp(0, i32::MAX as i64) as i32).to_le_bytes());
+                        }
+                        return Ok(Some(vec![
+                            NamedTensor { name: "topk_ids".to_string(), tensor: ti },
+                            NamedTensor { name: "topk_logits".to_string(), tensor: tv },
+                            NamedTensor { name: "phase_us".to_string(),
+                                          tensor: Tensor { dimensions: vec![10], ty: TensorType::I32, data: pdata } },
+                        ]));
+                    }
+                    let RowsOut::Dense(flat) = flat else {
+                        return Err(err(
+                            "this engine is armed for device top-k (nnDevTopk); dense \"logits\" \
+                             output is unavailable - request {\"topk\": K}",
+                        ));
+                    };
+                    let mut data = Vec::with_capacity(flat.len() * 4);
+                    for v in flat {
+                        data.extend_from_slice(&v.to_le_bytes());
+                    }
+                    let t = Tensor {
+                        dimensions: vec![ids.len() as u32, self.server.model.n_vocab],
+                        ty: TensorType::Fp32,
+                        data,
+                    };
+                    self.logits = Some(t.clone());
+                    return Ok(Some(vec![NamedTensor { name: "logits".to_string(), tensor: t }]));
+                }
+                // {"mtp": I32 [1] = 1} beside "tokens" (no "all"): an
+                // MTP-aware feed of this sequence - exclusive all-positions
+                // decode (the head needs every position's hidden row), rows
+                // harvested + mirrored into the head, but only the LAST
+                // logits row returned. The speculative prefill path.
+                if flag("mtp") {
+                    // mm34: a declared prompt feeds only what lies past the
+                    // park it branched off (zero rows for the covered part)
+                    if let Some(out) = self.plan_step(&ids, true)? {
+                        return Ok(Some(match out {
+                            None => self.hold_output(topk),
+                            Some(row) => self.render_row(row, topk)?,
+                        }));
+                    }
+                    // mm32: an undeclared prompt feed may still match a park
+                    // (a prefix no longer than this feed): branch, or replay
+                    // verbatim. None = feed exactly as before mm32.
+                    let row = if let Some(act) = self.defer_step(&ids)? {
+                        match act {
+                            DeferAction::Branch { remainder, row } => match row {
+                                Some(r) if remainder.is_empty() => r,
+                                _ => self.feed_mtp(&remainder)?,
+                            },
+                            DeferAction::Replay(buf) => self.feed_mtp(&buf)?,
+                        }
+                    } else {
+                        self.shadow(&ids);
+                        self.feed_mtp(&ids)?
+                    };
+                    if !self.prompt_done {
+                        self.last_row = Some(row.clone());
+                    }
+                    return self.render_row(row, topk).map(Some);
+                }
+                // mm34/mm32: same plan and branch/replay contract as the mtp
+                // path, through the plain decode; also serves 1-token
+                // generation steps, where both stand aside.
+                if let Some(out) = self.plan_step(&ids, false)? {
+                    return Ok(Some(match out {
+                        None => self.hold_output(topk),
+                        Some(row) => self.render_row(row, topk)?,
+                    }));
+                }
+                let row = if let Some(act) = self.defer_step(&ids)? {
+                    match act {
+                        DeferAction::Branch { remainder, row } => match row {
+                            Some(r) if remainder.is_empty() => r,
+                            _ => self.feed_plain(&remainder)?,
+                        },
+                        DeferAction::Replay(buf) => self.feed_plain(&buf)?,
+                    }
+                } else {
+                    self.shadow(&ids);
+                    self.feed_plain(&ids)?
+                };
+                if !self.prompt_done {
+                    self.last_row = Some(row.clone());
+                }
+                self.render_row(row, topk).map(Some)
+            }
+            // WITX path: tokens staged via set_input, result via get_output
+            None => {
+                let ids = self
+                    .pending
+                    .take()
+                    .ok_or_else(|| err("no input staged (call set_input first)"))?;
+                self.logits = Some(self.decode(&ids)?);
+                Ok(None)
+            }
+        }
+    }
+
+}
