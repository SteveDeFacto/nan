diff --git a/crates/wasi-nn/src/backend/prefix_claims.rs b/crates/wasi-nn/src/backend/prefix_claims.rs
new file mode 100644
index 0000000..5174d65
--- /dev/null
+++ b/crates/wasi-nn/src/backend/prefix_claims.rs
@@ -0,0 +1,336 @@
+//! mm36 SHARED prefix warming: exact-prefix CLAIMS on one serving context.
+//!
+//! The mm35 boundary parks make every prompt that starts the same way branch
+//! off a parked prefix - once somebody has READ that prefix. Until then every
+//! caller that arrives reads it for itself: the manager's boot warm-up, the
+//! page-load warm-up of every open tab, the first chat, an API benchmark -
+//! each a full ~3,000-token prefill on the same tokens, all serialised on the
+//! decode turn, so the prefix is prepared N times and the N-th caller waits
+//! for all of them. Wasmtime builds a fresh store per HTTP request, so the
+//! guest cannot coordinate this on its side: nothing of one request survives
+//! into the next. The serving context is the one thing every request of a
+//! deployment shares, so the coordination lives there.
+//!
+//! A claim is a promise, by one live execution context (the LEADER), to park
+//! the exact token prefix `prompt[..mark]` for one of the marks it declared.
+//! Any later context whose declared prompt carries the SAME exact prefix as
+//! a pending mark of its own is a FOLLOWER: instead of feeding, its first
+//! chunk is refused with the `[prefix_warming]` marker and the leader's
+//! progress, and the guest retries that same chunk after a short sleep.
+//! Every retry re-plans against the parks, so the moment the leader has
+//! parked the mark the follower branches off it and pays only what follows.
+//! The follower waits OUTSIDE any host call, so its stream stays alive and a
+//! reader that leaves ends the wait at once.
+//!
+//! Claims are released as each mark is parked (or found unparkable), when
+//! the leader's plan ends or fails, and when the leader's context drops -
+//! an abandoned warm-up (a closed tab) lets the next follower's retry find
+//! no claim and lead from wherever the parks stand. A claim that has seen
+//! no progress for `stale_after` is ignored (and replaced), so a wedged
+//! leader can strand nobody past that; the engine watchdog bounds the
+//! leader itself. The identity of a claim is its owner's `claim_id`, minted
+//! once per context: a park fork SWAPS a session's `seq_id`, so that is not
+//! a safe owner name.
+//!
+//! Waiting is OPT-IN per call (`{"prefix_wait": [1]}` beside the first
+//! chunk): a guest built before mm36 treats any compute error as fatal, so
+//! it must never be refused - it warms concurrently exactly as before.
+//! This module holds no engine state and no locks of its own; the server
+//! keeps it behind one leaf mutex (see GgmlServer::claims).
+
+#![allow(dead_code)]
+
+use std::time::{Duration, Instant};
+
+/// The refusal marker a follower sees. Guests match it with a substring test
+/// (the forgiving-parser shape every marker in this backend uses), so the
+/// literal is pinned by test/prefix-warming.test.mjs in the enclave repo and
+/// must never change.
+pub const PREFIX_WARMING_ERR: &str = "[prefix_warming]";
+
+/// Default `stale_after`: a leader that reported no progress for this long
+/// is treated as gone. One prefill chunk on the slowest fleet node is ~45 s
+/// (512 tokens at ~11 tok/s), so five minutes is comfortably past a chunk
+/// and far short of the engine watchdog (600 s), which is what actually
+/// ends a wedged leader. ENCLAVE_GGML_PREFIX_CLAIM_STALE_S overrides.
+pub const DEFAULT_STALE_SECS: u64 = 300;
+
+/// Bound on live claims (contexts x marks; the session cap is 8 and a prompt
+/// declares two or three marks). Past it new callers lead unclaimed - the
+/// pre-mm36 behaviour - rather than growing the table.
+pub const MAX_CLAIMS: usize = 64;
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ClaimVerdict {
+    /// no live claim by another owner covers any of the caller's pending
+    /// marks: the caller leads, and now holds a claim on each of them
+    Lead,
+    /// another context is preparing exactly the prefix of the caller's
+    /// first still-pending mark: wait for it. `done`/`total` is that
+    /// leader's progress in positions toward the mark.
+    Wait { done: usize, total: usize },
+}
+
+#[derive(Debug)]
+struct Claim {
+    /// the exact prefix promised: `prompt[..total]`
+    key: Vec<i32>,
+    owner: u64,
+    total: usize,
+    done: usize,
+    touched: Instant,
+}
+
+#[derive(Debug)]
+pub struct PrefixClaims {
+    claims: Vec<Claim>,
+    stale_after: Duration,
+    cap: usize,
+}
+
+impl PrefixClaims {
+    pub fn new(stale_after: Duration) -> Self {
+        PrefixClaims { claims: Vec::new(), stale_after, cap: MAX_CLAIMS }
+    }
+
+    #[cfg(test)]
+    fn with_cap(stale_after: Duration, cap: usize) -> Self {
+        PrefixClaims { claims: Vec::new(), stale_after, cap }
+    }
+
+    fn fresh(&self, c: &Claim, now: Instant) -> bool {
+        now.saturating_duration_since(c.touched) <= self.stale_after
+    }
+
+    /// The first (lowest) mark in `marks` whose exact prefix a fresh claim
+    /// by ANOTHER owner covers, as that leader's (done, total). None = no
+    /// conflict. Read-only: the cheap pre-check a follower's retry runs
+    /// without waiting for the decode turn.
+    pub fn blocking(&self, owner: u64, prompt: &[i32], marks: &[usize], now: Instant) -> Option<(usize, usize)> {
+        let mut marks: Vec<usize> = marks.iter().copied().filter(|&m| m > 0 && m <= prompt.len()).collect();
+        marks.sort_unstable();
+        marks.dedup();
+        for m in marks {
+            if let Some(c) = self.claims.iter().find(|c| {
+                c.owner != owner && c.total == m && self.fresh(c, now) && c.key[..] == prompt[..m]
+            }) {
+                return Some((c.done.min(c.total), c.total));
+            }
+        }
+        None
+    }
+
+    /// Check-and-register, atomically with respect to this table: with
+    /// `wait_ok`, a conflict on any pending mark returns Wait and registers
+    /// nothing; otherwise the caller leads and gains a claim on every mark
+    /// no other live owner already holds (a re-plan by the same owner
+    /// refreshes its own). Stale claims are dropped on the way.
+    pub fn plan(&mut self, owner: u64, prompt: &[i32], marks: &[usize], wait_ok: bool, now: Instant) -> ClaimVerdict {
+        let stale = self.stale_after;
+        self.claims.retain(|c| now.saturating_duration_since(c.touched) <= stale);
+        if wait_ok {
+            if let Some((done, total)) = self.blocking(owner, prompt, marks, now) {
+                return ClaimVerdict::Wait { done, total };
+            }
+        }
+        let mut marks: Vec<usize> = marks.iter().copied().filter(|&m| m > 0 && m <= prompt.len()).collect();
+        marks.sort_unstable();
+        marks.dedup();
+        for m in marks {
+            if let Some(c) = self.claims.iter_mut().find(|c| c.total == m && c.key[..] == prompt[..m]) {
+                if c.owner == owner {
+                    c.touched = now;
+                }
+                // another owner's live claim stands (only reachable when the
+                // caller declined to wait): two leaders, as before mm36
+                continue;
+            }
+            if self.claims.len() >= self.cap {
+                break;
+            }
+            self.claims.push(Claim { key: prompt[..m].to_vec(), owner, total: m, done: 0, touched: now });
+        }
+        ClaimVerdict::Lead
+    }
+
+    /// The leader fed up to absolute position `pos`: every claim it holds
+    /// advances (they are all served by the same prefill) and stays fresh.
+    pub fn progress(&mut self, owner: u64, pos: usize, now: Instant) {
+        for c in self.claims.iter_mut().filter(|c| c.owner == owner) {
+            c.done = pos.min(c.total);
+            c.touched = now;
+        }
+    }
+
+    /// The leader crossed `mark` (parked it, or found it unparkable - either
+    /// way followers must re-plan against the parks, not wait on): drop its
+    /// claim on that mark.
+    pub fn resolve(&mut self, owner: u64, mark: usize) {
+        self.claims.retain(|c| !(c.owner == owner && c.total == mark));
+    }
+
+    /// Everything `owner` holds: its plan ended, failed, or its context is
+    /// going away.
+    pub fn release_all(&mut self, owner: u64) {
+        self.claims.retain(|c| c.owner != owner);
+    }
+
+    /// Live (fresh) claims right now - "somebody is warming a prefix here".
+    pub fn active(&self, now: Instant) -> usize {
+        self.claims.iter().filter(|c| self.fresh(c, now)).count()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn prompt(n: usize) -> Vec<i32> {
+        (0..n as i32).collect()
+    }
+
+    #[test]
+    fn first_caller_leads_and_matching_follower_waits_with_progress() {
+        let mut t = PrefixClaims::new(Duration::from_secs(300));
+        let now = Instant::now();
+        let p = prompt(100);
+        assert_eq!(t.plan(1, &p, &[40, 90], true, now), ClaimVerdict::Lead);
+        assert_eq!(t.active(now), 2);
+        // a chat whose prompt continues past the warm-up's end shares both marks
+        let mut chat = p.clone();
+        chat.extend([500, 501, 502]);
+        assert_eq!(t.plan(2, &chat, &[40, 90], true, now), ClaimVerdict::Wait { done: 0, total: 40 });
+        t.progress(1, 32, now);
+        assert_eq!(t.plan(2, &chat, &[40, 90], true, now), ClaimVerdict::Wait { done: 32, total: 40 });
+        // progress is clamped to the mark it reports on
+        t.progress(1, 70, now);
+        assert_eq!(t.plan(2, &chat, &[40, 90], true, now), ClaimVerdict::Wait { done: 40, total: 40 });
+        // the first mark parked: the follower's re-plan (which now covers
+        // 40 and has only 90 pending) waits on the second
+        t.resolve(1, 40);
+        assert_eq!(t.plan(2, &chat, &[90], true, now), ClaimVerdict::Wait { done: 70, total: 90 });
+        t.resolve(1, 90);
+        assert_eq!(t.active(now), 0);
+        // nothing pending any more: the follower leads what is left (nothing)
+        assert_eq!(t.plan(2, &chat, &[], true, now), ClaimVerdict::Lead);
+    }
+
+    #[test]
+    fn a_different_prefix_never_waits_and_a_shared_head_waits_only_for_the_head() {
+        let mut t = PrefixClaims::new(Duration::from_secs(300));
+        let now = Instant::now();
+        let p = prompt(100);
+        assert_eq!(t.plan(1, &p, &[40, 90], true, now), ClaimVerdict::Lead);
+        // same length, one token differs inside the first mark: unrelated
+        let mut other = p.clone();
+        other[10] = -1;
+        assert_eq!(t.plan(2, &other, &[40, 90], true, now), ClaimVerdict::Lead);
+        assert_eq!(t.active(now), 4);
+        // shares the system text (mark 40) but carries another tool block
+        let mut sibling = p[..40].to_vec();
+        sibling.extend((1000..1060).collect::<Vec<i32>>());
+        assert_eq!(t.plan(3, &sibling, &[40, 100], true, now), ClaimVerdict::Wait { done: 0, total: 40 });
+        t.resolve(1, 40);
+        // its second mark is its own: it leads that one
+        assert_eq!(t.plan(3, &sibling, &[100], true, now), ClaimVerdict::Lead);
+        assert!(t.claims.iter().any(|c| c.owner == 3 && c.total == 100));
+    }
+
+    #[test]
+    fn a_dropped_or_failed_leader_frees_its_followers() {
+        let mut t = PrefixClaims::new(Duration::from_secs(300));
+        let now = Instant::now();
+        let p = prompt(100);
+        assert_eq!(t.plan(1, &p, &[40, 90], true, now), ClaimVerdict::Lead);
+        assert_eq!(t.plan(2, &p, &[40, 90], true, now), ClaimVerdict::Wait { done: 0, total: 40 });
+        t.release_all(1); // the leader's context dropped mid-prefill
+        assert_eq!(t.plan(2, &p, &[40, 90], true, now), ClaimVerdict::Lead);
+        assert!(t.claims.iter().all(|c| c.owner == 2));
+        // the take-over leader is itself authoritative for a third caller
+        assert_eq!(t.plan(3, &p, &[40, 90], true, now), ClaimVerdict::Wait { done: 0, total: 40 });
+    }
+
+    #[test]
+    fn a_stale_leader_is_ignored_and_replaced() {
+        let mut t = PrefixClaims::new(Duration::from_secs(300));
+        let t0 = Instant::now();
+        let p = prompt(100);
+        assert_eq!(t.plan(1, &p, &[40], true, t0), ClaimVerdict::Lead);
+        let later = t0 + Duration::from_secs(299);
+        assert_eq!(t.plan(2, &p, &[40], true, later), ClaimVerdict::Wait { done: 0, total: 40 });
+        // progress keeps a slow leader fresh
+        t.progress(1, 8, later);
+        let later2 = later + Duration::from_secs(299);
+        assert_eq!(t.plan(2, &p, &[40], true, later2), ClaimVerdict::Wait { done: 8, total: 40 });
+        let stale = later2 + Duration::from_secs(2);
+        assert_eq!(t.active(stale), 0);
+        assert_eq!(t.plan(2, &p, &[40], true, stale), ClaimVerdict::Lead);
+        assert!(t.claims.iter().all(|c| c.owner == 2), "the stale claim is replaced, not kept beside");
+    }
+
+    #[test]
+    fn declining_to_wait_leads_beside_the_leader_without_stealing_its_claim() {
+        let mut t = PrefixClaims::new(Duration::from_secs(300));
+        let now = Instant::now();
+        let p = prompt(100);
+        assert_eq!(t.plan(1, &p, &[40, 90], true, now), ClaimVerdict::Lead);
+        assert_eq!(t.plan(2, &p, &[40, 90], false, now), ClaimVerdict::Lead);
+        assert_eq!(t.active(now), 2, "the impatient caller registers nothing already claimed");
+        // the original leader still answers for followers
+        assert_eq!(t.plan(3, &p, &[40, 90], true, now), ClaimVerdict::Wait { done: 0, total: 40 });
+        t.progress(2, 30, now); // the second leader's progress is not the claim's
+        assert_eq!(t.plan(3, &p, &[40, 90], true, now), ClaimVerdict::Wait { done: 0, total: 40 });
+    }
+
+    #[test]
+    fn a_leader_re_planning_refreshes_its_own_claims_and_never_waits_on_itself() {
+        let mut t = PrefixClaims::new(Duration::from_secs(300));
+        let t0 = Instant::now();
+        let p = prompt(100);
+        assert_eq!(t.plan(1, &p, &[40, 90], true, t0), ClaimVerdict::Lead);
+        let later = t0 + Duration::from_secs(200);
+        assert_eq!(t.plan(1, &p, &[40, 90], true, later), ClaimVerdict::Lead);
+        assert_eq!(t.active(later + Duration::from_secs(200)), 2, "refreshed, not aged from t0");
+    }
+
+    #[test]
+    fn marks_outside_the_prompt_or_at_zero_are_not_claims() {
+        let mut t = PrefixClaims::new(Duration::from_secs(300));
+        let now = Instant::now();
+        let p = prompt(50);
+        assert_eq!(t.plan(1, &p, &[0, 40, 51, 40], true, now), ClaimVerdict::Lead);
+        assert_eq!(t.active(now), 1);
+        assert_eq!(t.blocking(2, &p, &[0, 51], now), None);
+        assert_eq!(t.blocking(2, &p, &[40], now), Some((0, 40)));
+    }
+
+    #[test]
+    fn the_table_is_bounded_and_overflow_degrades_to_leading_unclaimed() {
+        let mut t = PrefixClaims::with_cap(Duration::from_secs(300), 2);
+        let now = Instant::now();
+        let p = prompt(100);
+        assert_eq!(t.plan(1, &p, &[40, 90], true, now), ClaimVerdict::Lead);
+        let mut other = p.clone();
+        other[0] = -1;
+        assert_eq!(t.plan(2, &other, &[40], true, now), ClaimVerdict::Lead);
+        assert_eq!(t.active(now), 2, "no room: the second caller leads without a claim");
+        assert_eq!(t.blocking(3, &other, &[40], now), None);
+    }
+
+    #[test]
+    fn resolve_touches_only_that_owner_and_mark() {
+        let mut t = PrefixClaims::new(Duration::from_secs(300));
+        let now = Instant::now();
+        let p = prompt(100);
+        let mut other = p.clone();
+        other[0] = -1;
+        assert_eq!(t.plan(1, &p, &[40, 90], true, now), ClaimVerdict::Lead);
+        assert_eq!(t.plan(2, &other, &[40], true, now), ClaimVerdict::Lead);
+        t.resolve(2, 40);
+        assert_eq!(t.blocking(9, &p, &[40], now), Some((0, 40)));
+        assert_eq!(t.blocking(9, &other, &[40], now), None);
+        t.resolve(1, 40);
+        assert_eq!(t.blocking(9, &p, &[40], now), None);
+        assert_eq!(t.blocking(9, &p, &[90], now), Some((0, 90)));
+    }
+}
