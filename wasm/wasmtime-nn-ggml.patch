+}
+
+// ---- vision (libmtmd), resolved at RUNTIME ---------------------------------
+//
+// These four shim entry points are looked up by dlsym instead of being linked
+// like the rest, and the reason is a hard requirement rather than taste: the
+// wasmtime binary links libenclave_llama.so from a PINNED toolchain tarball,
+// so a link-time reference to a symbol a deployed tarball lacks would break
+// the manager image build outright. Resolved this way, an older tarball simply
+// reports "no vision": the ggml backend builds and serves exactly as before,
+// the "caps" probe returns vision=0, and the "image" verb refuses with a
+// message that says which half is missing. Turning vision on is then a
+// toolchain bump alone (see wasm/llama-shim/enclave_llama.h).
+type MtmdCapsFn = unsafe extern "C" fn(*const c_char) -> i32;
+type MtmdNewFn = unsafe extern "C" fn(*mut c_void, *const c_char, i32, i32, i32) -> *mut c_void;
+type MtmdFreeFn = unsafe extern "C" fn(*mut c_void);
+type MtmdEvalFn = unsafe extern "C" fn(
+    *mut c_void, // mtmd handle
+    *mut c_void, // llama context
+    i32,         // seq_id
+    i32,         // pos0
+    *const u8,   // image file bytes
+    u32,         // len
+    i32,         // n_batch
+    *mut i32,    // out: positions consumed
+) -> i32;
+// mm33: ONE video file -> sampled frames. Optional on top of the four above:
+// a tarball that predates it still serves vision, and the "video" verb
+// refuses with [video_unavailable] instead of the backend failing to build.
+type MtmdEvalVideoFn = unsafe extern "C" fn(
+    *mut c_void,   // mtmd handle
+    *mut c_void,   // llama context
+    i32,           // seq_id
+    i32,           // pos0
+    *const u8,     // video file bytes
+    u32,           // len
+    i32,           // n_batch
+    i32,           // fps_milli (<=0 = helper default)
+    i32,           // max_frames (<=0 = 8; capped 64)
+    i32,           // timestamp_ms (<=0 = none)
+    *const c_char, // ffmpeg dir ("" = PATH)
+    *mut i32,      // out: positions consumed
+    *mut i32,      // out: frames used
+) -> i32;
+
+struct MtmdSyms {
+    caps_file: MtmdCapsFn,
+    new: MtmdNewFn,
+    free: MtmdFreeFn,
+    eval_image: MtmdEvalFn,
+    eval_video: Option<MtmdEvalVideoFn>,
+}
+unsafe impl Send for MtmdSyms {}
+unsafe impl Sync for MtmdSyms {}
+
+static MTMD_SYMS: OnceLock<Option<MtmdSyms>> = OnceLock::new();
+
+/// The shim's vision entry points, or None when the linked toolchain predates
+/// them. All four or nothing: a partial set means a half-built shim, and
+/// guessing which half works is worse than reporting no vision.
+fn mtmd_syms() -> Option<&'static MtmdSyms> {
+    MTMD_SYMS
+        .get_or_init(|| {
+            // RTLD_DEFAULT (null on glibc) searches the process's own global
+            // scope, which is where the linked shim already lives.
+            let sym = |name: &str| -> *mut c_void {
+                let Ok(c) = CString::new(name) else { return std::ptr::null_mut() };
+                unsafe { dlsym(std::ptr::null_mut(), c.as_ptr()) }
+            };
+            let caps = sym("ell_mtmd_caps_file");
+            let new = sym("ell_mtmd_new");
+            let free = sym("ell_mtmd_free");
+            let eval = sym("ell_mtmd_eval_image");
+            if caps.is_null() || new.is_null() || free.is_null() || eval.is_null() {
+                return None;
+            }
+            let evv = sym("ell_mtmd_eval_video");
+            Some(unsafe {
+                MtmdSyms {
+                    caps_file: std::mem::transmute::<*mut c_void, MtmdCapsFn>(caps),
+                    new: std::mem::transmute::<*mut c_void, MtmdNewFn>(new),
+                    free: std::mem::transmute::<*mut c_void, MtmdFreeFn>(free),
+                    eval_image: std::mem::transmute::<*mut c_void, MtmdEvalFn>(eval),
+                    eval_video: if evv.is_null() { None } else {
+                        Some(std::mem::transmute::<*mut c_void, MtmdEvalVideoFn>(evv))
+                    },
+                }
+            })
+        })
+        .as_ref()
+}
+
+/// Does this file name look like a vision projector rather than a model?
+/// llama.cpp's own convention across every VLM repo is an `mmproj` prefix
+/// (mmproj-F16.gguf, mmproj-model-f16.gguf); the name is also how the model
+/// pick tells the two ggufs in a VLM volume apart.
+fn is_mmproj_name(name: &str) -> bool {
+    name.to_ascii_lowercase().contains("mmproj")
+}
+
+static INIT: Once = Once::new();
+
+fn err(msg: impl Into<String>) -> BackendError {
+    BackendError::BackendAccess(wasmtime::format_err!("{}", msg.into()))
+}
+
+fn env_u32(name: &str, default: u32) -> u32 {
+    std::env::var(name).ok().and_then(|v| v.parse().ok()).unwrap_or(default)
+}
+
+fn env_i32(name: &str, default: i32) -> i32 {
+    std::env::var(name).ok().and_then(|v| v.parse().ok()).unwrap_or(default)
+}
+
+/// KV-cache element type string -> the shim's `ell_kv_type` code (0 F16 default,
+/// 1 Q8_0, 2 Q4_0, 3 F32). Empty/unknown = F16, i.e. current behavior.
+/// mm30 COHORT BATCHING. How long a decode leader may wait for the other
+/// sequences that are also stepping, before it decodes without them
+/// (`ENCLAVE_GGML_COHORT_MS`, 0 = off = pre-mm30 opportunistic merging).
+///
+/// Why waiting is FASTER than not waiting, which is the whole point: llama
+/// only reuses a built graph when the next ubatch has the same shape AND the
+/// same participating sequence ids, and ggml-cuda only replays a captured
+/// CUDA graph while llama keeps reusing (a rebuild changes cgraph->uid, and
+/// re-capture needs several property-stable passes). Merging whatever happens
+/// to be queued makes the set oscillate — {0,1}, {0}, {1} — so the graph is
+/// rebuilt EVERY step and every decode runs as thousands of individual kernel
+/// launches, which under SEV-SNP costs ~50-90 ms against a ~16 ms replayed
+/// step. Two sequences that are both generating arrive within a couple of ms
+/// of each other, so a small window buys a stable set almost for free.
+fn cohort_ms() -> u64 {
+    static V: OnceLock<u64> = OnceLock::new();
+    *V.get_or_init(|| {
+        std::env::var("ENCLAVE_GGML_COHORT_MS")
+            .ok()
+            .and_then(|v| v.trim().parse::<u64>().ok())
+            .unwrap_or(12)
+            .min(200)
+    })
+}
+
+/// How long since its last step a sequence is still counted as "stepping",
+/// and so still worth waiting for (`ENCLAVE_GGML_COHORT_TTL_MS`). A sequence
+/// that stops (finished, or its guest went off to run a tool) ages out of the
+/// cohort and the survivors stop paying for it. A single missed window drops
+/// it immediately — this bound is only the backstop for a sequence that never
+/// comes back at all.
+fn cohort_ttl() -> Duration {
+    static V: OnceLock<u64> = OnceLock::new();
+    Duration::from_millis(*V.get_or_init(|| {
+        std::env::var("ENCLAVE_GGML_COHORT_TTL_MS")
+            .ok()
+            .and_then(|v| v.trim().parse::<u64>().ok())
+            .unwrap_or(500)
+            .clamp(50, 10_000)
+    }))
+}
+
+/// PREFIX CACHE (mm32). How many prompt-state forks this graph may keep
+/// parked between requests (`ENCLAVE_GGML_PARK_SLOTS`, default 0 = off).
+///
+/// Every /v1 request re-feeds its whole rendered prompt into a fresh
+/// sequence; on a CPU-prefill node that is the dominant TTFT term (a 27B
+/// prefills at ~11 tok/s — turn N of a 2,000-token conversation pays ~175 s
+/// before its first token). But turn N's PROMPT is always a strict prefix of
+/// turn N+1's (the template appends), and `ell_seq_copy` shares attention KV
+/// cells and copy-on-writes recurrent state — so parking the pre-generation
+/// prompt state and branching the next request off it skips the re-prefill
+/// entirely (prototype: 16.5x on a 0.8B hybrid, 9.3x on a 27B; the branch's
+/// one-time COW cost measured ~0 ms at 0.8B / ~70-110 ms at 27B).
+///
+/// The FORK DIRECTION is load-bearing on hybrid models and was settled
+/// empirically: an un-diverged copy still shares its source's recurrent
+/// state cell, and removing the source kills it (wrong next token). So the
+/// ORIGINAL prompt-fed sequence becomes the park (it owns its cells) and the
+/// SESSION continues on a fresh copy, which diverges with its first
+/// generated token. Teardown then removes only the copy.
+///
+/// Costs when armed: each slot adds one sequence to the llama context
+/// (recurrent models allocate that seq's state cell up front) and a parked
+/// prompt holds its cells out of the shared n_ctx pool; a resident park also
+/// keeps the idle-reset fragmentation heal from firing until it goes stale
+/// (see PARK_TTL below). Off by default; arm per node.
+fn park_slots() -> usize {
+    static V: OnceLock<usize> = OnceLock::new();
+    *V.get_or_init(|| {
+        std::env::var("ENCLAVE_GGML_PARK_SLOTS")
+            .ok()
+            .and_then(|v| v.trim().parse::<usize>().ok())
+            .unwrap_or(0)
+            .min(8)
+    })
+}
+
+/// Prompts shorter than this are not worth a park slot: the re-prefill they
+/// save is small, and each park spends a slot, its pool cells, and (on
+/// hybrids) the session's one-time COW divergence. Pool-pressure hygiene,
+/// not a cost guard — the COW itself measured <5% of one decode token.
+fn park_min_tokens() -> usize {
+    static V: OnceLock<usize> = OnceLock::new();
+    *V.get_or_init(|| env_u32("ENCLAVE_GGML_PARK_MIN_TOKENS", 64) as usize)
+}
+
+/// A park older than this no longer blocks the idle reset (the unified
+/// pool's fragmentation heal, which needs an empty pool): when every session
+/// is gone and every park has aged past the TTL, the parks are dropped and
+/// the pool clears. Fresh parks win over the heal on purpose — a busy burst
+/// is exactly when they earn their keep, and any long quiet moment ends with
+/// the pool clean either way.
+fn park_ttl() -> Duration {
+    static V: OnceLock<u64> = OnceLock::new();
+    Duration::from_secs(*V.get_or_init(|| env_u32("ENCLAVE_GGML_PARK_TTL_S", 900) as u64))
+}
+
+/// mm35 BOUNDARY parks. A guest that declares its prompt (mm34) may also
+/// declare MARKS: positions where a shared prefix ends - its system text,
+/// its tool block. As prefill crosses each mark the state so far is parked
+/// on this separate budget, so every later prompt that starts the same way
+/// (every new chat at a deployment) branches off it and pays only what
+/// follows. Turn parks come and go with conversations; these are the
+/// deployment's standing prefix and live on their own slots and clock.
+/// ENCLAVE_GGML_PREFIX_SLOTS (2 when the prefix cache is armed, 0 = off),
+/// ENCLAVE_GGML_PREFIX_TTL_S (6 h): past it an idle pool may clear them.
+fn prefix_slots() -> usize {
+    static V: OnceLock<usize> = OnceLock::new();
+    *V.get_or_init(|| {
+        if park_slots() == 0 { 0 } else { (env_u32("ENCLAVE_GGML_PREFIX_SLOTS", 2) as usize).min(8) }
+    })
+}
+
+fn prefix_ttl() -> Duration {
+    static V: OnceLock<u64> = OnceLock::new();
+    Duration::from_secs(*V.get_or_init(|| env_u32("ENCLAVE_GGML_PREFIX_TTL_S", 21600) as u64))
+}
+
+/// mm36: a prefix claim (see prefix_claims.rs) whose leader reported no
+/// progress for this long no longer makes anyone wait.
+fn prefix_claim_stale() -> Duration {
+    static V: OnceLock<u64> = OnceLock::new();
+    Duration::from_secs(*V.get_or_init(|| {
+        env_u32("ENCLAVE_GGML_PREFIX_CLAIM_STALE_S", DEFAULT_STALE_SECS as u32) as u64
+    }))
+}
+
+/// mm36: claim owners. A context's seq_id changes at every park fork, so
+/// the claims it holds are keyed by this id, minted once at init.
+static CLAIM_IDS: AtomicU64 = AtomicU64::new(0);
+
+/// mm36: the follower's refusal (see prefix_claims.rs). Substring-matched by
+/// guests on PREFIX_WARMING_ERR; the "N of M" pair is the leader's progress.
+fn prefix_warming(done: usize, total: usize) -> BackendError {
+    err(format!(
+        "{PREFIX_WARMING_ERR} another request is preparing this prompt's shared prefix \
+         ({done} of {total} tokens); retry the same chunk shortly"
+    ))
+}
+
+/// mm33 VIDEO. What one "video" verb may cost this node: frames are encoder
+/// passes plus their share of the KV pool, so the cap is per node, not per
+/// guest. ENCLAVE_GGML_VIDEO_MAX_FRAMES (8, 1..64) bounds frames per clip,
+/// ENCLAVE_GGML_VIDEO_FPS_MILLI (1000 = 1 fps) is the sampling rate a guest
+/// gets when it names none, ENCLAVE_GGML_VIDEO_MAX_BYTES (64 MiB) bounds the
+/// file, ENCLAVE_GGML_VIDEO_TIMESTAMP_MS (5000) spaces the helper's "[Xs]"
+/// texts (0 = none), and ENCLAVE_GGML_FFMPEG_DIR names where ffmpeg/ffprobe
+/// live ("" = PATH) - the engine image ships them under /bin.
+fn video_max_frames() -> i32 { env_u32("ENCLAVE_GGML_VIDEO_MAX_FRAMES", 8).clamp(1, 64) as i32 }
+fn video_fps_milli() -> i32 { env_u32("ENCLAVE_GGML_VIDEO_FPS_MILLI", 1000).clamp(100, 30_000) as i32 }
+fn video_max_bytes() -> usize { env_u32("ENCLAVE_GGML_VIDEO_MAX_BYTES", 64 << 20) as usize }
+fn video_timestamp_ms() -> i32 { env_u32("ENCLAVE_GGML_VIDEO_TIMESTAMP_MS", 5000).min(600_000) as i32 }
+fn ffmpeg_dir() -> String { std::env::var("ENCLAVE_GGML_FFMPEG_DIR").unwrap_or_else(|_| "/bin".to_string()) }
+
+fn kv_type_code(s: &str) -> i32 {
+    match s.trim().to_ascii_lowercase().as_str() {
+        "q8_0" | "q8" => 1,
+        "q4_0" | "q4" => 2,
+        "f32" | "fp32" => 3,
+        _ => 0,
+    }
+}
+
+/// Flash-attention selector string -> the shim's `ell_flash_attn` code
+/// (0 AUTO default, 1 DISABLED, 2 ENABLED).
+fn flash_attn_code(s: &str) -> i32 {
+    match s.trim().to_ascii_lowercase().as_str() {
+        "on" | "1" | "true" | "enabled" | "enable" => 2,
+        "off" | "0" | "false" | "disabled" | "disable" => 1,
+        _ => 0,
+    }
+}
+
+// ---- engine watchdog --------------------------------------------------
+//
+// llama.cpp/CUDA calls are synchronous FFI: nothing above them can cancel
+// one that never returns. A GPU whose context died mid-call (an MPS reset
+// took the partition, a driver wedge) leaves the calling thread blocked in
+// native code FOREVER while it holds the decode turn — every follower,
+// every session Drop and the slot pool then wait on state that can never
+// change, and the deployment answers [sessions_busy] politely until a
+// human restarts it. Observed live 2026-08-07: the GPU manager reported
+// NOTHING resident (all SMs and VRAM free) while the tenant swore the
+// model was "loaded and serving", indefinitely.
+//
+// A thread stuck inside dead native code cannot be recovered in-process,
+// so the recovery unit is the PROCESS: one tenant is one wasmtime, the
+// supervisor already respawns an instance whose manager reports it dead
+// (instanceAlive -> respawnTenant), and the respawn reloads the model into
+// a fresh context. The watchdog turns "wedged until a human notices" into
+// "down for one model reload, automatically".
+//
+// Mechanics: every guest-triggered entry into this backend registers an
+// RAII guard; a monitor thread scans them every few seconds and ABORTS the
+// process, loudly, when one has outlived its ceiling. Guards wrap whole
+// entry points (verb dispatch, context init, model load, session teardown)
+// rather than individual ell_* calls — deliberately OUTSIDE the regions
+// the arbiter patch rewrites — so decode-turn and lock waits count toward
+// the same ceiling: waiting on a wedged holder is the same emergency as
+// being one. Ceilings are generous multiples of the slowest legitimate
+// case (a CPU-mode prefill chunk; a cold 100+ GB model load) and
+// per-tenant tunable via the env block above; 0 disables.
+
+struct WatchdogEntry {
+    what: &'static str,
+    started: std::time::Instant,
+    limit_s: u32,
+}
+
+static WATCHDOG: OnceLock<Mutex<HashMap<u64, WatchdogEntry>>> = OnceLock::new();
+static WATCHDOG_SEQ: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+fn compute_watchdog_s() -> u32 {
+    static S: OnceLock<u32> = OnceLock::new();
+    *S.get_or_init(|| env_u32("ENCLAVE_GGML_COMPUTE_WATCHDOG_S", 600))
+}
+
+fn load_watchdog_s() -> u32 {
+    static S: OnceLock<u32> = OnceLock::new();
+    *S.get_or_init(|| env_u32("ENCLAVE_GGML_LOAD_WATCHDOG_S", 3600))
+}
+
+/// The guard map, creating the monitor thread on first use. The map lock is
+/// only ever held for entry/exit bookkeeping and the scan — never across
+/// FFI — so the monitor cannot itself get stuck behind a wedged call.
+fn watchdog_map() -> &'static Mutex<HashMap<u64, WatchdogEntry>> {
+    WATCHDOG.get_or_init(|| {
+        let _ = std::thread::Builder::new().name("nn-watchdog".into()).spawn(|| loop {
+            std::thread::sleep(std::time::Duration::from_secs(10));
+            let Some(m) = WATCHDOG.get() else { continue };
+            for e in m.lock().unwrap().values() {
+                let held = e.started.elapsed().as_secs();
+                if held > u64::from(e.limit_s) {
+                    eprintln!(
+                        "[nn-watchdog] FATAL: {} has been inside the ggml backend for {held}s \
+                         (ceiling {}s) — the GPU/backend context is presumed dead, and a thread \
+                         blocked in native code cannot be recovered in-process. Aborting so the \
+                         supervisor respawns this tenant on a fresh engine.",
+                        e.what, e.limit_s
+                    );
+                    std::process::abort();
+                }
+            }
+        });
+        Mutex::new(HashMap::new())
+    })
+}
+
+/// RAII registration of one backend entry. Costs one atomic bump and two
+/// short map locks per verb — noise next to a decode.
+struct WatchdogGuard(Option<u64>);
+
+impl WatchdogGuard {
+    fn new(what: &'static str, limit_s: u32) -> WatchdogGuard {
+        if limit_s == 0 {
+            return WatchdogGuard(None);
+        }
+        let id = WATCHDOG_SEQ.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        watchdog_map().lock().unwrap().insert(
+            id,
+            WatchdogEntry { what, started: std::time::Instant::now(), limit_s },
+        );
+        WatchdogGuard(Some(id))
+    }
+    fn compute(what: &'static str) -> WatchdogGuard {
+        WatchdogGuard::new(what, compute_watchdog_s())
+    }
+    fn load(what: &'static str) -> WatchdogGuard {
+        WatchdogGuard::new(what, load_watchdog_s())
+    }
+}
+
+impl Drop for WatchdogGuard {
+    fn drop(&mut self) {
+        if let Some(id) = self.0 {
+            watchdog_map().lock().unwrap().remove(&id);
+        }
+    }
+}
+
+#[derive(Default)]
+pub struct GgmlBackend();
+unsafe impl Send for GgmlBackend {}
+unsafe impl Sync for GgmlBackend {}
+
+impl GgmlBackend {
+    fn load_path(&self, path: &Path, target: ExecutionTarget) -> Result<Graph, BackendError> {
+        self.load_path_mm(path, target, None)
+    }
+
+    /// `mmproj`: the volume's vision projector, when it has one. Loading it is
+    /// deferred to the first image (it costs VRAM of its own), so all that
+    /// happens here is the capability probe that decides what "caps" reports.
+    fn load_path_mm(
+        &self,
+        path: &Path,
+        target: ExecutionTarget,
+        mmproj: Option<PathBuf>,
+    ) -> Result<Graph, BackendError> {
+        // load-class ceiling: ell_init dlopens driver-backed modules and the
+        // model read walks the whole volume, either of which can wedge on a
+        // dead device just like a decode
+        let _wd = WatchdogGuard::load("a model load");
+        INIT.call_once(|| unsafe { ell_init() });
+        // GPU offload only when asked for AND the linked libllama carries a
+        // GPU backend; a CPU-only libllama silently ignores n_gpu_layers.
+        let ngl = match target {
+            ExecutionTarget::Cpu => 0,
+            _ => env_i32("ENCLAVE_GGML_N_GPU_LAYERS", -1),
+        };
+        // Strict GPU: the CUDA backend is a dlopened module whose load
+        // failure (missing libcuda, wrong SASS, future lib drift) is silent
+        // by design — a 122B model "working" at CPU speed is the failure
+        // mode, so offload-requested + no GPU device = refuse loudly.
+        if ngl != 0 && unsafe { ell_gpu_devices() } == 0 {
+            return Err(err(
+                "ggml: GPU offload requested (ENCLAVE_GGML_N_GPU_LAYERS != 0) but no ggml GPU \
+                 device is available — CUDA backend module or driver missing",
+            ));
+        }
+        let cpath = CString::new(path.to_string_lossy().as_bytes())
+            .map_err(|_| err("model path contains NUL"))?;
+        let model = unsafe { ell_load_model(cpath.as_ptr(), ngl) };
+        if model.is_null() {
+            return Err(err(format!("llama.cpp failed to load {}", path.display())));
+        }
+        let n_vocab = unsafe { ell_n_vocab(model) };
+        if n_vocab <= 0 {
+            unsafe { ell_free_model(model) };
+            return Err(err("model reports no vocabulary"));
+        }
+        // A projector is only usable if BOTH halves are there: the file on the
+        // volume and a shim that knows what to do with it. Probe the file's
+        // capability bits (vision = 1) so a stray gguf named mmproj-something
+        // cannot advertise vision the model cannot serve.
+        let mmproj = mmproj.and_then(|p| {
+            let syms = mtmd_syms()?;
+            let c = CString::new(p.to_string_lossy().as_bytes()).ok()?;
+            let caps = unsafe { (syms.caps_file)(c.as_ptr()) };
+            (caps > 0 && caps & 1 != 0).then_some((p, c))
+        });
+        let graph: Box<dyn BackendGraph> = Box::new(GgmlGraph {
+            model: Arc::new(GgmlModel {
+                raw: model,
+                n_vocab: n_vocab as u32,
+                recurrent: unsafe { ell_model_recurrent(model) } != 0,
+                mtp: unsafe { ell_mtp_available(model) } != 0,
+                vision: mmproj.is_some(),
+                mmproj: mmproj.map(|(_, c)| c),
+                gpu: ngl != 0 || std::env::var_os("SHIELDED_HOST").is_some(), // shielded offload IS the card
+            }),
+            server: Mutex::new(None),
+        });
+        Ok(graph.into())
+    }
+}
+
+impl BackendInner for GgmlBackend {
+    fn encoding(&self) -> GraphEncoding {
+        GraphEncoding::Ggml
+    }
+
+    fn load(&mut self, builders: &[&[u8]], target: ExecutionTarget) -> Result<Graph, BackendError> {
+        if builders.len() != 1 {
+            return Err(BackendError::InvalidNumberOfBuilders(1, builders.len()));
+        }
+        // llama.cpp opens files, not buffers: stage guest bytes to a temp
+        // GGUF. Only viable for small models (the bytes crossed the guest's
+        // 32-bit memory to get here); big models come via load_by_name.
+        let dir = std::env::temp_dir().join(format!("wasi-nn-ggml-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).map_err(|e| err(format!("staging dir: {e}")))?;
+        let path = dir.join(format!("model-{:x}.gguf", builders[0].len()));
+        std::fs::write(&path, builders[0]).map_err(|e| err(format!("staging model: {e}")))?;
+        let graph = self.load_path(&path, target);
+        // the shim mmaps/reads it during load; safe to unlink either way
+        let _ = std::fs::remove_file(&path);
+        graph
+    }
+
+    fn as_dir_loadable<'a>(&'a mut self) -> Option<&'a mut dyn BackendFromDir> {
+        Some(self)
+    }
+}
+
+/// Part 00001 of the split-GGUF family covering EXACTLY the given file names
+/// (llama.cpp's "<prefix>-NNNNN-of-MMMMM.gguf" split convention, forced on
+/// >50GB models by HF's per-file cap), if there is one. llama.cpp opens part
+/// 00001 and derives the sibling paths from its file name, so handing it the
+/// first part loads the whole model; extra ggufs outside the family stay an
+/// error (an ambiguous pick would misload).
+fn split_family_first(names: &std::collections::BTreeSet<String>) -> Option<String> {
+    for name in names {
+        let Some(stem) = name.strip_suffix(".gguf") else { continue };
+        let Some((rest, count)) = stem.rsplit_once("-of-") else { continue };
+        let Some((prefix, no)) = rest.rsplit_once('-') else { continue };
+        if no != "00001" || count.len() != 5 {
+            continue;
+        }
+        let Some(n) = count.parse::<u32>().ok().filter(|n| *n >= 1) else { continue };
+        let family: std::collections::BTreeSet<String> = (1..=n)
+            .map(|i| format!("{prefix}-{i:05}-of-{count}.gguf"))
+            .collect();
+        if family == *names {
+            return Some(name.clone());
+        }
+    }
+    None
+}
+
+impl BackendFromDir for GgmlBackend {
+    fn load_from_dir(&mut self, path: &Path, target: ExecutionTarget) -> Result<Graph, BackendError> {
+        // A VLM volume holds TWO ggufs: the language model and its vision
+        // projector. The projector is identified by name (see is_mmproj_name)
+        // and taken out of the model candidates first, so "exactly one *.gguf"
+        // keeps meaning "exactly one MODEL" and a vision volume needs no
+        // special casing anywhere else. ENCLAVE_GGML_MMPROJ_FILE overrides the
+        // pick for a volume that names its projector something else.
+        let mmproj_override = std::env::var("ENCLAVE_GGML_MMPROJ_FILE").ok();
+        let mut mmproj: Option<PathBuf> = mmproj_override
+            .as_deref()
+            .map(str::trim)
+            .filter(|s| !s.is_empty())
+            .map(|f| path.join(f))
+            .filter(|p| p.is_file());
+        // model.gguf wins; otherwise exactly one *.gguf in the directory;
+        // otherwise one complete split family (part 00001 is the model).
+        let preferred = path.join("model.gguf");
+        let model_path = if preferred.is_file() {
+            preferred
+        } else {
+            let mut ggufs: Vec<_> = std::fs::read_dir(path)
+                .map_err(|e| err(format!("reading {}: {e}", path.display())))?
+                .filter_map(|e| e.ok().map(|e| e.path()))
+                .filter(|p| p.extension().map(|x| x == "gguf").unwrap_or(false))
+                .collect();
+            if mmproj.is_none() {
+                if let Some(i) = ggufs.iter().position(|p| {
+                    p.file_name().and_then(|n| n.to_str()).map(is_mmproj_name).unwrap_or(false)
+                }) {
+                    mmproj = Some(ggufs.remove(i));
+                }
+            } else {
+                ggufs.retain(|p| Some(p.as_path()) != mmproj.as_deref());
+            }
+            let names: std::collections::BTreeSet<String> = ggufs
+                .iter()
+                .filter_map(|p| p.file_name().and_then(|n| n.to_str()).map(String::from))
+                .collect();
+            match (ggufs.len(), ggufs.pop()) {
+                (1, Some(p)) => p,
+                (n, _) => match split_family_first(&names) {
+                    Some(first) => path.join(first),
+                    None => {
+                        return Err(err(format!(
+                            "expected model.gguf, exactly one *.gguf, or one complete \
+                             *-00001-of-NNNNN.gguf split family in {} (found {n}; a \
+                             vision projector named *mmproj*.gguf does not count \
+                             toward that)",
+                            path.display()
+                        )))
+                    }
+                },
+            }
+        };
+        // model.gguf took the fast path above without scanning the directory:
+        // its projector still has to be found.
+        if mmproj.is_none() {
+            mmproj = std::fs::read_dir(path)
+                .ok()
+                .into_iter()
+                .flatten()
+                .filter_map(|e| e.ok().map(|e| e.path()))
+                .find(|p| {
+                    p.extension().map(|x| x == "gguf").unwrap_or(false)
+                        && p.file_name()
+                            .and_then(|n| n.to_str())
+                            .map(is_mmproj_name)
+                            .unwrap_or(false)
+                });
+        }
+        // Preloads arrive with ExecutionTarget::Cpu from the registry; the
+        // env override decides real offload so operators control it per
+        // process without patching the registry call.
+        let ngl_env = env_i32("ENCLAVE_GGML_N_GPU_LAYERS", i32::MIN);
+        let target = if ngl_env != i32::MIN && ngl_env != 0 {
+            ExecutionTarget::Gpu
+        } else {
+            target
+        };
+        self.load_path_mm(&model_path, target, mmproj)
+    }
+}
+
+struct GgmlModel {
+    raw: *mut c_void,
+    n_vocab: u32,
+    /// carries recurrent (SSM/hybrid) state: partial rewind is impossible
+    /// (no per-token state history), so speculative callers must use the
+    /// branch-verify strategy (`copy_from`) instead of `rewind`. Surfaced
+    /// to guests through the "caps" probe.
+    recurrent: bool,
+    /// the GGUF carries a trained MTP (multi-token prediction) head — the
+    /// model can draft for ITSELF, no separate draft model. Surfaced via
+    /// "caps"; drives the "mtp"-flavored verbs below.
+    mtp: bool,
+    /// the volume pairs this model with a vision projector AND the linked
+    /// shim can drive it: the "image" verb will work. Surfaced via "caps" so
+    /// a guest can hide (or refuse) attachments before spending a request.
+    vision: bool,
+    /// path to that projector, kept for the lazy load on first image
+    mmproj: Option<CString>,
+    /// the model was loaded with GPU offload — the vision encoder follows it
+    /// onto the same device rather than encoding on the CPU
+    gpu: bool,
+}
+unsafe impl Send for GgmlModel {}
+unsafe impl Sync for GgmlModel {}
+impl Drop for GgmlModel {
+    fn drop(&mut self) {
+        unsafe { ell_free_model(self.raw) };
+    }
+}
+
+/// One decode request from one sequence, queued for the next merged batch.
+struct PendingItem {
+    ticket: u64,
+    seq_id: i32,
+    pos0: i32,
+    tokens: Vec<i32>,
+}
+
+/// A decoded output row in whichever form the engine produced it: the
+/// classic full-vocab logits row, or the device-computed top-k (mm26 -
+/// ids + logits sorted by logit descending, uniform k per call). Guests
+/// that asked for "topk" get tensors built from either form; a DENSE
+/// request on an armed engine is refused at the dispatch layer.
+#[derive(Clone)]
+enum RowOut {
+    Dense(Vec<f32>),
+    TopK { ids: Vec<i32>, vals: Vec<f32> },
+}
+
+/// Multi-row sibling of RowOut for the all-positions verify paths (flat
+/// buffers; row count is the caller's token count, k is uniform).
+enum RowsOut {
+    Dense(Vec<f32>),
+    TopK { ids: Vec<i32>, vals: Vec<f32>, k: usize },
+}
+
+/// Build the "topk_ids"/"topk_logits" tensors straight from device top-k
+/// buffers (k_src-strided), serving the guest's requested k_out <= k_src
+/// rows-of-k slices without a host-side scan.
+fn topk_tensors(ids: &[i32], vals: &[f32], rows: usize, k_src: usize, k_out: usize) -> (Tensor, Tensor) {
+    let k = k_out.min(k_src);
+    let mut ids_data = Vec::with_capacity(rows * k * 4);
+    let mut val_data = Vec::with_capacity(rows * k * 4);
+    for r in 0..rows {
+        for i in 0..k {
+            ids_data.extend_from_slice(&ids[r * k_src + i].to_le_bytes());
+            val_data.extend_from_slice(&vals[r * k_src + i].to_le_bytes());
+        }
+    }
+    (
+        Tensor { dimensions: vec![rows as u32, k as u32], ty: TensorType::I32, data: ids_data },
+        Tensor { dimensions: vec![rows as u32, k as u32], ty: TensorType::Fp32, data: val_data },
+    )
+}
+
+struct DecodeQueue {
+    next_ticket: u64,
+    pending: VecDeque<PendingItem>,
+    results: HashMap<u64, Result<RowOut, String>>,
+    /// a leader is inside ell_decode_batch — exactly one at a time, and
+    /// seq removal (Drop) must also wait on this
+    decoding: bool,
+    /// mm30 COHORT: seq_id -> when it last submitted a single-token step.
+    /// The leader waits a short window for this whole set before decoding,
+    /// which is what keeps the ubatch's participating-sequence set IDENTICAL
+    /// from step to step — the precondition llama checks before it reuses a
+    /// graph (`llm_graph_params::allow_reuse` compares n_seqs AND the seq
+    /// ids; `llm_graph_input_rs::can_reuse` compares the recurrent head,
+    /// which is min(tails) over exactly that set). See cohort_wait().
+    stepping: HashMap<i32, Instant>,
+}
+
+/// One parked prompt-state fork (see park_slots above). `seq_id` is the
+/// ORIGINAL sequence the prompt was fed into — it owns its cells; `tokens`
+/// is the exact fed prompt; `row` is the final prompt position's output,
+/// kept because an exact-match reuse never re-decodes that position and the
+/// guest still needs its logits. `pin` counts the un-diverged copies
+/// standing on this park — the donor's continuation until its first decode,
+/// and any reuse branch until ITS first decode. Removing a park while one
+/// exists would kill the copy's shared recurrent state, which is the
+/// empirically broken fork direction — eviction skips pinned parks.
+struct ParkedPrefix {
+    seq_id: i32,
+    tokens: Vec<i32>,
+    row: RowOut,
+    at: Instant,
+    pin: Arc<AtomicUsize>,
+    /// mm35: a declared-boundary park (its own slot budget and TTL, see
+    /// prefix_slots) rather than a finished turn's prompt
+    boundary: bool,
+}
+
+/// The shared serving context for one graph: one llama context whose unified
+/// KV pool holds every concurrent sequence. All shim calls on `raw` are
+/// serialized by the leader protocol (submit) + the `decoding` flag (Drop);
+/// the shim itself adds no locking.
+struct GgmlServer {
+    raw: *mut c_void,
+    model: Arc<GgmlModel>,
+    n_batch: u32,
+    n_seq_max: u32,
+    /// n_seq_max + park_slots(): what the llama context was actually created
+    /// with. `slots` holds free ids out of THIS many; `n_seq_max` stays the
+    /// SESSION cap (what tenants bought), enforced in init_execution_context.
+    total_seqs: u32,
+    /// mm32 prefix cache: parked prompt-state forks, plus the alias map that
+    /// keeps a donor's pre-fork "caps" seq id routing to its live sequence
+    /// (copy_from/mtp_for resolve through it). Lock order where both are
+    /// taken: parked -> slots. Alias entries live for the donor session's
+    /// lifetime and are dropped with it — after a park is evicted AND its
+    /// donor is gone, the id returns to `slots` clean.
+    parked: Mutex<Vec<ParkedPrefix>>,
+    alias: Mutex<HashMap<i32, i32>>,
+    /// mm36: who is preparing which exact prefix right now (see
+    /// prefix_claims.rs). A LEAF lock: taken alone, or last after
+    /// q -> parked when a plan is settled against the parks; never held
+    /// across a shim call or while taking any other lock.
+    claims: Mutex<PrefixClaims>,
+    n_vocab: usize,
+    /// mm26: device top-k armed at K (0 = off) - small decodes return
+    /// TopK rows, wide ones (prefill) fall back to Dense inside the shim
+    dev_topk: i32,
+    slots: Mutex<Vec<i32>>,
+    q: Mutex<DecodeQueue>,
+    cv: Condvar,
+    /// context geometry kept for the lazily created MTP head context (it
+    /// mirrors the server's window/quantization so both price the same way)
+    n_ctx: u32,
+    type_k: i32,
+    type_v: i32,
+    flash_attn: i32,
+    /// effective recurrent-snapshot depth of this context (0 unless the node
+    /// set ENCLAVE_GGML_N_RS_SEQ and the arch supports rollback): how many
+    /// trailing tokens of the last decode `rewind` can drop even on a
+    /// recurrent/hybrid model. Surfaced through "caps" so speculative guests
+    /// can verify on the REAL sequence and rewind the rejected tail instead
+    /// of paying the branch-verify round trip.
+    rewind_depth: i32,
+    /// the MTP head driver (shim-owned): created on FIRST mtp-flavored call,
+    /// under the decode turn so enabling nextn output on the target cannot
+    /// race a decode. None + model.mtp=false => the verbs error and guests
+    /// fall back to plain decode. Head decodes serialize on THIS lock and
+    /// deliberately do NOT take the decode turn — a tiny head step may
+    /// overlap another stream's trunk decode on the GPU.
+    mtp: Mutex<Option<MtpHandle>>,
+    /// mm9/mm11: [gate_us, alloc_us, turn_us, decode_us, harvest_us,
+    /// gbuild_us, galloc_us, ginput_us, slot_state] of the LAST
+    /// submit_full - single-decode serialization makes "last" well-defined
+    /// for the verb that just ran. turn_us is written by the arbiter layer
+    /// (its patch applies above this one); 0 without it. The g* tail comes
+    /// from llama_graph_perf: whether llama's small-batch graph slot
+    /// engaged (slot_state 1) and what the CPU-side stages cost.
+    last_phases: Mutex<[i64; 9]>,
+    /// mm21: CUMULATIVE llama decode-stage micros [build, alloc, input,
+    /// slot(unused here), mem-init, compute-call, output] across every
+    /// decode on this server - read via the "gperf" verb, never cleared
+    /// (guests report start/end deltas). The decomposition of the CVM's
+    /// CPU-orchestration-bound ~15 ms/token.
+    gperf_total: Mutex<[i64; 8]>,
+    /// the vision projector (shim-owned), created on the FIRST image and kept
+    /// for the graph's lifetime. Deferred because the encoder's weights and
+    /// compute buffers cost VRAM that a text-only deployment should never pay:
+    /// a chat that never attaches a picture never loads it.
+    mtmd: Mutex<Option<MtmdHandle>>,
+}
