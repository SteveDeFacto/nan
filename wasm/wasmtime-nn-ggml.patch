+        logits_out: *mut f32,
+    ) -> i32;
+    fn ell_seq_rewind(ctx: *mut c_void, seq_id: i32, n_keep: i32) -> i32;
+    fn ell_rewind_depth(ctx: *mut c_void) -> i32;
+    // mm26 device top-k (ENCLAVE_GGML_DEV_TOPK): armed K probe + decode
+    // variants that read back the device-computed top-k per output row
+    // (k_eff > 0, ids/vals at k_cap stride) or fall back in the same call
+    // to full logits rows in vals_out (return 0). Never re-decode.
+    fn ell_server_topk_k(ctx: *mut c_void) -> i32;
+    fn ell_decode_seq_topk(
+        ctx: *mut c_void,
+        model: *mut c_void,
+        seq_id: i32,
+        pos0: i32,
+        tokens: *const i32,
+        n: i32,
+        k_cap: i32,
+        ids_out: *mut i32,
+        vals_out: *mut f32,
+    ) -> i32;
+    fn ell_decode_batch_topk(
+        ctx: *mut c_void,
+        model: *mut c_void,
+        n_items: i32,
+        seq_ids: *const i32,
+        counts: *const i32,
+        positions: *const i32,
+        tokens_flat: *const i32,
+        k_cap: i32,
+        ids_out: *mut i32,
+        vals_out: *mut f32,
+    ) -> i32;
+    fn ell_cuda_sync_stats(out: *mut i64) -> i32;
+    fn ell_seq_copy(ctx: *mut c_void, src_seq: i32, dst_seq: i32);
+    fn ell_model_recurrent(model: *mut c_void) -> i32;
+    fn ell_mtp_available(model: *mut c_void) -> i32;
+    fn ell_mtp_new(
+        model: *mut c_void,
+        target_ctx: *mut c_void,
+        n_ctx: u32,
