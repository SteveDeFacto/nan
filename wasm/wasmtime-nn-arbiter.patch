@@ -0,0 +1,319 @@
+//! Client for the wasm-manager's GPU request-level arbiter (work-conserving
+//! fair share). See the `nn-arb` section of wasm_manager.py for the design;
+//! the short version: instead of living inside a static MPS SM partition,
+//! GPU tenants launch with the full SM budget and take short weighted TURNS
+//! on the card — one turn per natural compute quantum (a ggml decode turn,
+//! an ORT run, an sd denoise step). An idle card grants instantly, so a lone
+//! tenant bursts to 100%; a contended card divides GPU *time* in proportion
+//! to purchased shares.
+//!
+//! Protocol (newline-JSON over the Unix socket named by `ENCLAVE_NN_ARBITER`):
+//!   -> {"op":"hello","v":1,"tenant":"<id>","weight":<share>,"queue":"0"}
+//!   <- {"ok":true}
+//!   -> {"op":"acq","id":N}        ... blocks until ...   <- {"ok":true,"id":N}
+//!   -> {"op":"rel","id":N}
+//!
+//! FAIL-OPEN is the invariant every path here upholds: arbitration is a
+//! fairness upgrade, never a wall. No socket env = every `turn()` is a no-op.
+//! A connect/write/read failure = computes run unarbitrated while a
+//! rate-limited reconnect keeps trying (a wasm-manager restart replaces the
+//! socket; tenants must re-arm without a relaunch). A grant that never
+//! arrives inside the watchdog window = drop the connection and run — the
+//! server revokes abandoned grants on its own lease timer, so nothing wedges.
+//! The one thing this module never does is fail or stall a compute forever
+//! on behalf of fairness.
+//!
+//! std-only on purpose: no serde, no new crates, no Cargo.lock delta. The
+//! grant frame is fixed-shape, so a substring scan is the whole parser.
+
+use std::collections::HashMap;
+use std::io::{BufRead, BufReader, Write};
+use std::os::unix::net::UnixStream;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::mpsc::{sync_channel, RecvTimeoutError, SyncSender};
+use std::sync::{Arc, Mutex, OnceLock};
+use std::time::{Duration, Instant};
+
+/// How long an `acq` may sit unanswered before we declare the arbiter wedged
+/// and fail open. Legitimate queue waits are bounded by (waiters x the
+/// server's max-hold lease), far under this.
+const GRANT_WATCHDOG: Duration = Duration::from_secs(120);
+/// Minimum gap between reconnect attempts once the socket is down.
+const RECONNECT_EVERY: Duration = Duration::from_secs(5);
+/// A hello whose reply takes longer than this is a broken server.
+const HELLO_TIMEOUT: Duration = Duration::from_secs(5);
+
+struct Conn {
+    stream: UnixStream,
+    wlock: Mutex<()>,
+    /// acq ids whose grant is still outstanding; the reader thread completes
+    /// them with `true` (granted) — teardown completes them with `false`
+    /// (fail open, run unarbitrated).
+    pending: Mutex<HashMap<u64, SyncSender<bool>>>,
+}
+
+impl Conn {
+    fn write_line(&self, line: &str) -> std::io::Result<()> {
+        let _w = self.wlock.lock().unwrap();
+        (&self.stream).write_all(line.as_bytes())?;
+        (&self.stream).write_all(b"\n")
+    }
+}
+
+struct Client {
+    path: String,
+    tenant: String,
+    weight: String,
+    queue: String,
+    next_id: AtomicU64,
+    state: Mutex<ClientState>,
+}
+
+struct ClientState {
+    conn: Option<Arc<Conn>>,
+    last_attempt: Option<Instant>,
+}
+
+static CLIENT: OnceLock<Option<Client>> = OnceLock::new();
+
+fn json_escape(s: &str) -> String {
+    s.chars()
+        .filter(|c| !c.is_control())
+        .map(|c| match c {
+            '"' => "\\\"".to_string(),
+            '\\' => "\\\\".to_string(),
+            c => c.to_string(),
+        })
+        .collect()
+}
+
+fn client() -> Option<&'static Client> {
+    CLIENT
+        .get_or_init(|| {
+            let path = std::env::var("ENCLAVE_NN_ARBITER").ok()?;
+            if path.is_empty() {
+                return None;
+            }
+            // weight goes over the wire as a bare JSON number; anything
+            // unparsable becomes 0 and the server substitutes its own
+            // authoritative value (the deployment record's gpuShare).
+            let weight = std::env::var("ENCLAVE_NN_ARB_WEIGHT")
+                .ok()
+                .and_then(|w| w.trim().parse::<f64>().ok())
+                .filter(|w| w.is_finite() && *w > 0.0)
+                .map(|w| format!("{w}"))
+                .unwrap_or_else(|| "0".to_string());
+            Some(Client {
+                path,
+                tenant: json_escape(&std::env::var("ENCLAVE_NN_ARB_TENANT").unwrap_or_default()),
+                weight,
+                queue: json_escape(
+                    &std::env::var("ENCLAVE_NN_ARB_QUEUE").unwrap_or_else(|_| "0".into()),
+                ),
+                next_id: AtomicU64::new(1),
+                state: Mutex::new(ClientState {
+                    conn: None,
+                    last_attempt: None,
+                }),
+            })
+        })
+        .as_ref()
+}
+
+/// Connect + hello early, at server startup. The wasm-manager's capability
+/// probe launches a throwaway serve and calls the toolchain arbiter-capable
+/// ONLY if this connect actually happens — keep it eager and loud.
+pub fn init_early() {
+    let Some(c) = client() else { return };
+    match c.ensure_conn(true) {
+        Some(_) => eprintln!(
+            "[nn-arb] connected to {} (tenant={}, queue={})",
+            c.path, c.tenant, c.queue
+        ),
+        None => eprintln!(
+            "[nn-arb] arbiter socket {} not reachable — GPU computes run \
+             unarbitrated until it appears (reconnecting)",
+            c.path
+        ),
+    }
+}
+
+impl Client {
+    /// The live connection, dialing a new one if allowed. `force` skips the
+    /// reconnect rate limit (startup only).
+    fn ensure_conn(&self, force: bool) -> Option<Arc<Conn>> {
+        let mut st = self.state.lock().unwrap();
+        if let Some(conn) = st.conn.as_ref() {
+            return Some(conn.clone());
+        }
+        if !force {
+            if let Some(t) = st.last_attempt {
+                if t.elapsed() < RECONNECT_EVERY {
+                    return None;
+                }
+            }
+        }
+        st.last_attempt = Some(Instant::now());
+        let conn = match self.dial() {
+            Ok(conn) => Arc::new(conn),
+            Err(e) => {
+                if force {
+                    eprintln!("[nn-arb] dial {} failed: {e}", self.path);
+                }
+                return None;
+            }
+        };
+        st.conn = Some(conn.clone());
+        drop(st);
+        let reader = conn.clone();
+        let me: &'static Client = unsafe { &*(self as *const Client) };
+        // Safety of the transmute-to-'static above: the only Client lives in
+        // a static OnceLock and is never dropped.
+        std::thread::Builder::new()
+            .name("nn-arb-reader".into())
+            .spawn(move || me.read_loop(reader))
+            .ok();
+        Some(conn)
+    }
+
+    fn dial(&self) -> std::io::Result<Conn> {
+        let stream = UnixStream::connect(&self.path)?;
+        stream.set_read_timeout(Some(HELLO_TIMEOUT))?;
+        let hello = format!(
+            "{{\"op\":\"hello\",\"v\":1,\"tenant\":\"{}\",\"weight\":{},\"queue\":\"{}\"}}\n",
+            self.tenant, self.weight, self.queue
+        );
+        (&stream).write_all(hello.as_bytes())?;
+        let mut line = String::new();
+        BufReader::new(stream.try_clone()?).read_line(&mut line)?;
+        if !line.contains("\"ok\"") {
+            return Err(std::io::Error::other("arbiter rejected hello"));
+        }
+        stream.set_read_timeout(None)?;
+        Ok(Conn {
+            stream,
+            wlock: Mutex::new(()),
+            pending: Mutex::new(HashMap::new()),
+        })
+    }
+
+    fn read_loop(&'static self, conn: Arc<Conn>) {
+        let reader = match conn.stream.try_clone() {
+            Ok(s) => BufReader::new(s),
+            Err(_) => return self.teardown(&conn),
+        };
+        for line in reader.lines() {
+            let Ok(line) = line else { break };
+            // grant frames are {"ok":true,"id":N}; anything else is ignored.
+            // trim_start is LOAD-BEARING, not defensive fluff: the server
+            // emitting pythonic '"id": N' (a space) once dropped every grant
+            // here and put each decode step on the 120s fail-open watchdog
+            // (live 2026-08-01). The server now pins compact separators AND
+            // this side tolerates spacing — either alone survives the other
+            // regressing.
+            let Some(idx) = line.find("\"id\":") else {
+                continue;
+            };
+            let id: u64 = line[idx + 5..]
+                .trim_start()
+                .chars()
+                .take_while(|c| c.is_ascii_digit())
+                .collect::<String>()
+                .parse()
+                .unwrap_or(0);
+            if let Some(tx) = conn.pending.lock().unwrap().remove(&id) {
+                let _ = tx.send(true);
+            }
+        }
+        self.teardown(&conn);
+    }
+
+    /// Forget a dead connection and wake everyone it owes a grant — they run
+    /// unarbitrated (fail open). Idempotent; keyed by pointer identity so a
+    /// replacement connection is never torn down by its predecessor's reader.
+    fn teardown(&self, conn: &Arc<Conn>) {
+        let mut st = self.state.lock().unwrap();
+        if st.conn.as_ref().is_some_and(|c| Arc::ptr_eq(c, conn)) {
+            st.conn = None;
+        }
+        drop(st);
+        let _ = conn.stream.shutdown(std::net::Shutdown::Both);
+        for (_, tx) in conn.pending.lock().unwrap().drain() {
+            let _ = tx.send(false);
+        }
+    }
+
+    fn acquire(&'static self) -> Turn {
+        let Some(conn) = self.ensure_conn(false) else {
+            return Turn(None);
+        };
+        let id = self.next_id.fetch_add(1, Ordering::Relaxed);
+        let (tx, rx) = sync_channel(1);
+        conn.pending.lock().unwrap().insert(id, tx);
+        if conn
+            .write_line(&format!("{{\"op\":\"acq\",\"id\":{id}}}"))
+            .is_err()
+        {
+            conn.pending.lock().unwrap().remove(&id);
+            self.teardown(&conn);
+            return Turn(None);
+        }
+        match rx.recv_timeout(GRANT_WATCHDOG) {
+            Ok(true) => Turn(Some((self, conn, id))),
+            Ok(false) => Turn(None),
+            Err(RecvTimeoutError::Timeout) => {
+                eprintln!(
+                    "[nn-arb] no grant within {}s — arbiter wedged? running \
+                     unarbitrated and reconnecting",
+                    GRANT_WATCHDOG.as_secs()
+                );
+                conn.pending.lock().unwrap().remove(&id);
+                self.teardown(&conn);
+                Turn(None)
+            }
+            Err(RecvTimeoutError::Disconnected) => Turn(None),
+        }
+    }
+
+    fn release(&self, conn: &Arc<Conn>, id: u64) {
+        if conn
+            .write_line(&format!("{{\"op\":\"rel\",\"id\":{id}}}"))
+            .is_err()
+        {
+            self.teardown(conn);
+        }
+    }
+}
+
+/// A granted turn on the card, released on drop. `Turn(None)` — from a CPU
+/// compute, an unarmed process, or any arbiter failure — is a free no-op.
+pub struct Turn(Option<(&'static Client, Arc<Conn>, u64)>);
+
+impl Drop for Turn {
+    fn drop(&mut self) {
+        if let Some((client, conn, id)) = self.0.take() {
+            client.release(&conn, id);
+        }
+    }
+}
+
+/// This process carries the arbiter env at all — for deciding whether to
+/// install optional hooks (the sd step callback), NOT whether a given
+/// compute should block: that's `turn()`'s job.
+pub fn armed() -> bool {
+    client().is_some()
+}
+
+/// Take a turn on the card before dispatching one GPU compute quantum.
+/// `gpu: false` (a CPU-target graph) never arbitrates — CPU fairness is the
+/// cgroup weight's job, and burning a card turn on a CPU compute would
+/// throttle GPU tenants for nothing.
+pub fn turn(gpu: bool) -> Turn {
+    if !gpu {
+        return Turn(None);
+    }
+    match client() {
+        Some(c) => c.acquire(),
+        None => Turn(None),
+    }
+}
