+// The OPTIONAL step-callback hook resolves through the same dlsym declared
+// with the upscaler entry points above.
+type EsdSetStepCb = unsafe extern "C" fn(unsafe extern "C" fn(*mut c_void), *mut c_void);
+
+static SD_STEP_HOOK: Once = Once::new();
+
+thread_local! {
+    /// The generation thread's current arbiter turn. Set around esd_txt2img;
+    /// the step callback swaps it for a fresh one BETWEEN denoise steps, so a
+    /// long generation queues at step granularity instead of monopolizing the
+    /// card. Thread-local because the callback is process-global while
+    /// generations are per-model-mutex — only the thread actually inside
+    /// esd_txt2img carries a turn to yield.
+    static SD_TURN: std::cell::RefCell<Option<crate::arbiter::Turn>> =
+        const { std::cell::RefCell::new(None) };
+}
+
+/// Called by the shim between denoise steps (never concurrently with itself
+/// on one thread). Release the turn we hold, immediately re-acquire — under
+/// contention the WFQ grants someone else the gap; idle, the re-acquire is a
+/// socket round-trip (~100us against multi-second generations).
+unsafe extern "C" fn sd_step_yield(_ud: *mut c_void) {
+    SD_TURN.with(|t| {
+        let mut t = t.borrow_mut();
+        if t.is_some() {
+            *t = None; // rel
+            *t = Some(crate::arbiter::turn(true));
+        }
+    });
+}
